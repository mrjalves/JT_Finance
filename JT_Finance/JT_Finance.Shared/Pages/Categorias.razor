@page "/gerenciar-categorias"
@inject IJSRuntime JSRuntime

@using JT_Classes

<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <h3 class="mb-3">Gerenciador de Opções de Categoria</h3>

            <div class="card shadow-sm mb-4">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center">
                        <label for="papelCategoria" class="form-label me-2 mb-0 fw-bold">Gerenciar Opções para:</label>
                        <select id="papelCategoria" class="form-select w-auto" @bind="selectedRole" @bind:event="onchange">
                            @foreach (var papel in papeisDeCategoria)
                            {
                                <option value="@papel.Key">@papel.Value</option>
                            }
                        </select>
                    </div>
                    <button class="btn btn-primary" @onclick="AbrirModalParaNovaOpcao">
                        <i class="bi bi-plus-circle-fill me-2"></i>Nova Opção
                    </button>
                </div>
            </div>

            <div class="card shadow-sm">
                <div class="card-body">
                    @if (isLoading)
                    {
                        <div class="text-center p-4">
                            <div class="spinner-border text-primary" role="status"></div>
                            <p class="mt-2">Buscando opções...</p>
                        </div>
                    }
                    else if (opcoesCategoria == null || !opcoesCategoria.Any())
                    {
                        <div class="text-center p-4">
                            <p class="mb-0">Nenhuma opção encontrada para <strong>@papeisDeCategoria[selectedRole]</strong>.</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>Descrição (Valor da Categoria)</th>
                                        <th class="text-end" style="width: 150px;">Ações</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var opt in opcoesCategoria)
                                    {
                                        <tr>
                                            <td>@opt.Descricao</td>
                                            <td class="text-end">
                                                <button class="btn btn-sm btn-outline-primary me-2" @onclick="() => AbrirModalParaEditar(opt)">
                                                    <i class="bi bi-pencil-square"></i>
                                                </button>
                                                <button class="btn btn-sm btn-outline-danger" @onclick="() => ExcluirOpcao(opt)">
                                                    <i class="bi bi-trash3-fill"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal para Adicionar/Editar Opção -->
@if (showModal)
{
    <div class="modal fade show" style="display:block" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@modalTitle</h5>
                    <button type="button" class="btn-close" @onclick="FecharModal"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="@opcaoEmEdicao" OnValidSubmit="HandleSave">
                        <DataAnnotationsValidator />

                        <div class="mb-3">
                            <label for="descricao" class="form-label">Descrição (Ex: Alimentação, Transporte, Salário)</label>
                            <InputText id="descricao" class="form-control" @bind-Value="opcaoEmEdicao.Descricao" />
                            <ValidationMessage For="@(() => opcaoEmEdicao.Descricao)" />
                        </div>

                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" @onclick="FecharModal">Cancelar</button>
                            <button type="submit" class="btn btn-primary">Salvar</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@code {
    private Categoria categoriaRepository = new Categoria();

    // Mapeia o "papel" (valor da coluna NOME) para um texto amigável.
    private Dictionary<string, string> papeisDeCategoria = new()
    {
        { "TipoDespesa", "Tipos de Despesa" },
        { "Categoria", "Categorias de Despesa" }
        // Adicione outros aqui, como "TipoReceita", etc.
    };

    private string selectedRole = "TipoDespesa"; // Valor inicial

    private List<Categoria> opcoesCategoria = new();
    private bool isLoading = true;
    private bool showModal = false;
    private string modalTitle = string.Empty;
    private Categoria opcaoEmEdicao = new();

    protected override async Task OnInitializedAsync()
    {
        await CarregarOpcoes();
    }

    // Dispara a recarga quando o usuário muda a seleção no dropdown
    private async Task OnSelectedRoleChanged(ChangeEventArgs e)
    {
        selectedRole = e.Value?.ToString() ?? "TipoDespesa";
        await CarregarOpcoes();
    }

    private async Task CarregarOpcoes()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            // Assumimos que o TIPO_ENTIDADE para estes papéis é 'Despesa'.
            // Em um sistema maior, isso poderia ser mais dinâmico.
            opcoesCategoria = categoriaRepository.ListarPorPapel("Despesa", selectedRole);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro ao carregar opções: {ex.Message}");
            opcoesCategoria = new List<Categoria>();
        }
        finally
        {
            isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void AbrirModalParaNovaOpcao()
    {
        modalTitle = $"Nova Opção para {papeisDeCategoria[selectedRole]}";
        opcaoEmEdicao = new Categoria
        {
            // Preenche os valores fixos automaticamente
            TipoEntidade = "Despesa",
            Nome = selectedRole, // O "papel" vem da seleção do dropdown
            Id = categoriaRepository.GetNextId<Categoria>()
        };
        showModal = true;
    }

    private void AbrirModalParaEditar(Categoria opcaoParaEditar)
    {
        modalTitle = $"Editar Opção: {opcaoParaEditar.Descricao}";
        // Cria uma cópia para edição
        opcaoEmEdicao = new Categoria
        {
            Id = opcaoParaEditar.Id,
            Nome = opcaoParaEditar.Nome,
            Descricao = opcaoParaEditar.Descricao,
            TipoEntidade = opcaoParaEditar.TipoEntidade
        };
        showModal = true;
    }

    private void FecharModal() => showModal = false;

    private async Task HandleSave()
    {
        var categoriaExistente = categoriaRepository.CarregarPorId<Categoria>(opcaoEmEdicao.Id);
        bool sucesso = (categoriaExistente == null)
            ? categoriaRepository.Salvar(opcaoEmEdicao)
            : categoriaRepository.Atualizar(opcaoEmEdicao);

        if (sucesso)
        {
            FecharModal();
            await CarregarOpcoes();
        }
        else
        {
            Console.WriteLine("Falha ao salvar a opção.");
        }
    }

    private async Task ExcluirOpcao(Categoria opcaoParaExcluir)
    {
        var confirmado = await JSRuntime.InvokeAsync<bool>("confirm", $"Você tem certeza que deseja excluir a opção '{opcaoParaExcluir.Descricao}'?");

        if (confirmado && categoriaRepository.Excluir(opcaoParaExcluir))
        {
            await CarregarOpcoes();
        }
    }
}
