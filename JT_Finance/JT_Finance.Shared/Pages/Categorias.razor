@page "/gerenciar-categorias"
@using JT_Aplicacao
@using JT_Classes
@using JT_Finance.Shared.Services
@using JT_Finance.Shared.Services.Interfaces
@inject ToastService ToastService
@inject ICategoriaService CategoriaService

<div class="card shadow-sm mb-2">
    <div class="card-body d-flex justify-content-between align-items-center">
        <div class="d-flex align-items-center">
            <label for="papelCategoria" class="form-label me-2 mb-0 fw-bold">Gerenciar Opções para:</label>
            <select id="papelCategoria" class="form-select w-auto" @bind="selectedRole">
                @foreach (var papel in papeisDeCategoria)
                {
                    <option value="@papel.Key">@papel.Value.DisplayName</option>
                }
            </select>
        </div>
        <button class="btn btn-primary" @onclick="AbrirModalParaNovaOpcao">
            <i class="bi bi-plus-circle-fill me-2"></i>Nova Opção
        </button>
    </div>
</div>

<div class="card shadow-sm mb-2">
    <div class="card-body">
        @if (isLoading)
        {
            <div class="text-center p-4">
                <div class="spinner-border text-primary" role="status"></div>
                <p class="mt-2">Buscando opções...</p>
            </div>
        }
        else if (opcoesCategoria == null || !opcoesCategoria.Any())
        {
            <div class="text-center p-4">
                <p class="mb-0">Nenhuma opção encontrada para <strong>@papeisDeCategoria[selectedRole].DisplayName</strong>.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Descrição (Valor da Categoria)</th>
                            <th class="text-end" style="width: 150px;">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var opt in opcoesCategoria)
                        {
                            <tr>
                                <td>@opt.Descricao</td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-outline-primary me-2" @onclick="() => AbrirModalParaEditar(opt)">
                                        <i class="bi bi-pencil-fill"></i>
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => ExcluirOpcao(opt)">
                                        <i class="bi bi-trash-fill"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>


<!-- Modal para Adicionar/Editar Opção -->
@if (showModal)
{
    <div class="modal fade show" style="display:block" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@modalTitle</h5>
                    <button type="button" class="btn-close" @onclick="FecharModal"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="@opcaoEmEdicao" OnValidSubmit="HandleSave">
                        <DataAnnotationsValidator />

                        <div class="mb-3">
                            <label for="descricao" class="form-label">Descrição (Ex: Alimentação, Transporte, Salário)</label>
                            <InputText id="descricao" class="form-control" @bind-Value="opcaoEmEdicao.Descricao" />
                            <ValidationMessage For="@(() => opcaoEmEdicao.Descricao)" />
                        </div>

                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" @onclick="FecharModal">Cancelar</button>
                            <button type="submit" class="btn btn-primary">Salvar</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}
<ConfirmDialog @ref="confirmDeleteDialog" OnConfirm="EfetuarRemocaoCategoria" />
@code {
    [CascadingParameter]
    public Func<string, Task>? SetPageTitleAsync { get; set; }
    private Categoria categoriaRepository = new Categoria();
    private ConfirmDialog confirmDeleteDialog = new();
    // ALTERAÇÃO: A estrutura agora guarda o Nome de Exibição e o Tipo de Entidade.
    private Dictionary<string, (string DisplayName, string EntityType)> papeisDeCategoria = new()
    {
        { "TipoDespesa", ("Tipos de Despesa", "Despesa") },
        { "Categoria", ("Categorias de Despesa", "Despesa") },
        { "TipoReceita", ("Tipos de Receita", "Receita") },
        { "CategoriaReceita", ("Categorias de Receita", "Receita") }
    };

    private string _selectedRole = "TipoDespesa";
    private string selectedRole
    {
        get => _selectedRole;
        set
        {
            if (_selectedRole != value)
            {
                _selectedRole = value;
                InvokeAsync(CarregarOpcoes);
            }
        }
    }

    private List<Categoria> opcoesCategoria = new();
    private bool isLoading = true;
    private bool showModal = false;
    private string modalTitle = string.Empty;
    private Categoria opcaoEmEdicao;

    protected override async Task OnInitializedAsync()
    {
        if (SetPageTitleAsync != null)
        {
            await SetPageTitleAsync.Invoke("Categorias");
        }
        await CarregarOpcoes();
    }

    private async Task CarregarOpcoes()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            // ALTERAÇÃO: Busca o tipo de entidade (Despesa/Receita) do dicionário
            var (displayName, entityType) = papeisDeCategoria[selectedRole];
            opcoesCategoria = Categoria.ListarPorPapel(entityType, selectedRole);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro ao carregar opções: {ex.Message}");
            opcoesCategoria = new List<Categoria>();
        }
        finally
        {
            isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void AbrirModalParaNovaOpcao()
    {
        var (displayName, entityType) = papeisDeCategoria[selectedRole];
        modalTitle = $"Nova Opção para {displayName}";

        opcaoEmEdicao = new Categoria()
        {
            TipoEntidade = entityType,
            Nome = selectedRole,
        };
        showModal = true;
    }

    private void AbrirModalParaEditar(Categoria opcaoParaEditar)
    {
        modalTitle = $"Editar Opção: {opcaoParaEditar.Descricao}";
        opcaoEmEdicao = new Categoria
        {
            Status = StatusObjeto.EmEdicao,
            Id = opcaoParaEditar.Id,
            Nome = opcaoParaEditar.Nome,
            Descricao = opcaoParaEditar.Descricao,
            TipoEntidade = opcaoParaEditar.TipoEntidade
        };
        showModal = true;
    }

    private void FecharModal() => showModal = false;

    private async Task HandleSave()
    {
        if (JT_Servicos.CategoriaService.Save(opcaoEmEdicao))
        {
            FecharModal();
            await CarregarOpcoes();
            ToastService.ShowSuccess("Salvo!", "A Categoria foi salva com sucesso.");
        }
        else
        {
            ToastService.ShowError("Erro!", "Não foi possível salvar a Categoria.");
        }
    }

    private async Task ExcluirOpcao(Categoria opcaoParaExcluir)
    {
        opcaoEmEdicao = opcaoParaExcluir;
        confirmDeleteDialog.Show("Confirmar Remoção", "Deseja realmente remover esta receita?");
    }
    private async Task EfetuarRemocaoCategoria()
    {
        if (JT_Servicos.CategoriaService.Delete(opcaoEmEdicao.Id))
        {
            ToastService.ShowSuccess("Removida!", "A Categoria foi removida.");
            await CarregarOpcoes(); 
        }
        else
        {
            ToastService.ShowError("Erro!", "Não foi possível remover a Categoria.");
        }
    }
}