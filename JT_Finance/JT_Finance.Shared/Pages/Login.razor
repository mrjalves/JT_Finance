@page "/login"
@inject NavigationManager NavigationManager
@inject FirebaseAuthService AuthService // Injeta o novo serviço

<div class="login-overlay">
    <div class="login-card">
        <h3 class="text-center mb-4">Login</h3>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger" role="alert">
                @errorMessage
            </div>
        }

        <EditForm Model="@loginModel" OnValidSubmit="@HandleLoginWithEmail">
            <DataAnnotationsValidator />

            <div class="mb-3">
                <label for="email" class="form-label">Email</label>
                <InputText id="email" class="form-control" @bind-Value="loginModel.Email" placeholder="seuemail@exemplo.com" />
                <ValidationMessage For="@(() => loginModel.Email)" />
            </div>
            <div class="mb-4">
                <label for="password" class="form-label">Senha</label>
                <div class="password-input-group">
                    <InputText id="password" type="@passwordFieldType" class="form-control password-input" @bind-Value="loginModel.Password" placeholder="suasenha" />
                    <button type="button" class="password-toggle" id="passwordToggle" @onclick="TogglePasswordVisibility" aria-label="@(isPasswordVisible ? "Ocultar senha" : "Exibir senha")">
                        <i class="@passwordIconCssClass" aria-hidden="true"></i>
                    </button>
                </div>
                <ValidationMessage For="@(() => loginModel.Password)" />
            </div>

            <button type="submit" class="btn btn-primary w-100 mb-3" disabled="@isBusy">
                @if (isBusy)
                {
                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                }
                Entrar
            </button>

            <div class="login-links text-center mb-3">
                <NavLink href="cadastro">Não tem conta? Cadastre-se</NavLink>
                <span class="mx-2">|</span>
                <NavLink href="recuperarsenha">Esqueceu a senha?</NavLink>
            </div>

            <div class="separator">OU</div>

            <button type="button" class="btn btn-light w-100 btn-google" @onclick="HandleLoginWithGoogle" disabled="@isBusy">
                <svg version="1.1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" class="google-icon" aria-hidden="true"><g><path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"></path><path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"></path><path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"></path><path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"></path><path fill="none" d="M0 0h48v48H0z"></path></g></svg>
                Entrar com Google
            </button>
        </EditForm>
    </div>
</div>

@code {
    private LoginModel loginModel = new();
    private string errorMessage;
    private bool isBusy = false;

    private async Task HandleLoginWithEmail()
    {
        isBusy = true;
        errorMessage = null;

        var result = await AuthService.SignInWithEmailAsync(loginModel.Email, loginModel.Password);

        if (result.Success)
        {
            Console.WriteLine($"Login bem-sucedido para: {result.User.Email}");
            NavigationManager.NavigateTo("/"); // Redireciona para a página principal
        }
        else
        {
            errorMessage = result.ErrorMessage;
            Console.WriteLine($"Erro no login: {errorMessage}");
        }

        isBusy = false;
    }

    private async Task HandleLoginWithGoogle()
    {
        isBusy = true;
        errorMessage = null;

        var result = await AuthService.SignInWithGoogleAsync();

         if (result.Success)
        {
            //Console.WriteLine($"Login com Google bem-sucedido para: {result.User.Email}");
            NavigationManager.NavigateTo("/"); // Redireciona para a página principal
        }
        else
        {
            errorMessage = result.ErrorMessage;
            Console.WriteLine($"Erro no login com Google: {errorMessage}");
        }

        isBusy = false;
    }

    // Lógica para mostrar/esconder senha
    private bool isPasswordVisible = false;
    private string passwordFieldType => isPasswordVisible ? "text" : "password";
    private string passwordIconCssClass => isPasswordVisible ? "bi bi-eye-slash-fill" : "bi bi-eye-fill";

    private void TogglePasswordVisibility()
    {
        isPasswordVisible = !isPasswordVisible;
    }

    public class LoginModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "O email é obrigatório.")]
        [System.ComponentModel.DataAnnotations.EmailAddress(ErrorMessage = "Formato de email inválido.")]
        public string Email { get; set; }

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "A senha é obrigatória.")]
        public string Password { get; set; }
    }
}