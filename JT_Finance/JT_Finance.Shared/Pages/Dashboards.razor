@page "/dashboards"
@using JT_Classes.Financeiro
@using JT_Finance.Shared.Services.Dashboard
@using JT_UserInterface.Shared.Components.Core
@inject JT_Servicos.Financeiro.DashboardService DashboardService
@inject JT_Classes.Acessos.CurrentUserState UserState
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject JT_UserInterface.Shared.Services.Comum.ToastService ToastService
@inject IJSRuntime JSRuntime
@implements IDisposable

<PageTitle>Dashboards</PageTitle>

@if (isLoading)
{
    <div class="text-center py-5"><Loading /></div>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h4 mb-0">
            <i class="bi bi-speedometer2 me-2 text-primary"></i>Dashboards
        </h1>
        <div class="d-flex gap-2">
            <DashboardIAComposer OnConfirmed="AbrirDashboard" />
            <button class="btn btn-primary" @onclick="AbrirModalNovo">
                <i class="bi bi-plus-circle-fill me-1"></i> Novo Dashboard
            </button>
        </div>
    </div>

    @if (!dashboards.Any())
    {
        <div class="card shadow-sm">
            <div class="card-body text-center py-5">
                <i class="bi bi-grid-3x3-gap-fill fs-1 text-muted"></i>
                <p class="mt-3 mb-1 fw-semibold">Nenhum dashboard criado ainda.</p>
                <p class="text-muted small">Crie seu primeiro dashboard e adicione indicadores financeiros.</p>
                <button class="btn btn-outline-primary mt-2" @onclick="AbrirModalNovo">
                    <i class="bi bi-plus-circle me-1"></i> Criar Dashboard
                </button>
                <div class="mt-2">
                    <DashboardIAComposer OnConfirmed="AbrirDashboard" ButtonClass="btn-outline-secondary" />
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var d in dashboards.OrderByDescending(x => x.Id))
            {
                <div class="col-12 col-sm-6 col-xl-4">
                    <div class="card shadow-sm h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <h5 class="card-title mb-1">
                                        <i class="bi bi-layout-text-window-reverse me-1 text-primary"></i>@d.Nome
                                    </h5>
                                    <p class="card-text text-muted small mb-2">
                                        @(string.IsNullOrWhiteSpace(d.Descricao) ? "Sem descrição" : d.Descricao)
                                    </p>
                                </div>
                                <span class="badge @(d.Publico ? "bg-success" : "bg-secondary")">
                                    <i class="bi @(d.Publico ? "bi-link-45deg" : "bi-lock") me-1"></i>@(d.Publico ? "Público" : "Privado")
                                </span>
                            </div>
                            <div class="d-flex gap-2 mt-3">
                                <button class="btn btn-sm btn-primary" @onclick="() => AbrirDashboard(d.Id)">
                                    <i class="bi bi-pencil-square me-1"></i>Abrir
                                </button>
                                <button class="btn btn-sm btn-outline-primary" @onclick="() => AbrirModalCompartilhar(d)">
                                    <i class="bi bi-share-fill me-1"></i>Compartilhar
                                </button>
                                <button class="btn btn-sm btn-outline-danger ms-auto" @onclick="() => ConfirmarExclusao(d)">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
}

<Modal @ref="modalNovo" Title="Novo Dashboard" Size="Modal.ModalSize.Default">
    <BodyContent>
        <div class="mb-3">
            <label class="form-label">Nome</label>
            <input type="text" class="form-control" @bind="novoNome" placeholder="Ex.: Controle do Mês" />
        </div>
        <div class="mb-3">
            <label class="form-label">Descrição</label>
            <input type="text" class="form-control" @bind="novaDescricao" placeholder="Opcional" />
        </div>
    </BodyContent>
    <FooterContent>
        <button class="btn btn-secondary" @onclick="modalNovo.Close">Cancelar</button>
        <button class="btn btn-primary" @onclick="CriarDashboard">
            <i class="bi bi-check-lg me-1"></i>Criar
        </button>
    </FooterContent>
</Modal>

<Modal @ref="modalCompartilhar" Title="Compartilhar Dashboard" Size="Modal.ModalSize.Default">
    <BodyContent>
        @if (dashboardSelecionado != null)
        {
            <p class="small text-muted">
                O link abaixo abre este dashboard em modo só-leitura para qualquer pessoa.
            </p>
            <div class="input-group mb-3">
                <input type="text" class="form-control" readonly value="@ObterLinkCompartilhamento()" id="linkCompartilhamento" />
                <button class="btn btn-outline-primary" @onclick="CopiarLink">
                    <i class="bi bi-clipboard me-1"></i>Copiar
                </button>
            </div>
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" id="chkPublico" @bind="dashboardSelecionado.Publico" @bind:after="SalvarPublicidade" />
                <label class="form-check-label" for="chkPublico">Ativar link público</label>
            </div>
            @if (dashboardSelecionado.Publico)
            {
                <button class="btn btn-sm btn-outline-secondary mt-2" @onclick="RegenerarToken">
                    <i class="bi bi-arrow-clockwise me-1"></i>Gerar novo link
                </button>
            }
        }
    </BodyContent>
    <FooterContent>
        <button class="btn btn-secondary" @onclick="modalCompartilhar.Close">Fechar</button>
    </FooterContent>
</Modal>

<ConfirmDialog @ref="confirmDelete" OnConfirm="ExcluirDashboard" />

@code {
    [CascadingParameter]
    public Func<string, Task>? SetPageTitleAsync { get; set; }

    private bool isLoading = true;
    private List<MDashboard> dashboards = new();
    private Modal modalNovo = default!;
    private Modal modalCompartilhar = default!;
    private ConfirmDialog confirmDelete = default!;
    private string novoNome = string.Empty;
    private string novaDescricao = string.Empty;
    private MDashboard? dashboardSelecionado;
    private int? idParaExcluir;

    protected override async Task OnInitializedAsync()
    {
        if (SetPageTitleAsync != null) await SetPageTitleAsync.Invoke("Dashboards");
        await CarregarDashboards();
    }

    private async Task CarregarDashboards()
    {
        isLoading = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            dashboards = await DashboardService.GetByUser(UserState.UserIdString);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Dashboards] Erro ao carregar: {ex.Message}");
            dashboards = new List<MDashboard>();
        }
        finally
        {
            isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void AbrirDashboard(int id)
        => NavigationManager.NavigateTo($"/dashboards/{id}");

    private void AbrirModalNovo()
    {
        novoNome = string.Empty;
        novaDescricao = string.Empty;
        modalNovo.Open();
    }

    private async Task CriarDashboard()
    {
        if (string.IsNullOrWhiteSpace(novoNome))
        {
            ToastService.ShowWarning("Atenção", "Informe um nome para o dashboard.");
            return;
        }

        var dashboard = new MDashboard
        {
            Nome = novoNome.Trim(),
            Descricao = string.IsNullOrWhiteSpace(novaDescricao) ? null : novaDescricao.Trim(),
            UserId = UserState.UserIdString,
            Publico = false,
            Token = Guid.NewGuid().ToString("N"),
            Status = JT_Aplicacao.Classes.StatusObjeto.Novo
        };

        var sucesso = await DashboardService.Save(dashboard);
        if (sucesso)
        {
            ToastService.ShowSuccess("Sucesso", "Dashboard criado!");
            await modalNovo.Close();
            NavigationManager.NavigateTo($"/dashboards/{dashboard.Id}");
        }
        else
        {
            ToastService.ShowError("Erro", "Falha ao criar dashboard.");
        }
    }

    private void AbrirModalCompartilhar(MDashboard d)
    {
        dashboardSelecionado = d;
        modalCompartilhar.Open();
    }

    private string ObterLinkCompartilhamento()
    {
        if (dashboardSelecionado == null) return string.Empty;
        return $"{NavigationManager.BaseUri}compartilhado/{dashboardSelecionado.Token}";
    }

    private async Task CopiarLink()
    {
        try
        {
            var link = ObterLinkCompartilhamento();
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", link);
            ToastService.ShowSuccess("Copiado", "Link copiado para a área de transferência.");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Dashboards] Erro ao copiar: {ex.Message}");
        }
    }

    private async Task SalvarPublicidade()
    {
        if (dashboardSelecionado == null) return;
        await DashboardService.Save(dashboardSelecionado);
        ToastService.ShowSuccess("Sucesso", dashboardSelecionado.Publico ? "Link público ativado." : "Link público desativado.");
    }

    private async Task RegenerarToken()
    {
        if (dashboardSelecionado == null) return;
        dashboardSelecionado.Token = Guid.NewGuid().ToString("N");
        await DashboardService.Save(dashboardSelecionado);
        ToastService.ShowSuccess("Sucesso", "Novo link gerado.");
    }

    private void ConfirmarExclusao(MDashboard d)
    {
        idParaExcluir = d.Id;
        confirmDelete.Show("Excluir Dashboard", $"Tem certeza que deseja excluir o dashboard \"{d.Nome}\"?", "Excluir", "Cancelar", "btn-danger");
    }

    private async Task ExcluirDashboard()
    {
        if (idParaExcluir == null) return;
        var sucesso = await DashboardService.Delete(idParaExcluir.Value);
        if (sucesso)
        {
            ToastService.ShowSuccess("Sucesso", "Dashboard excluído.");
        }
        else
        {
            ToastService.ShowError("Erro", "Falha ao excluir dashboard.");
        }
        await CarregarDashboards();
    }

    public void Dispose() { }
}
