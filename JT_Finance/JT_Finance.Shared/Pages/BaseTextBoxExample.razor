@page "/basetextboxexample"
@using JT_Finance.Shared.Components // For BaseTextBox
@using System.ComponentModel.DataAnnotations

<h3>BaseTextBox Example</h3>

<EditForm Model="@exampleModel" OnValidSubmit="@HandleValidSubmit" OnInvalidSubmit="@HandleInvalidSubmit">
    <DataAnnotationsValidator />

    <fieldset>
        <legend>User Information</legend>

        <BaseTextBox Label="Username (Required)" @bind-Value="exampleModel.Username" Placeholder="Enter your username" />

        <BaseTextBox Label="Email (Required, Email Format)" @bind-Value="exampleModel.Email" Type="email" Placeholder="Enter your email" />

        <BaseTextBox Label="Password (Required, Min 6 chars)" @bind-Value="exampleModel.Password" Type="password" Placeholder="Enter your password" />

        <BaseTextBox Label="Age (Optional, Number)" @bind-Value="exampleModel.Age" Type="number" Placeholder="Enter your age" />

        <BaseTextBox Label="Website (Optional, URL Format)" @bind-Value="exampleModel.Website" Type="url" Placeholder="https://example.com" />

        <BaseTextBox @bind-Value="exampleModel.UnlabeledInput" Placeholder="Input without a label" />

    </fieldset>

    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Submit</button>
    </div>
</EditForm>

<hr class="my-4" />

<h4>Submitted Model Data:</h4>
@if (isSubmitted)
{
    <p><strong>Username:</strong> @submittedModel?.Username</p>
    <p><strong>Email:</strong> @submittedModel?.Email</p>
    <p><strong>Password:</strong> @submittedModel?.Password</p>
    <p><strong>Age:</strong> @(submittedModel?.Age.HasValue == true ? submittedModel.Age.ToString() : "Not provided")</p>
    <p><strong>Website:</strong> @(string.IsNullOrWhiteSpace(submittedModel?.Website) ? "Not provided" : submittedModel.Website)</p>
    <p><strong>Unlabeled Input:</strong> @(string.IsNullOrWhiteSpace(submittedModel?.UnlabeledInput) ? "Not provided" : submittedModel.UnlabeledInput)</p>
    @if (isValidSubmit)
    {
        <p class="text-success">Form submitted successfully!</p>
    }
    else
    {
        <p class="text-danger">Form submission failed validation.</p>
    }
}
else
{
    <p><em>Form not yet submitted.</em></p>
}


@code {
    private ExampleModel exampleModel = new ExampleModel();
    private ExampleModel? submittedModel;
    private bool isSubmitted = false;
    private bool isValidSubmit = false;

    public class ExampleModel
    {
        [Required(ErrorMessage = "Username is required.")]
        [StringLength(20, MinimumLength = 3, ErrorMessage = "Username must be between 3 and 20 characters.")]
        public string? Username { get; set; }

        [Required(ErrorMessage = "Email is required.")]
        [EmailAddress(ErrorMessage = "Please enter a valid email address.")]
        public string? Email { get; set; }

        [Required(ErrorMessage = "Password is required.")]
        [MinLength(6, ErrorMessage = "Password must be at least 6 characters long.")]
        public string? Password { get; set; }

        [Range(0, 120, ErrorMessage = "Age must be between 0 and 120.")]
        public int? Age { get; set; } // Nullable for optional input

        [Url(ErrorMessage = "Please enter a valid URL.")]
        public string? Website { get; set; }

        public string? UnlabeledInput { get; set; }
    }

    private void HandleValidSubmit()
    {
        submittedModel = new ExampleModel // Create a copy for display
        {
            Username = exampleModel.Username,
            Email = exampleModel.Email,
            Password = exampleModel.Password, // In real app, don't display password
            Age = exampleModel.Age,
            Website = exampleModel.Website,
            UnlabeledInput = exampleModel.UnlabeledInput
        };
        isSubmitted = true;
        isValidSubmit = true;
        Console.WriteLine("Form submitted successfully!");
        // StateHasChanged(); // May not be needed if EditForm handles it
    }

    private void HandleInvalidSubmit()
    {
        submittedModel = null; // Clear previous submission display
        isSubmitted = true;
        isValidSubmit = false;
        Console.WriteLine("Form submission failed validation.");
    }
}
