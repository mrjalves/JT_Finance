@page "/logs"
@using JT_Classes
@using JT_Aplicacao
@using JT_Finance.Shared.Components
@using System.Text
@using static JT_Finance.Shared.Components.Modal


<!-- Painel de Filtros -->
<div class="card shadow-sm mb-3">
    <div class="card-body">
        <div class="row g-3 align-items-end">
            <div class="col-md-3">
                <label for="levelFilter" class="form-label">Nível</label>
                <InputSelect id="levelFilter" class="form-select" @bind-Value="filtroNivel">
                    <option value="">Todos</option>
                    @foreach (var level in Enum.GetNames(typeof(TipoLog)))
                    {
                        <option value="@level.ToUpper()">@level</option>
                    }
                </InputSelect>
            </div>
            <div class="col-md-3">
                <label for="startDateFilter" class="form-label">Data Início</label>
                <InputDate id="startDateFilter" class="form-control" @bind-Value="filtroDataInicio" />
            </div>
            <div class="col-md-3">
                <label for="endDateFilter" class="form-label">Data Fim</label>
                <InputDate id="endDateFilter" class="form-control" @bind-Value="filtroDataFim" />
            </div>
            <div class="col-md-3">
                <button class="btn btn-primary w-100" @onclick="AplicarFiltros">
                    <i class="bi bi-funnel-fill me-2"></i>Filtrar
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Grid de Logs -->
<DataGrid TItem="LogEntry" Items="listaLogs" IsLoading="isLoading">
    <HeaderTemplate>
        <th style="width: 180px;">Timestamp</th>
        <th style="width: 120px;">Nível</th>
        <th>Mensagem</th>
        <th style="width: 150px;">Executor</th>
        <th>Ações</th>
    </HeaderTemplate>
    <RowTemplate Context="log">
        <td>@log.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</td>
        <td>
            <span class="badge @GetBadgeClass(log.Level)">@log.Level</span>
        </td>
        <td>
            @log.Message
            @if (!string.IsNullOrEmpty(log.StackTrace))
            {
                <button class="btn btn-link btn-sm p-0 ms-2" @onclick="() => AbrirModalStackTrace(log)">
                    Ver Detalhes
                </button>
            }
        </td>
        <td>@log.Executor</td>
        <td>
            <button class="btn btn-danger btn-sm" @onclick="() => AbrirModalConfirmacaoExclusao(log)">
                <i class="bi bi-trash-fill"></i> Excluir
            </button>
        </td>
    </RowTemplate>
    <EmptyTemplate>
        <p class="text-muted mb-0">Nenhum log encontrado com os filtros atuais.</p>
    </EmptyTemplate>
</DataGrid>

<Modal @ref="confirmacaoExclusaoModal" Title="Confirmar Exclusão">
    <BodyContent>
        @if (logParaExcluir != null)
        {
            <p>Tem a certeza que deseja excluir permanentemente o seguinte log?</p>
            <div class="alert alert-warning">
                <strong>@logParaExcluir.Level:</strong> @logParaExcluir.Message
                <br />
                <small class="text-muted">Em @logParaExcluir.Timestamp.ToString("g") por @logParaExcluir.Executor</small>
            </div>
        }
    </BodyContent>
    <FooterContent>
        <button type="button" class="btn btn-secondary" @onclick="() => confirmacaoExclusaoModal.Close()">Cancelar</button>
        <button type="button" class="btn btn-danger" @onclick="ConfirmarExclusaoAsync">Sim, Excluir</button>
    </FooterContent>
</Modal>

<!-- Modal para StackTrace -->
<Modal @ref="stackTraceModal" Title="Detalhes do Erro">
    <BodyContent>
        @if (logSelecionado != null)
        {
            <div>
                <strong>Mensagem:</strong>
                <p>@logSelecionado.Message</p>
            </div>
            <hr />
            <div>
                <strong>Stack Trace:</strong>
                <pre class="bg-light p-2 rounded" style="white-space: pre-wrap; word-break: break-all;">@logSelecionado.StackTrace</pre>
            </div>
        }
    </BodyContent>
</Modal>

@code {
    [CascadingParameter]
    public Func<string, Task>? SetPageTitleAsync { get; set; }
    private List<LogEntry>? listaLogs;
    private bool isLoading = true;
    private Modal confirmacaoExclusaoModal = new();
    private LogEntry? logParaExcluir; // NOVO: Armazena o log a ser excluído
    // Filtros
    private string filtroNivel = "";
    private DateTime? filtroDataInicio;
    private DateTime? filtroDataFim;

    // Modal
    private Modal stackTraceModal = new();
    private LogEntry? logSelecionado;

    protected override async Task OnInitializedAsync()
    {
        if (SetPageTitleAsync != null)
               await SetPageTitleAsync.Invoke("Logs");
        await CarregarLogs();
    }

    private async Task AplicarFiltros()
    {
        await CarregarLogs();
    }
    // NOVO: Abre o modal de confirmação
    private void AbrirModalConfirmacaoExclusao(LogEntry log)
    {
        logParaExcluir = log;
        confirmacaoExclusaoModal.Open();
    }

    // NOVO: Executa a exclusão após a confirmação
    private async Task ConfirmarExclusaoAsync()
    {
        if (logParaExcluir == null) return;

        bool sucesso = JT_Servicos.LogService.Delete(logParaExcluir.Id);

        if (sucesso)
        {
            confirmacaoExclusaoModal.Close();
            await CarregarLogs(); 
        }
        else
        {
            // Opcional: Mostrar uma mensagem de erro ao utilizador
            // Por exemplo, usando um componente de Toast/Notification.
        }
    }

    private async Task CarregarLogs()
    {
        isLoading = true;
        await Task.Yield();
        listaLogs = JT_Servicos.LogService.GetAll();
        isLoading = false;
    }

    private string GetBadgeClass(string level)
    {
        return level.ToUpper() switch
        {
            "ERRO" => "bg-danger",
            "ATUALIZACAO" => "bg-info",
            "EXCLUSAO" => "bg-warning",
            "CONSULTA" => "bg-secondary",
            _ => "bg-primary",
        };
    }

    private void AbrirModalStackTrace(LogEntry log)
    {
        logSelecionado = log;
        stackTraceModal.Open();
    }
}
