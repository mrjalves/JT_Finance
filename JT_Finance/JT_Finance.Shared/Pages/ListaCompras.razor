@page "/listacompras"
@using JT_Finance.Shared.Components
@using System.ComponentModel.DataAnnotations

<h3>Lista de Compras</h3>

<button class="btn btn-primary mb-3" @onclick="() => AdicionarNovoItem()">Novo Item</button>

<DataGrid TItem="ItemListaCompraModel" Items="listaItensCompra">
    <HeaderTemplate>
        <th>Nome</th>
        <th>Quantidade</th>
        <th>Comprado</th>
        <th>Ações</th>
    </HeaderTemplate>
    <RowTemplate Context="item">
        <td style="@(item.Comprado ? "text-decoration: line-through;" : "")">@item.Nome</td>
        <td style="@(item.Comprado ? "text-decoration: line-through;" : "")">@item.Quantidade</td>
        <td>
            <InputCheckbox @bind-Value="item.Comprado" @oninput="(e) => ToggleComprado(item, (bool)e.Value)" />
        </td>
        <td>
            <button class="btn btn-sm btn-info" @onclick="() => EditarItem(item)" disabled="@item.Comprado">Editar</button>
            <button class="btn btn-sm btn-danger" @onclick="() => RemoverItem(item.Id)">Remover</button>
        </td>
    </RowTemplate>
</DataGrid>

<Modal @ref="modalRef"
       IsOpen="exibirModalFormulario"
       Title="@(itemAtual.Id == Guid.Empty ? "Novo Item" : "Editar Item")"
       OnClose="FecharModalFormulario"
       ShowCloseButton="true"
       CloseOnBackdropClick="false">
    <BodyContent>
        @if (exibirModalFormulario) // Renderiza o formulário apenas quando o modal está aberto para garantir que o itemAtual está correto
        {
            <CrudForm TItem="ItemListaCompraModel" Item="itemAtual" OnSubmit="SalvarItem" OnCancel="FecharModalFormulario">
                <ChildContent Context="formItem">
                    <CustomInput Label="Nome do Item" @bind-Value="formItem.Nome" />
                    <CustomInput Label="Quantidade" Type="number" @bind-Value="formItem.QuantidadeAsString" />
                    <div class="form-group form-check">
                        <InputCheckbox id="compradoModal" class="form-check-input" @bind-Value="formItem.Comprado" />
                        <label class="form-check-label" for="compradoModal">Comprado</label>
                    </div>
                </ChildContent>
            </CrudForm>
        }
    </BodyContent>
</Modal>

@code {
    private List<ItemListaCompraModel> listaItensCompra = new List<ItemListaCompraModel>();
    private ItemListaCompraModel itemAtual = new ItemListaCompraModel();
    private bool exibirModalFormulario = false; // Renomeado de exibirFormulario
    private Modal modalRef; // Referência para o componente Modal, se necessário para chamadas programáticas

    protected override void OnInitialized()
    {
        // Dados de exemplo
        listaItensCompra.Add(new ItemListaCompraModel { Id = Guid.NewGuid(), Nome = "Leite", Quantidade = 2, Comprado = false });
        listaItensCompra.Add(new ItemListaCompraModel { Id = Guid.NewGuid(), Nome = "Pão", Quantidade = 1, Comprado = true });
        listaItensCompra.Add(new ItemListaCompraModel { Id = Guid.NewGuid(), Nome = "Ovos", Quantidade = 12, Comprado = false });
    }

    private void AdicionarNovoItem()
    {
        itemAtual = new ItemListaCompraModel();
        exibirModalFormulario = true; // Mostra o modal
    }

    private void EditarItem(ItemListaCompraModel itemParaEditar)
    {
        // Cria uma cópia para edição para não afetar a lista diretamente até salvar
        itemAtual = new ItemListaCompraModel
        {
            Id = itemParaEditar.Id,
            Nome = itemParaEditar.Nome,
            Quantidade = itemParaEditar.Quantidade,
            Comprado = itemParaEditar.Comprado
        };
        exibirModalFormulario = true; // Mostra o modal
    }

    private void SalvarItem(ItemListaCompraModel itemSalvo) // Parâmetro renomeado para clareza
    {
        if (itemSalvo.Id == Guid.Empty)
        {
            itemSalvo.Id = Guid.NewGuid();
            listaItensCompra.Add(itemSalvo);
        }
        else
        {
            var index = listaItensCompra.FindIndex(i => i.Id == itemSalvo.Id);
            if (index != -1)
            {
                listaItensCompra[index] = itemSalvo;
            }
        }
        FecharModalFormulario(); // Fecha o modal após salvar
    }

    private void RemoverItem(Guid id)
    {
        var itemParaRemover = listaItensCompra.FirstOrDefault(i => i.Id == id);
        if (itemParaRemover != null)
        {
            listaItensCompra.Remove(itemParaRemover);
        }
    }

    // Este método é chamado pelo Modal quando ele é fechado (pelo botão X ou OnClose)
    // e também pelo CrudForm quando o botão Cancelar é clicado.
    private void FecharModalFormulario()
    {
        exibirModalFormulario = false;
        itemAtual = new ItemListaCompraModel(); // Limpa o item atual
        StateHasChanged(); // Garante que a UI reaja à mudança de estado do modal
    }

    private void ToggleComprado(ItemListaCompraModel item, bool comprado)
    {
        var itemNaLista = listaItensCompra.FirstOrDefault(i => i.Id == item.Id);
        if (itemNaLista != null)
        {
            itemNaLista.Comprado = comprado;
            // StateHasChanged(); // Pode ser necessário se a atualização não for refletida automaticamente na UI
        }
    }

    public class ItemListaCompraModel
    {
        public Guid Id { get; set; }

        [Required(ErrorMessage = "O nome do item é obrigatório.")]
        [StringLength(100, ErrorMessage = "O nome do item deve ter no máximo 100 caracteres.")]
        public string Nome { get; set; }

        [Required(ErrorMessage = "A quantidade é obrigatória.")]
        [Range(1, int.MaxValue, ErrorMessage = "A quantidade deve ser pelo menos 1.")]
        public int Quantidade { get; set; }

        public string QuantidadeAsString
        {
            get => Quantidade.ToString();
            set
            {
                if (int.TryParse(value, out var intValue))
                {
                    Quantidade = intValue;
                }
            }
        }
        public bool Comprado { get; set; }
    }
}
