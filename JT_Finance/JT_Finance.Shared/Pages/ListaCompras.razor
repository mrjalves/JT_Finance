@page "/listacompras"
@using JT_Classes.Financeiro
@using JT_Finance.Shared.Components
@using JT_Finance.Shared.Services
@using JT_UserInterface.Shared.Components.Core
@using static JT_UserInterface.Shared.Components.Core.ConfirmDialog
@using static JT_UserInterface.Shared.Components.Core.Modal
@inject JT_UserInterface.Shared.Services.Comum.ToastService ToastService


<!-- Seletor de Listas e Botões de Ação -->
<div class="card shadow-sm mb-3">
    <div class="card-body d-flex justify-content-between align-items-center">
        <div class="d-flex align-items-center flex-grow-1">
            <label for="listaSelect" class="form-label me-2 mb-0 fw-bold">Lista Ativa:</label>
            <InputSelect id="listaSelect" class="form-select w-auto" @bind-Value="listaSelecionadaId">
                <option value="0">Selecione uma lista...</option>
                @if (listasDeCompra != null)
                {
                    @foreach (var lista in listasDeCompra)
                    {
                        <option value="@lista.Id">@lista.Descricao</option>
                    }
                }
            </InputSelect>
            <button class="btn btn-outline-secondary ms-2" @onclick="AbrirModalGerenciarListas" title="Gerenciar Listas">
                <i class="bi bi-gear-fill"></i>
            </button>
        </div>
        <button class="btn btn-primary" @onclick="AbrirModalNovoItem" disabled="@(listaSelecionadaId == 0)">
            <i class="bi bi-plus-circle-fill me-2"></i>Novo Item
        </button>
    </div>
</div>

<!-- Grid de Itens da Lista Selecionada -->
<JT_UserInterface.Shared.Components.Core.DataGrid TItem="ListaCompraItem" Items="itensDaListaSelecionada" IsLoading="isLoading">
    <HeaderTemplate>
        <th style="width: 80px;">Comprado</th>
        <th>Produto</th>
        <th>Quantidade</th>
        <th>Unidade</th>
        <th class="text-end">Ações</th>
    </HeaderTemplate>
    <RowTemplate Context="item">
        <td>
            <div class="form-check form-switch d-flex justify-content-center">
                <InputCheckbox class="form-check-input" @bind-Value="item.Comprado" @bind-Value:after='() => AtualizarStatusItem(item)' />
            </div>
        </td>
        <td><span class="@(item.Comprado ? "text-decoration-line-through text-muted" : "")">@item.DescricaoProduto</span></td>
        <td><span class="@(item.Comprado ? "text-decoration-line-through text-muted" : "")">@item.Quantidade</span></td>
        <td><span class="@(item.Comprado ? "text-decoration-line-through text-muted" : "")">@item.UnidadeMedida</span></td>
        <td>
            <span class="@(item.Comprado ? "text-decoration-line-through text-muted" : "")">
                @item.DescricaoProduto
            </span>

            @if (!string.IsNullOrWhiteSpace(item.LinkProduto))
            {
                <a href="@item.LinkProduto" target="_blank" class="ms-2" title="Abrir link do produto">
                    <i class="bi bi-box-arrow-up-right"></i>
                </a>
            }
        </td>
        <td class="text-end">
            <button class="btn btn-sm btn-outline-primary me-2" @onclick="() => AbrirModalEditarItem(item)" disabled="@item.Comprado">Editar</button>
            <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmarRemocaoItem(item.Id)">Remover</button>
        </td>
    </RowTemplate>
    <EmptyTemplate>
        <p class="text-muted mb-0">@(listaSelecionadaId == 0 ? "Selecione uma lista para ver os itens." : "Esta lista está vazia. Adicione um novo item!")</p>
    </EmptyTemplate>
</JT_UserInterface.Shared.Components.Core.DataGrid>

<!-- Modal para Adicionar/Editar ITENS -->
<JT_UserInterface.Shared.Components.Core.Modal @ref="itemModalRef" Title="@itemModalTitle" OnClose="() => itemAtual = null">
    <BodyContent>
        @if (itemAtual != null)
        {
            <EditForm Model="itemAtual" OnValidSubmit="SalvarItem">
                <DataAnnotationsValidator />
                <div class="mb-3">
                    <label class="form-label">Produto</label>
                    <InputText class="form-control" @bind-Value="itemAtual.DescricaoProduto" />
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Quantidade</label>
                        <InputNumber class="form-control" @bind-Value="itemAtual.Quantidade" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Unidade (un, kg, L)</label>
                        <InputText class="form-control" @bind-Value="itemAtual.UnidadeMedida" />
                    </div>
                </div>
                <hr />
                <h5 class="text-muted">Detalhes do Desejo (Opcional)</h5>

                <div class="mb-3">
                    <label class="form-label">Link do Produto</label>
                    <InputText class="form-control" @bind-Value="itemAtual.LinkProduto" placeholder="https://..." />
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Preço Alvo/Observado</label>
                        <InputNumber class="form-control" @bind-Value="itemAtual.PrecoAlvo" step="0.01" />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Observações</label>
                    <InputTextArea class="form-control" @bind-Value="itemAtual.Observacoes" rows="2" />
                </div>

                <hr />
                <div class="d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-secondary" @onclick="() => itemModalRef.Close()">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Salvar Item</button>
                </div>
            </EditForm>
        }
    </BodyContent>
</JT_UserInterface.Shared.Components.Core.Modal>

<!-- Modal para Gerenciar LISTAS -->
<Modal @ref="listasModalRef" Title="Gerenciar Listas de Compras">
    <BodyContent>
        @foreach (var lista in listasDeCompra)
        {
            <div class="input-group mb-2">
                <InputText class="form-control" @bind-Value="lista.Descricao" />
                <button class="btn btn-success" @onclick="() => SalvarLista(lista)">Salvar</button>
                <button class="btn btn-danger" @onclick="() => ConfirmarRemocaoLista(lista.Id)">Excluir</button>
            </div>
        }
        <hr />
        <h5 class="mt-3">Nova Lista</h5>
        <div class="input-group">
            <InputText class="form-control" @bind-Value="novaListaDescricao" placeholder="Descrição da nova lista" />
            <button class="btn btn-primary" @onclick="AdicionarNovaLista">Criar Nova Lista</button>
        </div>
    </BodyContent>
</Modal>

<ConfirmDialog @ref="confirmDialog" OnConfirm="OnConfirmDelete" />

