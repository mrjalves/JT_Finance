@page "/listacompras"
@using JT_Finance.Shared.Components
@using System.ComponentModel.DataAnnotations

<button class="btn btn-primary mb-3 shadow-sm" @onclick="AdicionarNovoItem">
    <i class="bi bi-plus-circle-fill me-2"></i>Novo Item
</button>

<DataGrid TItem="ItemListaCompraModel" Items="listaItensCompra" IsLoading="isLoading">
    <HeaderTemplate>
        <th>Comprado</th>
        <th>Nome do Item</th>
        <th>Quantidade</th>
        <th class="text-end">Ações</th>
    </HeaderTemplate>
    <RowTemplate Context="item">
        <td>
            <div class="form-check form-switch d-flex justify-content-center">
                <InputCheckbox class="form-check-input" @bind-Value="item.Comprado" title="@(item.Comprado ? "Marcar como não comprado" : "Marcar como comprado")" />
            </div>
        </td>
        <td><span class="@(item.Comprado ? "item-comprado" : "")">@item.Nome</span></td>
        <td><span class="@(item.Comprado ? "item-comprado" : "")">@item.Quantidade</span></td>
        <td class="text-end">
            <button class="btn btn-sm btn-outline-primary" @onclick="() => EditarItem(item)" disabled="@item.Comprado">Editar</button>
            <button class="btn btn-sm btn-outline-danger" @onclick="() => RemoverItem(item.Id)">Remover</button>
        </td>
    </RowTemplate>
    <EmptyTemplate>
        <p class="text-muted mb-0">Sua lista de compras está vazia. Adicione um novo item para começar!</p>
    </EmptyTemplate>
</DataGrid>


<Modal @ref="modalRef" Title="@modalTitle">
    <BodyContent>
        @if (itemAtual != null)
        {
            <EditForm Model="itemAtual" OnValidSubmit="SalvarItem">
                <DataAnnotationsValidator />

                <div class="mb-3">
                    <label for="nomeItem" class="form-label">Nome do Item</label>
                    <InputText id="nomeItem" class="form-control" @bind-Value="itemAtual.Nome" />
                    <ValidationMessage For="@(() => itemAtual.Nome)" />
                </div>

                <div class="mb-3">
                    <label for="quantidadeItem" class="form-label">Quantidade</label>
                    <InputNumber id="quantidadeItem" class="form-control" @bind-Value="itemAtual.Quantidade" />
                    <ValidationMessage For="@(() => itemAtual.Quantidade)" />
                </div>

                <div class="form-check mb-3">
                    <InputCheckbox id="compradoModal" class="form-check-input" @bind-Value="itemAtual.Comprado" />
                    <label class="form-check-label" for="compradoModal">Já foi comprado?</label>
                </div>

                <hr />

                <div class="d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-secondary" @onclick="FecharModal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Salvar</button>
                </div>
            </EditForm>
        }
    </BodyContent>
</Modal>

@code {
    [CascadingParameter]
    public Func<string, Task>? SetPageTitleAsync { get; set; }

    private List<ItemListaCompraModel> listaItensCompra = new();
    private ItemListaCompraModel? itemAtual;
    private bool isLoading = true;

    private Modal modalRef = new();
    private string modalTitle = "";

    protected override async Task OnInitializedAsync()
    {
        if (SetPageTitleAsync != null)
        {
            await SetPageTitleAsync.Invoke("Lista de Compras");
        }

        // Simula carregamento de dados
        isLoading = true;
        await Task.Delay(250);
        CarregarDadosIniciais();
        isLoading = false;
    }

    private void CarregarDadosIniciais()
    {
        // Apenas para exemplo. Em um app real, viria de um banco de dados ou localStorage.
        listaItensCompra = new List<ItemListaCompraModel>
        {
            new() { Id = Guid.NewGuid(), Nome = "Leite Integral", Quantidade = 2, Comprado = false },
            new() { Id = Guid.NewGuid(), Nome = "Pão de Forma", Quantidade = 1, Comprado = true },
            new() { Id = Guid.NewGuid(), Nome = "Dúzia de Ovos", Quantidade = 1, Comprado = false },
            new() { Id = Guid.NewGuid(), Nome = "Café em Pó", Quantidade = 1, Comprado = false }
        };
    }

    private void AdicionarNovoItem()
    {
        itemAtual = new ItemListaCompraModel();
        modalTitle = "Adicionar Novo Item";
        modalRef.Open();
    }

    private void EditarItem(ItemListaCompraModel itemParaEditar)
    {
        // Cria uma cópia para edição, preservando a lista original até salvar
        itemAtual = new ItemListaCompraModel
        {
            Id = itemParaEditar.Id,
            Nome = itemParaEditar.Nome,
            Quantidade = itemParaEditar.Quantidade,
            Comprado = itemParaEditar.Comprado
        };
        modalTitle = "Editar Item";
        modalRef.Open();
    }

    private async Task SalvarItem()
    {
        if (itemAtual == null) return;

        if (itemAtual.Id == Guid.Empty)
        {
            itemAtual.Id = Guid.NewGuid();
            listaItensCompra.Add(itemAtual);
        }
        else
        {
            var index = listaItensCompra.FindIndex(i => i.Id == itemAtual.Id);
            if (index != -1)
            {
                listaItensCompra[index] = itemAtual;
            }
        }
        await FecharModal();
    }

    private void RemoverItem(Guid id)
    {
        listaItensCompra.RemoveAll(i => i.Id == id);
    }

    private async Task FecharModal()
    {
        await modalRef.Close();
        itemAtual = null; // Limpa o item para o próximo uso
    }



    public class ItemListaCompraModel
    {
        public Guid Id { get; set; }

        [Required(ErrorMessage = "O nome do item é obrigatório.")]
        [StringLength(100, ErrorMessage = "O nome não pode ter mais de 100 caracteres.")]
        public string Nome { get; set; } = string.Empty;

        [Required(ErrorMessage = "A quantidade é obrigatória.")]
        [Range(1, int.MaxValue, ErrorMessage = "A quantidade deve ser pelo menos 1.")]
        public int Quantidade { get; set; } = 1;

        public bool Comprado { get; set; }
    }

}