@page "/recuperarsenha"

<div class="auth-overlay">
    <div class="auth-card">
        <h3 class="text-center mb-3">Recuperar Senha</h3>
        <p class="text-center text-muted mb-4">
            Digite seu e-mail abaixo e enviaremos um link para você redefinir sua senha.
        </p>

        <EditForm Model="@recoveryModel" OnValidSubmit="@HandlePasswordRecovery">
            <DataAnnotationsValidator />

            <div class="mb-4">
                <label for="email" class="form-label">Email</label>
                <InputText id="email" class="form-control" @bind-Value="recoveryModel.Email" placeholder="seuemail@exemplo.com" />
                <ValidationMessage For="@(() => recoveryModel.Email)" />
            </div>

            <button type="submit" class="btn btn-primary w-100 mb-3">Enviar Link de Recuperação</button>

            <div class="auth-links text-center mt-3">
                <NavLink href="login">Lembrou a senha? Voltar para o Login</NavLink>
            </div>
        </EditForm>
    </div>
</div>

@code {
    private RecoveryModel recoveryModel = new RecoveryModel();
    private bool linkSent = false; // Opcional: para mostrar uma mensagem de sucesso

    private void HandlePasswordRecovery()
    {
        // Lógica de recuperação de senha aqui
        // Ex: await AuthService.SendPasswordRecoveryLink(recoveryModel.Email);
        Console.WriteLine($"Password recovery attempt for: {recoveryModel.Email}");

        // Após o envio, você pode querer mostrar uma mensagem de sucesso
        // linkSent = true;
    }

    public class RecoveryModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "O email é obrigatório.")]
        [System.ComponentModel.DataAnnotations.EmailAddress(ErrorMessage = "Formato de email inválido.")]
        public string Email { get; set; }
    }
}