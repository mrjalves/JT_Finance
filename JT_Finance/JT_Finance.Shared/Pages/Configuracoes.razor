@page "/configuracoes"

<PageTitle>Configurações - JT Finance</PageTitle>

<h3>Configurações</h3>

<div class="mt-4">
    <p>Bem-vindo à página de Configurações.</p>
    <p>Aqui você poderá ajustar as preferências da sua aplicação.</p>

    <div class="row mt-5">
        <div class="col-md-6">
            <h4>Preferências de Tema</h4>
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" role="switch" id="darkModeSwitch" @bind="isDarkMode" @onchange="ToggleThemePreference">
                <label class="form-check-label" for="darkModeSwitch">Modo Escuro</label>
            </div>
            <p class="form-text">O tema será aplicado em toda a aplicação.</p>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-md-6">
            <h4>Notificações</h4>
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="emailNotifications">
                <label class="form-check-label" for="emailNotifications">
                    Receber notificações por e-mail
                </label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="pushNotifications">
                <label class="form-check-label" for="pushNotifications">
                    Habilitar notificações push
                </label>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-md-6">
            <h4>Gerenciamento de Conta</h4>
            <button class="btn btn-outline-primary">Alterar Senha</button>
            <button class="btn btn-outline-danger ms-2">Excluir Conta</button>
        </div>
    </div>

</div>

@code {
    private bool isDarkMode; // Este estado deve ser sincronizado com o estado global do tema

    protected override void OnInitialized()
    {
        // Carregar preferência de tema do usuário (ex: localStorage ou serviço de usuário)
        // isDarkMode = await UserPreferencesService.GetDarkModePreference();
        Console.WriteLine("Página de Configurações Inicializada.");
    }

    private async Task ToggleThemePreference()
    {
        // isDarkMode já está bindado
        // Salvar preferência de tema do usuário
        // await UserPreferencesService.SetDarkModePreference(isDarkMode);
        // Aplicar o tema globalmente (pode precisar de JSInterop para mudar classe no body e notificar outros componentes)
        Console.WriteLine($"Preferência de tema alterada para: {(isDarkMode ? "Dark" : "Light")}");
        // await JSRuntime.InvokeVoidAsync("applyThemeToBody", isDarkMode);
        // Notificar o Header para atualizar seu ícone de tema, se não estiver usando um serviço de estado compartilhado.
    }
}
