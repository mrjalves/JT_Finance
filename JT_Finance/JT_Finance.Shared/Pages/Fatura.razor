@page "/fatura/{CartaoId:int}"
@page "/fatura/{CartaoId:int}/{Year:int}-{Month:int}"
@using System.Linq
@using JT_Aplicacao
@using JT_Classes.Financeiro
@using JT_Classes.structs
@using JT_Finance.Shared.Components.Modais
@using Microsoft.JSInterop
@using JT_UserInterface.Shared.Components.Core
@using JT_UserInterface.Shared.Templates
@using JT_Finance.Shared.Services.Interfaces
@inject NavigationManager NavigationManager
@inject JT_UserInterface.Shared.Services.Comum.ToastService ToastService
@inject JT_UserInterface.Shared.Services.Comum.FiltroService FiltroService
@inject IJSRuntime JSRuntime
@inject ICartaoCreditoService CartaoService
@implements IDisposable
@if (isLoading)
{
  <Loading/>
}
else if (cartao == null)
{
    <div class="alert alert-danger">
        <h4 class="alert-heading">Cartão não encontrado!</h4>
        <p>O cartão com o ID fornecido não foi encontrado. Por favor, verifique o link ou volte para a lista de cartões.</p>
        <hr>
        <button class="btn btn-secondary" @onclick="Voltar">
            <i class="bi bi-arrow-left-circle me-2"></i>Voltar para a Lista
        </button>
    </div>
}
else
{
    <!-- RESUMO GERAL -->
    <CrudPageTemplate PageTitle="@($"Faturas: {cartao.Nome}")" PageIcon="bi-receipt">
        <TitleBadge>
            @if (Year.HasValue && Month.HasValue)
            {
                <span class="badge bg-primary fs-6">@(new DateTime(Year.Value, Month.Value, 1).ToString("MMMM yyyy"))</span>
            }
        </TitleBadge>
        <PageDescription>
            Visualize o detalhamento e as transações da fatura.
            <span class="text-muted small d-block">
                <span class="me-3">Limite: <strong>@cartao.Limite.ToString("C")</strong></span>
                <span class="me-3">Vencimento: <strong>dia @cartao.DiaVencimento</strong></span>
                <span>Fechamento: <strong>dia @cartao.DiaFechamento</strong></span>
            </span>
        </PageDescription>
        <ToolbarRight>
            <div class="d-flex align-items-center gap-2">
                <button class="btn btn-primary" title="Nova Despesa @NovoHotkeySufixo" aria-label="Nova Despesa @NovoHotkeySufixo"
                        @onclick="AbrirModalParaNovaDespesaGeral">
                    <i class="bi bi-plus-circle-fill me-2"></i>Nova Despesa
                </button>
                <button class="btn btn-outline-secondary" @onclick="Voltar">
                    <i class="bi bi-arrow-left-circle-fill me-2"></i>Voltar
                </button>
            </div>
        </ToolbarRight>
        <ChildContent>
            <div class="card shadow-sm mb-3">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <h5 class="card-title mb-1">Total em Aberto: <span class="text-danger">@totalEmAberto.ToString("C")</span></h5>
                            <div class="card-text text-muted">Total Pago: <strong>@totalPago.ToString("C")</strong></div>
                        </div>
                        <div class="text-end">
                            <span class="badge bg-info rounded-pill fs-6">@faturas.Count faturas</span>
                            <br />
                            <small class="text-muted">@faturas.SelectMany(f => f.Lancamentos).Count() lançamentos</small>
                        </div>
                    </div>
                </div>
            </div>

    @if (faturas.Any())
    {
        <div class="card border-left-success shadow h-80 py-2">
            <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th style="width: 5%;"></th>
                        <th>Vencimento</th>
                        <th>Valor da Fatura</th>
                        <th>Pago</th>
                        <th class="text-center">Lançamentos</th>
                        <th class="text-center">Status</th>
                        <th>Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var fatura in faturas)
                    {
                        <tr @onclick="() => AlternarVisibilidadeFatura(fatura)" style="cursor: pointer;">
                            <td>
                                <button class="btn btn-sm btn-outline-secondary border-0">
                                    <i class="bi @(fatura.EstaExpandida ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                </button>
                            </td>
                            <td><strong>@fatura.DataVencimento.ToString("MMMM yyyy")</strong></td>
                            <td><strong>@fatura.ValorTotal.ToString("C")</strong></td>
                            <td><strong>@fatura.ValorPago.ToString("C")</strong></td>
                            <td class="text-center"><span class="badge bg-info rounded-pill">@fatura.QuantidadeLancamentos</span></td>
                            <td class="text-center">
                                @if(fatura.DataVencimento < DateTime.Today && !fatura.EstaPaga) {
                                    <span class="badge bg-danger">Vencida</span>
                                } else if (fatura.EstaPaga) {
                                    <span class="badge bg-success">Paga</span>
                                } else {
                                    <span class="badge bg-warning text-dark">Em Aberto</span>
                                }
                            </td>
                            <td>
                                <div class="btn-group btn-group-sm" role="group">
                                    <button class="btn btn-outline-primary"
                                            title="Adicionar despesa nesta fatura"
                                            @onclick="(e) => AbrirModalParaNovaDespesaNaFatura(fatura)"
                                            @onclick:stopPropagation="true">
                                        <i class="bi bi-plus-circle"></i>
                                    </button>

                                    @if (fatura.EstaPaga)
                                    {
                                        <button class="btn btn-outline-success disabled" title="Esta fatura já foi paga." @onclick:stopPropagation="true">
                                            <i class="bi bi-check-all"></i> Pago
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-success" @onclick="(e) => AbrirModalPagamento(fatura)" disabled="@isProcessing" @onclick:stopPropagation="true">
                                            <i class="bi bi-check-circle-fill"></i> Pagar Fatura
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>

                        @if (fatura.EstaExpandida)
                        {
                            <tr>
                                <td colspan="7" class="p-0">
                                    <div class="p-3 bg-light">
                                        <table class="table table-sm table-bordered mb-0">
                                            <thead>
                                                <tr>
                                                    <th>Descrição</th>
                                                    <th>Data da Compra</th>
                                                    <th>Valor</th>
                                                    <th class="text-center">Parcela</th>
                                                    <th class="text-center">Paga</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var despesa in fatura.Lancamentos)
                                                {
                                                    <tr>
                                                        <td>@despesa.Despesa.Descricao</td>
                                                        <td>@despesa.Despesa.DataDespesa.ToShortDateString()</td>
                                                        <td>@despesa.Despesa.Valor.ToString("C")</td>
                                                        <td class="text-center">@despesa.DespesaCartaoCredito.NumeroParcela</td>
                                                        <td class="text-center">
                                                            @if (despesa.DespesaCartaoCredito.ParcelaPaga == true)
                                                            {
                                                                <span class="badge bg-success">Sim</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="badge bg-danger">Não</span>
                                                            }
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle-fill me-2"></i>
            Nenhuma despesa encontrada para este cartão@(Year.HasValue && Month.HasValue ? $" em {new DateTime(Year.Value, Month.Value, 1):MMMM yyyy}" : "").
        </div>
    }
    </ChildContent>
    <Modals>

<Modal @ref="pagamentoModal" Title="Confirmar Data de Pagamento" Size="JT_UserInterface.Shared.Components.Core.Modal.ModalSize.Large" CloseOnBackdropClick="false">
    <BodyContent>
        @if (faturaParaPagar != null)
        {
            <p>Selecione a data em que o pagamento da fatura de <strong>@faturaParaPagar.ValorTotal.ToString("C")</strong> foi efetuado.</p>
            <div class="mb-3">
                <label for="dataPagamento" class="form-label">Data do Pagamento</label>
                <input type="date" id="dataPagamento" class="form-control" @bind="dataPagamento" />
            </div>
        }
    </BodyContent>
    <FooterContent>
        <button type="button" class="btn btn-secondary" @onclick="HandleCancelarFormularioModal">Cancelar</button>
        <button type="button" class="btn btn-success" @onclick="ConfirmarPagamento">
            <i class="bi bi-check-circle-fill me-2"></i>Confirmar Pagamento
        </button>
    </FooterContent>
</Modal>

<ModalDespesa
    @ref="modalDespesa"
    Despesa="despesaAtual"
    OnClose="OnDespesaModalClose"
    OnCancel="HandleCancelarModalDespesa" />
    </Modals>
</CrudPageTemplate>
}



