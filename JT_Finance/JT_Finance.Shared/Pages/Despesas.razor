@page "/despesas"
@using JT_Classes
@using JT_Classes.Financeiro
@using JT_Finance.Shared.Components
@using JT_Finance.Shared.Services
@using static JT_Finance.Shared.Components.Modal
@inject ToastService ToastService

<h3>Despesas</h3>
<button class="btn btn-primary mb-3" @onclick="AbrirModalParaNovaDespesa">Nova Despesa</button>
@if (listaDespesas == null)
{
    <p><em>Carregando despesas...</em></p>
}
else
{
    <DataGrid TItem="Despesa" Items="listaDespesas">
        <HeaderTemplate>
            <th>Descrição</th>
            <th>Valor</th>
            <th>Data</th>
            <th>Categoria</th>
            <th>Paga</th>
            <th>Ações</th>
        </HeaderTemplate>
        <RowTemplate Context="despesa">
            <td>@despesa.Descricao</td>
            <td>@despesa.Valor.ToString("C")</td>
            <td>@despesa.DataDespesa.ToShortDateString()</td>
            <td>@despesa.Categoria</td>
            <td>@(despesa.DespesaPaga ? "Sim" : "Não")</td>
            <td>
                <button class="btn btn-sm btn-info" @onclick="() => AbrirModalParaEditarDespesa(despesa.Id)">Editar</button>
                <button class="btn btn-sm btn-danger" @onclick="() => ConfirmarRemocaoDespesa(despesa.Id)">Remover</button>
            </td>
        </RowTemplate>
    </DataGrid>
}


<Modal @ref="crudModal" Title="@modalTitle" OnClose="ResetarEstadoAposModal" Size="ModalSize.Large">

    <BodyContent>

        @if (despesaAtual != null)

        {

            <CrudForm TItem="Despesa" Item="despesaAtual" OnSubmit="HandleSalvarDespesa" OnCancel="HandleCancelarFormularioModal">

                <ChildContent Context="despesaContext">



                    <!-- Descrição -->

                    <div class="form-group mb-3">

                        <label for="descricao">Descrição</label>

                        <InputText id="descricao" class="form-control" @bind-Value="despesaContext.Descricao" />

                        <ValidationMessage For="@(() => despesaContext.Descricao)" />

                    </div>



                    <!-- Valor -->

                    <div class="form-group mb-3">

                        <label for="valor">Valor</label>

                        <InputNumber id="valor" class="form-control" @bind-Value="despesaContext.Valor" />

                        <ValidationMessage For="@(() => despesaContext.Valor)" />

                    </div>



                    <!-- Data da Despesa -->

                    <div class="form-group mb-3">

                        <label for="data_despesa">Data da Despesa</label>

                        <InputDate id="data_despesa" class="form-control" @bind-Value="despesaContext.DataDespesa" />

                        <ValidationMessage For="@(() => despesaContext.DataDespesa)" />

                    </div>



                    <!-- Tipo de Despesa (enum) -->

                    <div class="form-group mb-3">

                        <label for="tipo_despesa">Tipo de Despesa</label>

                        <InputSelect id="tipo_despesa" class="form-control" @bind-Value="despesaContext.TipoDespesa">

                            @foreach (TipoDespesa tipo in Enum.GetValues<TipoDespesa>())

                            {

                                <option value="@tipo">@tipo</option>

                            }

                        </InputSelect>

                        <ValidationMessage For="@(() => despesaContext.TipoDespesa)" />

                    </div>



                    <!-- Categoria (enum) -->

                    <div class="form-group mb-3">

                        <label for="categoria">Categoria</label>

                        <InputSelect id="categoria" class="form-control" @bind-Value="despesaContext.Categoria">

                            @foreach (CategoriaDespesa cat in Enum.GetValues<CategoriaDespesa>())

                            {

                                <option value="@cat">@cat</option>

                            }

                        </InputSelect>

                        <ValidationMessage For="@(() => despesaContext.Categoria)" />

                    </div>



                    <!-- Despesa Paga (bool) -->

                    <div class="form-group mb-3 form-check">

                        <InputCheckbox id="paga" class="form-check-input" @bind-Value="despesaContext.DespesaPaga" />

                        <label class="form-check-label" for="paga">Despesa Paga</label>

                    </div>



                    <!-- Observação -->

                    <div class="form-group mb-3">

                        <label for="observacao">Observação</label>

                        <InputText id="observacao" class="form-control" @bind-Value="despesaContext.Observacao" />

                        <ValidationMessage For="@(() => despesaContext.Observacao)" />

                    </div>



                    <!-- Data de Pagamento (nullable) -->

                    <div class="form-group mb-3">

                        <label for="data_pagamento">Data de Pagamento</label>

                        <InputDate id="data_pagamento" class="form-control" @bind-Value="despesaContext.DataPagamento" />

                        <ValidationMessage For="@(() => despesaContext.DataPagamento)" />

                    </div>



                </ChildContent>

            </CrudForm>



        }

        else

        {

            <p>Carregando formulário...</p>

        }

    </BodyContent>
</Modal>

<ConfirmDialog @ref="confirmDeleteDialog" OnConfirm="EfetuarRemocaoDespesa" />


@code {
    private List<Despesa>? listaDespesas;
    private Despesa? despesaAtual;

    private Modal crudModal = new();
    private string modalTitle = "";

    private ConfirmDialog confirmDeleteDialog = new();
    private int? idDespesaParaRemover;

    protected override async Task OnInitializedAsync()
    {
        await CarregarDespesas();
    }

    // 1. Lógica de Carregamento Direta
    private Task CarregarDespesas()
    {
        // Criamos uma instância temporária apenas para acessar o método "Consultar" herdado.
        listaDespesas = new Despesa().Consultar<Despesa>("SELECT * FROM Despesas ORDER BY DataDespesa DESC");
        StateHasChanged(); // Garante que a UI será atualizada
        return Task.CompletedTask;
    }

    private void AbrirModalParaNovaDespesa()
    {
        despesaAtual = new Despesa();
        modalTitle = "Nova Despesa";
        crudModal.Open();
    }

    // 2. Lógica de Edição usando diretamente o construtor "Active Record"
    private void AbrirModalParaEditarDespesa(int id)
    {
        // O construtor `new Despesa(id)` já busca e carrega o objeto do banco de dados.
        // É a essência do padrão Active Record em ação.
        despesaAtual = new Despesa(id);
        modalTitle = "Editar Despesa";
        crudModal.Open();
    }

    // 3. Lógica de Salvamento chamando métodos do próprio objeto
    private async Task HandleSalvarDespesa(Despesa despesa)
    {
        bool sucesso;

        if (despesa.Id == 0) // Se é um novo registro
        {
            // O próprio objeto "despesa" pode buscar o próximo ID e se salvar.
            despesa.Id = despesa.GetNextId<Despesa>();
            sucesso = despesa.Salvar(despesa);
            ToastService.ShowSuccess("Sucesso!", "Nova despesa salva.");
        }
        else // Se é uma edição
        {
            // O objeto "despesa" se atualiza.
            sucesso = despesa.Atualizar(despesa);
            ToastService.ShowSuccess("Sucesso!", "Despesa atualizada.");
        }

        if (!sucesso)
        {
            ToastService.ShowError("Erro!", "Ocorreu um problema ao salvar a despesa.");
        }

        await crudModal.Close();
        await CarregarDespesas(); // Recarrega a lista
    }

    // 4. Lógica de Remoção usando o objeto carregado
    private async Task EfetuarRemocaoDespesa()
    {
        if (idDespesaParaRemover.HasValue)
        {
            // Carregamos o objeto que queremos remover
            var despesaParaRemover = new Despesa(idDespesaParaRemover.Value);

            // O objeto "despesaParaRemover" é responsável por se excluir do banco.
            var sucesso = despesaParaRemover.Excluir(despesaParaRemover);

            if (sucesso)
            {
                ToastService.ShowSuccess("Removida!", "A despesa foi removida.");
            }
            else
            {
                ToastService.ShowError("Erro!", "Não foi possível remover a despesa.");
            }

            idDespesaParaRemover = null;
            await CarregarDespesas();
        }
    }

    // Métodos auxiliares do modal (sem alterações)
    private async Task HandleCancelarFormularioModal()
    {
        await crudModal.Close();
    }

    private void ResetarEstadoAposModal()
    {
        despesaAtual = null;
        modalTitle = "";
    }

    private async Task ConfirmarRemocaoDespesa(int id)
    {
        idDespesaParaRemover = id;
        await confirmDeleteDialog.Show("Confirmar Remoção", "Deseja realmente remover esta despesa?");
    }
}