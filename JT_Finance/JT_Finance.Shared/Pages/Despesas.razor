@page "/despesas"
@using JT_Classes
@using JT_Classes.Financeiro
@using JT_Finance.Shared.Components
@using JT_Finance.Shared.Services
@using static JT_Finance.Shared.Components.Modal
@inject ToastService ToastService

<button class="btn btn-primary mb-3 shadow-sm" @onclick="AbrirModalParaNovaDespesa">
    <i class="bi bi-plus-circle-fill me-2"></i>Nova Despesa
</button>

<DataGrid TItem="Despesa" Items="listaDespesas" IsLoading="isLoading">
    <HeaderTemplate>
        <th>Descrição</th>
        <th>Valor</th>
        <th>Data</th>
        <th>Categoria</th>
        <th>Cartão / Parcela</th>
        <th>Paga</th>
        <th>Ações</th>
    </HeaderTemplate>

    <RowTemplate Context="despesa">
        <td>@despesa.Descricao</td>
        <td>@despesa.Valor.ToString("C")</td>
        <td>@despesa.DataDespesa.ToShortDateString()</td>

        <td>@despesa.CategoriaDespesa?.Descricao</td>

        <td>
            @* Now checking despesa.EhDespesaCartaoCredito and accessing DetalhesCartaoCredito *@
            @if (despesa.EhDespesaCartaoCredito && despesa.DetalhesCartaoCredito != null)
            {
                <span class="d-block">@despesa.DetalhesCartaoCredito.Cartao?.Nome</span>
                <small class="text-muted">@despesa.DetalhesCartaoCredito.NumeroParcela</small>
            }
            else
            {
                <span class="text-muted">—</span>
            }
        </td>

        <td>
            @if (despesa.DespesaPaga)
            {
                <span class="badge bg-success">Sim</span>
            }
            else
            {
                <span class="badge bg-danger">Não</span>
            }
        </td>
        <td>
            <button class="btn btn-sm btn-outline-primary" @onclick="() => AbrirModalParaEditarDespesa(despesa.Id)">
                <i class="bi bi-pencil-fill me-1"></i>Editar
            </button>
            <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmarRemocaoDespesa(despesa.Id)">
                <i class="bi bi-trash-fill me-1"></i>Remover
            </button>
        </td>
    </RowTemplate>

    <EmptyTemplate>
        <p class="text-muted mb-0">Nenhuma despesa cadastrada ainda. Clique em "Nova Despesa" para começar.</p>
    </EmptyTemplate>
</DataGrid>

<Modal @ref="crudModal" Title="@modalTitle" OnClose="ResetarEstadoAposModal" Size="ModalSize.Large" CloseOnBackdropClick="false">
    <BodyContent>
        @if (despesaAtual != null)
        {
            <EditForm Model="despesaAtual" OnValidSubmit="() => HandleSalvarDespesa(despesaAtual)">
                <DataAnnotationsValidator />
                <div class="form-check form-switch mb-3">
                    @* Binding EhDespesaCartaoCredito now *@
                    <InputCheckbox id="isCardExpense" class="form-check-input" @bind-Value="despesaAtual.EhDespesaCartaoCredito" />
                    <label class="form-check-label" for="isCardExpense">É uma despesa de Cartão de Crédito?</label>
                </div>
                <hr />

                <div class="row">
                    <div class="col-md-12 mb-3">
                        <label for="descricao" class="form-label">Descrição</label>
                        <InputText id="descricao" class="form-control" @bind-Value="despesaAtual.Descricao" />
                        <ValidationMessage For="@(() => despesaAtual.Descricao)" />
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label for="valor" class="form-label">Valor</label>
                        <InputNumber id="valor" step="0.01" class="form-control" @bind-Value="despesaAtual.Valor" />
                        <ValidationMessage For="@(() => despesaAtual.Valor)" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label for="data_despesa" class="form-label">Data da Despesa</label>
                        <InputDate id="data_despesa" class="form-control" @bind-Value="despesaAtual.DataDespesa" />
                        <ValidationMessage For="@(() => despesaAtual.DataDespesa)" />
                    </div>
                </div>
                @* Conditional rendering based on EhDespesaCartaoCredito *@
                @if (despesaAtual.EhDespesaCartaoCredito && despesaAtual.DetalhesCartaoCredito != null)
                {
                    <div class="row p-3 mb-3 bg-light border rounded animate__animated animate__fadeIn">
                        <div class="col-md-6 mb-3">
                            <label for="cartao" class="form-label">Cartão de Crédito</label>
                            @* Binding to despesaAtual.DetalhesCartaoCredito.IdCartao *@
                            <InputSelect id="cartao" class="form-select" @bind-Value="despesaAtual.DetalhesCartaoCredito.IdCartao">
                                <option value="0">Selecione um cartão...</option>
                                @foreach (var cartao in listaCartoesCredito)
                                {
                                    <option value="@cartao.Id">@cartao.Nome</option>
                                }
                            </InputSelect>
                            @* Validation for the nested object's property *@
                            <ValidationMessage For="@(() => despesaAtual.DetalhesCartaoCredito.IdCartao)" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="parcelas" class="form-label">Quantidade de Parcelas</label>
                            @* Binding to despesaAtual.DetalhesCartaoCredito.QuantidadeParcelas *@
                            <InputNumber id="parcelas" class="form-control" @bind-Value="despesaAtual.DetalhesCartaoCredito.QuantidadeParcelas" />
                            <ValidationMessage For="@(() => despesaAtual.DetalhesCartaoCredito.QuantidadeParcelas)" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="data_vencimento_fatura" class="form-label">Data Vencimento Fatura (Primeira Parcela)</label>
                            @* Binding to despesaAtual.DetalhesCartaoCredito.DataVencimento *@
                            <InputDate id="data_vencimento_fatura" class="form-control" @bind-Value="despesaAtual.DetalhesCartaoCredito.DataVencimento" />
                            <ValidationMessage For="@(() => despesaAtual.DetalhesCartaoCredito.DataVencimento)" />
                        </div>
                    </div>
                }
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label for="tipo_despesa" class="form-label">Tipo de Despesa</label>
                        <div class="input-group">
                            <InputSelect id="tipo_despesa" class="form-select" @bind-Value="despesaAtual.TipoDespesa" disabled="@showNewTipoForm">
                                <option value="0">Selecione um tipo...</option>
                                @if (opcoesTipoDespesa != null)
                                {
                                    @foreach (var tipo in opcoesTipoDespesa)
                                    {
                                        <option value="@tipo.Id">@tipo.Descricao</option>
                                    }
                                }
                            </InputSelect>
                            <button class="btn btn-outline-secondary" type="button" @onclick='() => ToggleInlineForm("TipoDespesa")' title="Adicionar Novo Tipo">
                                <i class="bi bi-plus-lg"></i>
                            </button>
                        </div>
                        <ValidationMessage For="@(() => despesaAtual.TipoDespesa)" />

                        @if (showNewTipoForm)
                        {
                            <div class="input-group mt-2 animate__animated animate__fadeIn">
                                <InputText @bind-Value="newOptionDescription" class="form-control" placeholder="Nova descrição para Tipo..." />
                                <button type="button" class="btn btn-success" @onclick='() => SalvarNovaOpcaoInline("TipoDespesa")'>Salvar</button>
                                <button type="button" class="btn btn-secondary" @onclick='() => ToggleInlineForm("TipoDespesa")'>Cancelar</button>
                            </div>
                        }
                    </div>

                    <div class="col-md-6 mb-3">
                        <label for="categoria" class="form-label">Categoria</label>
                        <div class="input-group">
                            <InputSelect id="categoria" class="form-select" @bind-Value="despesaAtual.Categoria" disabled="@showNewCategoriaForm">
                                <option value="0">Selecione uma categoria...</option>
                                @if (opcoesCategoriaDespesa != null)
                                {
                                    @foreach (var cat in opcoesCategoriaDespesa)
                                    {
                                        <option value="@cat.Id">@cat.Descricao</option>
                                    }
                                }
                            </InputSelect>
                            <button class="btn btn-outline-secondary" type="button" @onclick='() => ToggleInlineForm("Categoria")' title="Adicionar Nova Categoria">
                                <i class="bi bi-plus-lg"></i>
                            </button>
                        </div>
                        <ValidationMessage For="@(() => despesaAtual.Categoria)" />

                        @if (showNewCategoriaForm)
                        {
                            <div class="input-group mt-2 animate__animated animate__fadeIn">
                                <InputText @bind-Value="newOptionDescription" class="form-control" placeholder="Nova descrição para Categoria..." />
                                <button type="button" class="btn btn-success" @onclick='() => SalvarNovaOpcaoInline("Categoria")'>Salvar</button>
                                <button type="button" class="btn btn-secondary" @onclick='() => ToggleInlineForm("Categoria")'>Cancelar</button>
                            </div>
                        }
                    </div>
                </div>

                <div class="form-group mb-3">
                    <label for="observacao" class="form-label">Observação</label>
                    <InputTextArea id="observacao" class="form-control" @bind-Value="despesaAtual.Observacao" rows="3" />
                    <ValidationMessage For="@(() => despesaAtual.Observacao)" />
                </div>

                <div class="row align-items-center">
                    <div class="col-md-6 mb-3">
                        <div class="form-check form-switch">
                            <InputCheckbox id="paga" class="form-check-input" @bind-Value="despesaAtual.DespesaPaga" />
                            <label class="form-check-label" for="paga">Despesa já foi paga?</label>
                        </div>
                    </div>
                    @if (despesaAtual.DespesaPaga)
                    {
                        <div class="col-md-6 mb-3">
                            <label for="data_pagamento" class="form-label">Data de Pagamento</label>
                            <InputDate id="data_pagamento" class="form-control" @bind-Value="despesaAtual.DataPagamento" />
                            <ValidationMessage For="@(() => despesaAtual.DataPagamento)" />
                        </div>
                    }
                </div>

                <hr />

                <div class="d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-secondary" @onclick="HandleCancelarFormularioModal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Salvar</button>
                </div>
            </EditForm>
        }
        else
        {
            <p>Carregando formulário...</p>
        }
    </BodyContent>
</Modal>

<ConfirmDialog @ref="confirmDeleteDialog" OnConfirm="EfetuarRemocaoDespesa" />

@code {
    [CascadingParameter]
    public Func<string, Task>? SetPageTitleAsync { get; set; }

    // --- Variáveis de Estado da Página ---
    private bool isLoading = true;
    // --- Referências de Componentes ---
    private Modal crudModal = new();
    private string modalTitle = "";
    private ConfirmDialog confirmDeleteDialog = new();
    private int? idDespesaParaRemover;

    // --- Repositórios e Dados de Categoria ---
    private Despesa? despesaAtual;
    private List<Despesa>? listaDespesas;
    private List<Categoria> opcoesTipoDespesa;
    private List<Categoria> opcoesCategoriaDespesa;
    private List<CartaoCredito> listaCartoesCredito;
    // --- Formulário Inline ---
    private bool showNewTipoForm = false;
    private bool showNewCategoriaForm = false;
    private string newOptionDescription = "";

    // --- Ciclo de Vida ---
    protected override async Task OnInitializedAsync()
    {
        if (SetPageTitleAsync != null)
        {
            await SetPageTitleAsync.Invoke("Despesas");
        }
        await CarregarDependencias();
    }

    private async Task CarregarDependencias()
    {
        isLoading = true;
        await Task.WhenAll(
            CarregarDespesas(),
            CarregarOpcoesDeCategoria(),
            CarregarCartoesDeCredito()
        );
        isLoading = false;
    }

    // --- Carregamento de Dados ---
    private Task CarregarOpcoesDeCategoria()
    {
        try
        {
            opcoesTipoDespesa = Categoria.ListarPorPapel("Despesa", "TipoDespesa");
            opcoesCategoriaDespesa = Categoria.ListarPorPapel("Despesa", "Categoria");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro ao carregar opções de categoria: {ex.Message}");
            opcoesTipoDespesa = new();
            opcoesCategoriaDespesa = new();
        }

        return Task.CompletedTask;
    }
    private Task CarregarCartoesDeCredito()
    {
        try
        {
            listaCartoesCredito = new CartaoCredito().Consultar<CartaoCredito>("SELECT * FROM CartoesCredito WHERE Ativo = 1 ORDER BY Nome");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro ao carregar cartões: {ex.Message}");
            listaCartoesCredito = new List<CartaoCredito>();
        }
        return Task.CompletedTask;
    }

    // --- MODIFICAÇÃO CHAVE AQUI PARA CARREGAR DETALHES DO CARTÃO ---
    private async Task CarregarDespesas()
    {
        isLoading = true;
        listaDespesas = new Despesa().Consultar<Despesa>("SELECT * FROM Despesas ORDER BY DataDespesa DESC");

        // Para cada despesa, se for de cartão, carregar os detalhes
        foreach (var despesa in listaDespesas)
        {
            if (despesa.EhDespesaCartaoCredito)
            {
                // Instancia DespesaCartaoCredito com o Id da Despesa para carregar os detalhes
                despesa.DetalhesCartaoCredito = new DespesaCartaoCredito(despesa.Id);

                // Carrega o objeto CartaoCredito se o DetalhesCartaoCredito foi carregado com sucesso
                if (despesa.DetalhesCartaoCredito.IdCartao > 0)
                {
                    despesa.DetalhesCartaoCredito.Cartao = new CartaoCredito(despesa.DetalhesCartaoCredito.IdCartao);
                }
            }
        }
        isLoading = false;
    }


    // --- Ações do Modal ---
    private void AbrirModalParaNovaDespesa()
    {
        despesaAtual = new Despesa(JT_Persistencia.Persistencia.StatusObjeto.Novo);
        modalTitle = "Nova Despesa";
        crudModal.Open();
    }

    private void AbrirModalParaEditarDespesa(int id)
    {
        despesaAtual = new Despesa(id); // O construtor de Despesa já deve carregar DetalhesCartaoCredito se for o caso
        modalTitle = "Editar Despesa";
        crudModal.Open();
    }

    private async Task HandleSalvarDespesa(Despesa despesa)
    {
        bool sucesso = despesa.Salvar();

        if (sucesso)
        {
            ToastService.ShowSuccess("Sucesso!", "Nova despesa salva.");
            await crudModal.Close();
            await CarregarDespesas(); // Recarrega todas as despesas (agora com detalhes de cartão)
        }
        else
        {
            ToastService.ShowError("Erro!", "Ocorreu um problema ao salvar a despesa.");
        }
    }

    private async Task EfetuarRemocaoDespesa()
    {
        if (idDespesaParaRemover.HasValue)
        {
            var despesaParaRemover = new Despesa(idDespesaParaRemover.Value);
            // A exclusão da Despesa automaticamente excluirá os DetalhesCartaoCredito devido ao ON DELETE CASCADE no banco.
            var sucesso = despesaParaRemover.Excluir(despesaParaRemover);

            if (sucesso)
                ToastService.ShowSuccess("Removida!", "A despesa foi removida.");
            else
                ToastService.ShowError("Erro!", "Não foi possível remover a despesa.");

            idDespesaParaRemover = null;
            await CarregarDespesas();
        }
    }

    private async Task HandleCancelarFormularioModal()
    {
        despesaAtual.LimparReservaDeId(); // Limpa o ID reservado para evitar conflitos
        despesaAtual = null;
        await crudModal.Close();
    }

    private void ResetarEstadoAposModal()
    {
        despesaAtual = null;
        modalTitle = "";
        showNewTipoForm = false;
        showNewCategoriaForm = false;
        newOptionDescription = ""; // Limpa a descrição para nova opção
    }

    private async Task ConfirmarRemocaoDespesa(int id)
    {
        idDespesaParaRemover = id;
        confirmDeleteDialog.Show("Confirmar Remoção", "Deseja realmente remover esta despesa?");
    }

    // --- Formulário Inline de Categorias ---
    private void ToggleInlineForm(string papel)
    {
        newOptionDescription = "";

        if (papel == "TipoDespesa")
        {
            showNewTipoForm = !showNewTipoForm;
            showNewCategoriaForm = false;
        }
        else if (papel == "Categoria")
        {
            showNewCategoriaForm = !showNewCategoriaForm;
            showNewTipoForm = false;
        }
    }

    private async Task SalvarNovaOpcaoInline(string papel)
    {
        if (string.IsNullOrWhiteSpace(newOptionDescription))
        {
            ToastService.ShowWarning("Atenção", "A descrição não pode estar vazia.");
            return;
        }

        var novaOpcao = new Categoria(JT_Persistencia.Persistencia.StatusObjeto.Novo)
        {
            TipoEntidade = "Despesa",
            Nome = papel,
            Descricao = newOptionDescription
        };

        bool sucesso = novaOpcao.Salvar();

        if (sucesso)
        {
            ToastService.ShowSuccess("Sucesso!", "Nova opção de categoria salva.");
            await CarregarOpcoesDeCategoria(); // Recarrega as listas de categorias

            // Seleciona a nova opção no dropdown
            if (papel == "TipoDespesa")
            {
                if (despesaAtual != null) despesaAtual.TipoDespesa = novaOpcao.Id;
                showNewTipoForm = false;
            }
            else if (papel == "Categoria")
            {
                if (despesaAtual != null) despesaAtual.Categoria = novaOpcao.Id;
                showNewCategoriaForm = false;
            }

            newOptionDescription = "";
            StateHasChanged(); // Força a UI a renderizar
        }
        else
        {
            ToastService.ShowError("Erro!", "Não foi possível salvar a nova opção.");
        }
    }
}