@page "/despesas"
@using JT_Classes
@using JT_Classes.Financeiro
@using JT_Finance.Shared.Components
@using JT_Finance.Shared.Components.Grids
@using JT_Finance.Shared.Components.Modais
@using JT_Finance.Shared.Services
@using System.Text
@using JT_Finance.Shared.Services.Interfaces
@inject IDespesaService DespesaService
@implements IDisposable

<button class="btn btn-primary mb-3 shadow-sm" @onclick="AbrirModalParaNovaDespesa">
    <i class="bi bi-plus-circle-fill me-2"></i>Nova Despesa
</button>

<GridDespesas 
    Despesas="despesasFiltradas"
    IsLoading="isLoading"
              OnEditar="AbrirModalParaEditarDespesa"
              OnRemover="ConfirmarRemocaoDespesa"
              OnDuplicar="DuplicarDespesa"
/> 

<JT_Finance.Shared.Components.Modais.ModalDespesa
    @ref="modalDespesa"
    Despesa="despesaAtual"
    OnClose="ResetarEstadoAposModal"
    OnCancel="HandleCancelarFormularioModal" />


<ConfirmDialog @ref="confirmDeleteDialog" OnConfirm="EfetuarRemocaoDespesa" />

@code {
    [CascadingParameter]
    public Func<string, Task>? SetPageTitleAsync { get; set; }

    private bool isLoading = true;
    private ModalDespesa modalDespesa = new();
    private int? idDespesaParaRemover;
    private ConfirmDialog confirmDeleteDialog = new();
    private Despesa? despesaAtual;
   
    private List<Despesa> despesasFiltradas = new();

    protected override async Task OnInitializedAsync()
    {
        if (SetPageTitleAsync != null)
        {
            await SetPageTitleAsync.Invoke("Despesas");
        }
        DespesaService.OnDataChanged += AtualizarDadosDaPagina;
        await CarregarDependencias();
    }

    private async void AtualizarDadosDaPagina()
    {
        await InvokeAsync(async () =>
        {
            await CarregarDependencias();
            StateHasChanged();
        });
    }

    private async Task CarregarDependencias()
    {
        isLoading = true;
        await Task.WhenAll(
            CarregarDespesas()
        );
        isLoading = false;
    }

    private async Task CarregarDespesas(string whereClause = "")
    {
        despesasFiltradas = await DespesaService.ObterTodasDespesasAsync();
    }

    private async Task DuplicarDespesa(Despesa Despesa)
    {
        await DespesaService.DuplicarDespesaAsync(Despesa);
    }

    private async Task EfetuarRemocaoDespesa()
    {
        if (idDespesaParaRemover.HasValue)
        {
            await DespesaService.RemoverDespesaAsync(idDespesaParaRemover.Value);
            idDespesaParaRemover = null;
        }
    }

    private void AbrirModalParaNovaDespesa()
    {
        despesaAtual = new Despesa(JT_Persistencia.Persistencia.StatusObjeto.Novo);
        modalDespesa.Title = "Nova Despesa";
        modalDespesa.Open();
    }

    private void AbrirModalParaEditarDespesa(int id)
    {
        despesaAtual = new Despesa(id);
        modalDespesa.Title = "Editar Despesa";
        modalDespesa.Open();
    }

    private async Task HandleCancelarFormularioModal()
    {
        despesaAtual = null;
        await modalDespesa.Close();
    }

    private void ResetarEstadoAposModal()
    {
        despesaAtual = null;
    }

    private void ConfirmarRemocaoDespesa(int id)
    {
        idDespesaParaRemover = id;
        confirmDeleteDialog.Show("Confirmar Remoção", "Deseja realmente remover esta despesa?");
    }

    public void Dispose()
    {
        DespesaService.OnDataChanged -= AtualizarDadosDaPagina;
    }
   
}