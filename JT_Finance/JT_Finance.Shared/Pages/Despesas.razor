@page "/despesas"
@using JT_Classes
@using JT_Classes.Financeiro
@using JT_Classes.structs
@using JT_Finance.Shared.Components
@using JT_Finance.Shared.Components.Grids
@using JT_Finance.Shared.Components.Modais
@using JT_Finance.Shared.Services
@using System.Text
@using JT_Finance.Shared.Services.Interfaces
@using JT_UserInterface.Shared
@using JT_UserInterface.Shared.Components
@using JT_UserInterface.Shared.Services
@using JT_UserInterface.Shared.Templates
@inject IDespesaService DespesaService
@implements IDisposable
@inject FiltroService FiltroService
@inject IJSRuntime JSRuntime

<CrudPageTemplate>
    <ToolbarLeft>
        <button class="btn btn-primary" title="Nova Despesa (Alt+N)" aria-label="Nova Despesa (Alt+N)" @onclick="AbrirModalParaNovaDespesa">
            <i class="bi bi-plus-circle-fill me-1"></i>
            <span class="d-none d-sm-inline">Nova Despesa</span> </button>
    </ToolbarLeft>
    
    <ToolbarRight>
    </ToolbarRight>

    <ChildContent>
        <GridDespesas 
            PageSize="_pageSize"
            Despesas="despesasFiltradas"
            IsLoading="isLoading"
            OnEditar="AbrirModalParaEditarDespesa"
            OnRemover="ConfirmarRemocaoDespesa"
            OnDuplicar="DuplicarDespesa"/> 
    </ChildContent>

    <Modals>
        <JT_Finance.Shared.Components.Modais.ModalDespesa
            @ref="modalDespesa"
            Despesa="despesaAtual"
            OnClose="ResetarEstadoAposModal"
            OnCancel="HandleCancelarFormularioModal" />
            
        <ConfirmDialog @ref="confirmDeleteDialog" OnConfirm="EfetuarRemocaoDespesa" />
    </Modals>
</CrudPageTemplate>