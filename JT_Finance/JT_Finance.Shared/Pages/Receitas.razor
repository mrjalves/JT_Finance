@page "/receitas"
@using JT_Aplicacao
@using JT_Classes
@using JT_Classes.Financeiro
@using JT_Finance.Shared.Components.Grids
@using JT_Finance.Shared.Components.Modais
@using JT_Finance.Shared.Services
@using JT_Finance.Shared.Services.Interfaces
@using JT_UserInterface.Shared.Services.Interfaces
@inject IReceitaService ReceitaService
@implements IDisposable 
@inject FiltroService FiltroService
@inject IJSRuntime JSRuntime
@using JT_UserInterface.Shared.Components.Core
@using JT_UserInterface.Shared.Templates

<CrudPageTemplate PageTitle="Receitas" PageIcon="bi-graph-up-arrow">
    <PageDescription>Acompanhe todas as suas receitas e ganhos.</PageDescription>
    <ToolbarLeft>
        <button class="btn btn-primary" title="Nova Receita @NovoHotkeySufixo" aria-label="Nova Receita @NovoHotkeySufixo" @onclick="AbrirModalParaNovaReceita">
            <i class="bi bi-plus-circle-fill me-1"></i>
            <span class="d-none d-sm-inline">Nova Receita</span>
        </button>
    </ToolbarLeft>
    <ToolbarRight>
    </ToolbarRight>
    <ChildContent>
        <GridReceitas
            PageSize="_pageSize"
            Receitas="listaReceitas"
            IsLoading="isLoading"
            OnEditar="AbrirModalParaEditarReceita"
            OnRemover="ConfirmarRemocaoReceita"
            OnDuplicar="DuplicarReceita" />
    </ChildContent>
    <Modals>
        <ModalReceita @ref="modalReceita"
                      Receita="receitaAtual"
                      OnClose="ResetarEstadoAposModal"
                      OnCancel="HandleCancelarFormularioModal" />

        <ConfirmDialog @ref="confirmDeleteDialog" OnConfirm="EfetuarRemocaoReceita" />
    </Modals>
</CrudPageTemplate>

@code {
    [CascadingParameter]
    public Func<string, Task>? SetPageTitleAsync { get; set; }
    private List<Receita> listaReceitas;
    private Receita receitaAtual;
    private bool isLoading = true;
    private ModalReceita modalReceita;
    private ConfirmDialog confirmDeleteDialog;
    private int? idReceitaParaRemover;
    
    [Inject] public JT_Classes.Acessos.CurrentUserState UserState { get; set; } = default!;
    [Inject] public JT_Servicos.Comum.ConfiguracaoService ConfiguracaoService { get; set; } = default!;
    [Inject] public JT_UserInterface.Shared.Services.Comum.HotkeysDisplayService HotkeysDisplay { get; set; } = default!;
    private int _pageSize = 10;

    public string NovoHotkeySufixo => HotkeysDisplay.ComSufixo("novo");

    private DotNetObjectReference<Receitas>? _novoHotkeysRef;

    protected override async Task OnInitializedAsync()
    {
        await HotkeysDisplay.InicializarAsync();

        if (SetPageTitleAsync != null)
        {
            await SetPageTitleAsync.Invoke("Receitas");
        }
        
        var config = await ConfiguracaoService.GetByUsuarioIdAsync(UserState.UsuarioID);
        if (config != null && config.ItensPorPagina > 0)
        {
            _pageSize = config.ItensPorPagina;
        }

        ReceitaService.OnDataChanged += AtualizarDadosDaPagina;
        // CategoriaService.OnDataChanged += AtualizarDadosDaPagina;
        
        await CarregarDependencias();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try { await JSRuntime.InvokeVoidAsync("JTHotkeys.enableFilterHotkeys"); } catch { }
            try { await JSRuntime.InvokeVoidAsync("JTHotkeys.enableSearchHotkeys"); } catch { }
            try
            {
                _novoHotkeysRef = DotNetObjectReference.Create(this);
                await JSRuntime.InvokeVoidAsync("JTHotkeys.enableNewHotkeys", _novoHotkeysRef);
            }
            catch { }
        }
    }

    [JSInvokable]
    public async Task OnNovoHotkey()
    {
        await InvokeAsync(() =>
        {
            AbrirModalParaNovaReceita();
            StateHasChanged();
        });
    }

    [JSInvokable]
    public async Task HandleAcaoHotkey(string acao)
    {
        await InvokeAsync(async () =>
        {
            switch (acao)
            {
                case "novo":
                    AbrirModalParaNovaReceita();
                    break;
                case "editar":
                    if (listaReceitas != null && listaReceitas.Count > 0)
                    {
                        AbrirModalParaEditarReceita(listaReceitas[0]);
                    }
                    break;
                case "deletar":
                    if (listaReceitas != null && listaReceitas.Count > 0)
                    {
                        ConfirmarRemocaoReceita(listaReceitas[0].Id);
                    }
                    break;
                case "salvar":
                    if (receitaAtual != null)
                    {
                        await modalReceita.Submit();
                    }
                    break;
                case "cancelar":
                    if (receitaAtual != null)
                    {
                        await HandleCancelarFormularioModal();
                    }
                    break;
            }
            StateHasChanged();
        });
    }

    private async void AtualizarDadosDaPagina()
    {
        await InvokeAsync(async () =>
        {
            await CarregarDependencias();
            StateHasChanged();
        });
    }

    private async Task CarregarDependencias()
    {
        isLoading = true;
        await Task.WhenAll(CarregarReceitas());
        isLoading = false;
    }

    private async Task CarregarReceitas()
    {
        listaReceitas = await ReceitaService.ObterTodasReceitasAsync();
    }

    private void AbrirModalParaNovaReceita()
    {
        receitaAtual = new Receita();
        modalReceita.Title = "Adicionar Nova Receita";
        modalReceita.Open();
    }

    private void AbrirModalParaEditarReceita(Receita receitaParaEditar)
    {
        receitaAtual = receitaParaEditar;
        receitaAtual.Status = StatusObjeto.EmEdicao;
        modalReceita.Title = "Editar Receita";
        modalReceita.Open();
    }

    private async Task EfetuarRemocaoReceita()
    {
        if (idReceitaParaRemover.HasValue)
        {
            await ReceitaService.RemoverReceitaAsync(idReceitaParaRemover.Value);
            idReceitaParaRemover = null;
        }
    }

    private async Task DuplicarReceita(Receita receita)
    {
        await ReceitaService.DuplicarReceitaAsync(receita);
    }
    
    public void Dispose()
    {
        ReceitaService.OnDataChanged -= AtualizarDadosDaPagina;
        // CategoriaService.OnDataChanged -= AtualizarDadosDaPagina;
        try { _ = JSRuntime.InvokeVoidAsync("JTHotkeys.disableFilterHotkeys"); } catch { }
        try { _ = JSRuntime.InvokeVoidAsync("JTHotkeys.disableSearchHotkeys"); } catch { }
        try { _ = JSRuntime.InvokeVoidAsync("JTHotkeys.disableNewHotkeys"); } catch { }
        _novoHotkeysRef?.Dispose();
    }

    private async Task HandleCancelarFormularioModal()
    {
        await modalReceita.Close();
    }

    private void ResetarEstadoAposModal()
    {
        receitaAtual = null;
    }

    private void ConfirmarRemocaoReceita(int id)
    {
        idReceitaParaRemover = id;
        confirmDeleteDialog.Show("Confirmar Remoção", "Deseja realmente remover esta receita?");
    }
}


