@page "/receitas"
@using JT_Finance.Shared.Components
@using JT_Finance.Shared.Services
@using System.ComponentModel.DataAnnotations
@using static JT_Finance.Shared.Components.Modal
@inject ToastService ToastService

<button class="btn btn-primary mb-3 shadow-sm" @onclick="AbrirModalParaNovaReceita">
    <i class="bi bi-plus-circle-fill me-2"></i>Nova Receita
</button>

<DataGrid TItem="ReceitaModel" Items="listaReceitas" IsLoading="isLoading">
    <HeaderTemplate>
        <th>Descrição</th>
        <th>Valor</th>
        <th>Data</th>
        <th>Fonte</th>
        <th class="text-end">Ações</th>
    </HeaderTemplate>
    <RowTemplate Context="receita">
        <td>@receita.Descricao</td>
        <td>@receita.Valor.ToString("C")</td>
        <td>@receita.Data.ToShortDateString()</td>
        <td>@receita.Fonte</td>
        <td class="text-end">
            <button class="btn btn-sm btn-outline-primary" @onclick="() => AbrirModalParaEditarReceita(receita)">Editar</button>
            <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmarRemocaoReceita(receita.Id)">Remover</button>
        </td>
    </RowTemplate>
    <EmptyTemplate>
        <p class="text-muted mb-0">Nenhuma receita cadastrada ainda. Clique em "Nova Receita" para começar.</p>
    </EmptyTemplate>
</DataGrid>

<Modal @ref="crudModal" Title="@modalTitle" OnClose="ResetarEstadoAposModal">
    <BodyContent>
        @if (receitaAtual != null)
        {
            <EditForm Model="receitaAtual" OnValidSubmit="HandleSalvarReceita">
                <DataAnnotationsValidator />

                <div class="mb-3">
                    <label for="descricao" class="form-label">Descrição</label>
                    <InputText id="descricao" class="form-control" @bind-Value="receitaAtual.Descricao" />
                    <ValidationMessage For="@(() => receitaAtual.Descricao)" />
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label for="valor" class="form-label">Valor</label>
                        <InputNumber id="valor" class="form-control" @bind-Value="receitaAtual.Valor" />
                        <ValidationMessage For="@(() => receitaAtual.Valor)" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label for="data" class="form-label">Data</label>
                        <InputDate id="data" class="form-control" @bind-Value="receitaAtual.Data" />
                        <ValidationMessage For="@(() => receitaAtual.Data)" />
                    </div>
                </div>

                <div class="mb-3">
                    <label for="fonte" class="form-label">Fonte</label>
                    <InputText id="fonte" class="form-control" @bind-Value="receitaAtual.Fonte" />
                    <ValidationMessage For="@(() => receitaAtual.Fonte)" />
                </div>

                <hr />

                <div class="d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-secondary" @onclick="HandleCancelarFormularioModal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Salvar</button>
                </div>
            </EditForm>
        }
        else
        {
            <p>Carregando formulário...</p>
        }
    </BodyContent>
</Modal>

<ConfirmDialog @ref="confirmDeleteDialog" OnConfirm="EfetuarRemocaoReceita" />

@code {
    [CascadingParameter]
    public Func<string, Task>? SetPageTitleAsync { get; set; }

    private List<ReceitaModel> listaReceitas = new();
    private ReceitaModel? receitaAtual;
    private bool isLoading = true;

    private Modal crudModal = new();
    private string modalTitle = "";

    private ConfirmDialog confirmDeleteDialog = new();
    private Guid? idReceitaParaRemover;

    protected override async Task OnInitializedAsync()
    {
        if (SetPageTitleAsync != null)
        {
            await SetPageTitleAsync.Invoke("Receitas");
        }

        // Simula carregamento de dados do "banco"
        isLoading = true;
        await Task.Delay(250);
        CarregarDadosIniciais();
        isLoading = false;
    }

    private void CarregarDadosIniciais()
    {
        listaReceitas = new List<ReceitaModel>
        {
            new() { Id = Guid.NewGuid(), Descricao = "Salário Mensal", Valor = 7500.00M, Data = new DateTime(DateTime.Now.Year, DateTime.Now.Month, 5), Fonte = "Empresa ABC" },
            new() { Id = Guid.NewGuid(), Descricao = "Venda de Produto Online", Valor = 350.50M, Data = DateTime.Now.AddDays(-10), Fonte = "Marketplace" },
            new() { Id = Guid.NewGuid(), Descricao = "Reembolso de Despesa", Valor = 120.00M, Data = DateTime.Now.AddDays(-5), Fonte = "Adiantamento" }
        };
    }

    private void AbrirModalParaNovaReceita()
    {
        receitaAtual = new ReceitaModel(); // Cria uma nova instância
        modalTitle = "Adicionar Nova Receita";
        crudModal.Open();
    }

    private void AbrirModalParaEditarReceita(ReceitaModel receitaParaEditar)
    {
        // Cria uma cópia para edição segura
        receitaAtual = new ReceitaModel
        {
            Id = receitaParaEditar.Id,
            Descricao = receitaParaEditar.Descricao,
            Valor = receitaParaEditar.Valor,
            Data = receitaParaEditar.Data,
            Fonte = receitaParaEditar.Fonte
        };
        modalTitle = "Editar Receita";
        crudModal.Open();
    }

    private async Task HandleSalvarReceita()
    {
        if (receitaAtual == null) return;

        bool isNew = receitaAtual.Id == Guid.Empty;
        if (isNew)
        {
            receitaAtual.Id = Guid.NewGuid();
            listaReceitas.Add(receitaAtual);
            ToastService.ShowSuccess("Sucesso!", "Nova receita adicionada.");
        }
        else
        {
            var index = listaReceitas.FindIndex(r => r.Id == receitaAtual.Id);
            if (index != -1)
            {
                listaReceitas[index] = receitaAtual;
                ToastService.ShowSuccess("Sucesso!", "Receita atualizada.");
            }
        }
        await crudModal.Close();
    }

    private async Task HandleCancelarFormularioModal()
    {
        await crudModal.Close();
    }

    private void ResetarEstadoAposModal()
    {
        receitaAtual = null;
        modalTitle = "";
    }

    private async Task ConfirmarRemocaoReceita(Guid id)
    {
        idReceitaParaRemover = id;
        await confirmDeleteDialog.Show("Confirmar Remoção", "Deseja realmente remover esta receita?");
    }

    private void EfetuarRemocaoReceita()
    {
        if (idReceitaParaRemover.HasValue)
        {
            listaReceitas.RemoveAll(r => r.Id == idReceitaParaRemover.Value);
            ToastService.ShowSuccess("Removida!", "A receita foi removida.");
            idReceitaParaRemover = null;
        }
    }
    public class ReceitaModel
    {
        public Guid Id { get; set; }

        [Required(ErrorMessage = "A descrição é obrigatória.")]
        [StringLength(100, ErrorMessage = "A descrição não pode ter mais de 100 caracteres.")]
        public string Descricao { get; set; } = string.Empty;

        [Required(ErrorMessage = "O valor é obrigatório.")]
        [Range(0.01, double.MaxValue, ErrorMessage = "O valor deve ser maior que zero.")]
        public decimal Valor { get; set; }

        [Required(ErrorMessage = "A data é obrigatória.")]
        public DateTime Data { get; set; } = DateTime.Now;

        [StringLength(50, ErrorMessage = "A fonte não pode ter mais de 50 caracteres.")]
        public string? Fonte { get; set; }
    }
}