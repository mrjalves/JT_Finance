@page "/receitas"
@using JT_Finance.Shared.Components
@using System.ComponentModel.DataAnnotations
@using System.Linq.Expressions 
@using JT_Finance.Shared.Services 
@using static JT_Finance.Shared.Components.Modal

@inject ToastService ToastService 

<h3>Receitas</h3>

<button class="btn btn-primary mb-3" @onclick="AbrirModalParaNovaReceita">Nova Receita</button>

<DataGrid TItem="ReceitaModel" Items="listaReceitas">
    <HeaderTemplate>
        <th>Descrição</th>
        <th>Valor</th>
        <th>Data</th>
        <th>Fonte</th>
        <th>Ações</th>
    </HeaderTemplate>
    <RowTemplate Context="receita">
        <td>@receita.Descricao</td>
        <td>@receita.Valor.ToString("C")</td>
        <td>@receita.Data.ToShortDateString()</td>
        <td>@receita.Fonte</td>
        <td>
            <button class="btn btn-sm btn-info" @onclick="() => AbrirModalParaEditarReceita(receita)">Editar</button>
            <button class="btn btn-sm btn-danger" @onclick="() => ConfirmarRemocaoReceita(receita.Id)">Remover</button>
        </td>
    </RowTemplate>
</DataGrid>

<Modal @ref="crudModal" Title="@modalTitle" OnClose="ResetarEstadoAposModal" Size="ModalSize.Large">
    <BodyContent>
        @if (receitaAtual != null)
        {
            <CrudForm TItem="ReceitaModel" Item="receitaAtual" OnSubmit="HandleSalvarReceita" OnCancel="HandleCancelarFormularioModal">
                <ChildContent Context="receitaContext">
                    <CustomInput Label="Descrição" @bind-Value="receitaContext.Descricao" />
                    <CustomInput Label="Valor" Type="number" @bind-Value="receitaContext.ValorAsString" />
                    <div class="form-group mb-3">
                        <label for="data_receita">Data</label>
                        <InputDate id="data_receita" class="form-control" @bind-Value="receitaContext.Data" />
                        <ValidationMessage For="@(() => receitaContext.Data)" />
                    </div>
                    <CustomInput Label="Fonte" @bind-Value="receitaContext.Fonte" />
                </ChildContent>
            </CrudForm>
        }
        else
        {
            <p>Carregando formulário...</p>
        }
    </BodyContent>
</Modal>

<ConfirmDialog @ref="confirmDeleteDialog" OnConfirm="EfetuarRemocaoReceita" />

@code {
    private List<ReceitaModel> listaReceitas = new List<ReceitaModel>();
    private ReceitaModel receitaAtual = null; // Inicializa como null

    private Modal crudModal; // Referência para o componente Modal para Adicionar/Editar
    private string modalTitle = "";

    private ConfirmDialog confirmDeleteDialog; // Referência para o modal de confirmação de remoção
    private Guid? idReceitaParaRemover; // Nullable Guid para armazenar o ID

    protected override void OnInitialized()
    {
        // Dados de exemplo
        listaReceitas.Add(new ReceitaModel { Id = Guid.NewGuid(), Descricao = "Salário", Valor = 5000.00M, Data = DateTime.Now.AddDays(-15), Fonte = "Empresa X" });
        listaReceitas.Add(new ReceitaModel { Id = Guid.NewGuid(), Descricao = "Freelance", Valor = 850.00M, Data = DateTime.Now.AddDays(-3), Fonte = "Cliente Y" });
        // TODO: Carregar dados reais de um serviço
    }

    private void AbrirModalParaNovaReceita()
    {
        receitaAtual = new ReceitaModel { Data = DateTime.Now };
        modalTitle = "Nova Receita";
        StateHasChanged();
        crudModal.Open();
    }

    private void AbrirModalParaEditarReceita(ReceitaModel receitaParaEditar)
    {
        receitaAtual = new ReceitaModel
        {
            Id = receitaParaEditar.Id,
            Descricao = receitaParaEditar.Descricao,
            Valor = receitaParaEditar.Valor,
            ValorAsString = receitaParaEditar.ValorAsString, // Copiar a string também
            Data = receitaParaEditar.Data,
            Fonte = receitaParaEditar.Fonte
        };
        modalTitle = "Editar Receita";
        StateHasChanged();
        crudModal.Open();
    }

    private async Task HandleSalvarReceita(ReceitaModel receita)
    {
        bool isNew = receita.Id == Guid.Empty;
        if (isNew)
        {
            receita.Id = Guid.NewGuid();
            listaReceitas.Add(receita); // TODO: Salvar via serviço
            ToastService.ShowSuccess("Sucesso!", "Nova receita adicionada.");
        }
        else
        {
            var index = listaReceitas.FindIndex(r => r.Id == receita.Id);
            if (index != -1)
            {
                listaReceitas[index] = receita; // TODO: Atualizar via serviço
                ToastService.ShowSuccess("Sucesso!", "Receita atualizada.");
            }
            else
            {
                ToastService.ShowError("Erro!", "Receita não encontrada para atualização.");
            }
        }
        await crudModal.Close();
    }

    private async Task HandleCancelarFormularioModal()
    {
        await crudModal.Close();
    }

    private void ResetarEstadoAposModal()
    {
        receitaAtual = null;
        modalTitle = "";
        StateHasChanged();
    }

    private async Task ConfirmarRemocaoReceita(Guid id)
    {
        idReceitaParaRemover = id;
        await confirmDeleteDialog.Show(
            title: "Confirmar Remoção",
            message: "Tem certeza que deseja remover esta receita? Esta ação não pode ser desfeita.",
            confirmText: "Sim, Remover",
            cancelText: "Cancelar",
            confirmClass: "btn-danger"
        );
    }

    private void EfetuarRemocaoReceita()
    {
        if (idReceitaParaRemover.HasValue)
        {
            var receitaParaRemover = listaReceitas.FirstOrDefault(r => r.Id == idReceitaParaRemover.Value);
            if (receitaParaRemover != null)
            {
                listaReceitas.Remove(receitaParaRemover); // TODO: Remover via serviço
                ToastService.ShowSuccess("Removida!", $"Receita \"{receitaParaRemover.Descricao}\" foi removida.");
                StateHasChanged();
            }
            else
            {
                ToastService.ShowError("Erro!", "Receita não encontrada para remoção.");
            }
            idReceitaParaRemover = null;
        }
    }

    public class ReceitaModel
    {
        public Guid Id { get; set; }

        [Required(ErrorMessage = "A descrição é obrigatória.")]
        [StringLength(100, ErrorMessage = "A descrição deve ter no máximo 100 caracteres.")]
        public string Descricao { get; set; }

        [Required(ErrorMessage = "O valor é obrigatório.")]
        [Range(0.01, double.MaxValue, ErrorMessage = "O valor deve ser maior que zero.")]
        public decimal Valor { get; set; }

        public string ValorAsString
        {
            get => Valor.ToString(System.Globalization.CultureInfo.InvariantCulture);
            set
            {
                if (decimal.TryParse(value, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var decimalValue))
                {
                    Valor = decimalValue;
                }
            }
        }

        [Required(ErrorMessage = "A data é obrigatória.")]
        public DateTime Data { get; set; } = DateTime.Now;

        [StringLength(50, ErrorMessage = "A fonte deve ter no máximo 50 caracteres.")]
        public string Fonte { get; set; }
    }
}
