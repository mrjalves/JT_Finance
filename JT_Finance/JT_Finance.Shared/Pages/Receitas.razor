@page "/receitas"
@using JT_Classes
@using JT_Classes.Financeiro
@using JT_Finance.Shared.Components.Grids
@using JT_Finance.Shared.Components.Modais
@using JT_Finance.Shared.Services
@using JT_Finance.Shared.Services.Interfaces
@inject IReceitaService ReceitaService
@inject ICategoriaService CategoriaService
@implements IDisposable // Passo 1: Implementar IDisposable

<button class="btn btn-primary mb-3 shadow-sm" @onclick="AbrirModalParaNovaReceita">
    <i class="bi bi-plus-circle-fill me-2"></i>Nova Receita
</button>

<GridReceitas
    Receitas="listaReceitas"
    opcoesCategoriaReceita="opcoesCategoriaReceita"
              opcoesTipoReceita=" opcoesTipoReceita"
    IsLoading="isLoading"
    OnEditar="AbrirModalParaEditarReceita"
    OnRemover="ConfirmarRemocaoReceita"
    OnDuplicar="DuplicarReceita" />

<ModalReceita @ref="modalReceita"
              Receita="receitaAtual"
              OnClose="ResetarEstadoAposModal"
              OnCancel="HandleCancelarFormularioModal" />

<ConfirmDialog @ref="confirmDeleteDialog" OnConfirm="EfetuarRemocaoReceita" />

@code {
    [CascadingParameter]
    public Func<string, Task>? SetPageTitleAsync { get; set; }
    private List<Receita> listaReceitas;
    private List<Categoria> opcoesCategoriaReceita;
    private List<Categoria> opcoesTipoReceita;
    private Receita receitaAtual;
    private bool isLoading = true;
    private ModalReceita modalReceita;
    private ConfirmDialog confirmDeleteDialog;
    private int? idReceitaParaRemover;

    protected override async Task OnInitializedAsync()
    {
        if (SetPageTitleAsync != null)
        {
            await SetPageTitleAsync.Invoke("Receitas");
        }
        ReceitaService.OnDataChanged += AtualizarDadosDaPagina;
        CategoriaService.OnDataChanged += AtualizarDadosDaPagina;
        
        await CarregarDependencias();
    }

    private async void AtualizarDadosDaPagina()
    {
        await InvokeAsync(async () =>
        {
            await CarregarDependencias();
            StateHasChanged();
        });
    }

    private async Task CarregarDependencias()
    {
        isLoading = true;
        await Task.WhenAll(CarregarReceitas(), CarregarOpcoesDeCategoria());
        isLoading = false;
    }

    private async Task CarregarReceitas()
    {
        listaReceitas = await ReceitaService.ObterTodasReceitasAsync();
    }

    private async Task CarregarOpcoesDeCategoria()
    {
        opcoesCategoriaReceita = await CategoriaService.GetCategoriasReceitas();
        opcoesTipoReceita = await CategoriaService.GetTipoCategoriasReceitas();
    }

    private void AbrirModalParaNovaReceita()
    {
        receitaAtual = new Receita(JT_Persistencia.Persistencia.StatusObjeto.Novo);
        modalReceita.Title = "Adicionar Nova Receita";
        modalReceita.Open();
    }

    private void AbrirModalParaEditarReceita(Receita receitaParaEditar)
    {
        receitaAtual = receitaParaEditar;
        receitaAtual.Status = JT_Persistencia.Persistencia.StatusObjeto.EmEdicao;
        modalReceita.Title = "Editar Receita";
        modalReceita.Open();
    }

    private async Task EfetuarRemocaoReceita()
    {
        if (idReceitaParaRemover.HasValue)
        {
            await ReceitaService.RemoverReceitaAsync(idReceitaParaRemover.Value);
            idReceitaParaRemover = null;
        }
    }

    private async Task DuplicarReceita(Receita receita)
    {
        await ReceitaService.DuplicarReceitaAsync(receita.Id);
    }
    
    public void Dispose()
    {
        ReceitaService.OnDataChanged -= AtualizarDadosDaPagina;
        CategoriaService.OnDataChanged -= AtualizarDadosDaPagina;
    }

    private async Task HandleCancelarFormularioModal()
    {
        await modalReceita.Close();
    }

    private void ResetarEstadoAposModal()
    {
        receitaAtual = null;
    }

    private void ConfirmarRemocaoReceita(int id)
    {
        idReceitaParaRemover = id;
        confirmDeleteDialog.Show("Confirmar Remoção", "Deseja realmente remover esta receita?");
    }
}
