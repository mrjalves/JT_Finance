@page "/historico"
@using JT_Finance.Shared.Components

<PageTitle>Histórico Financeiro</PageTitle>

<Calendario />

@code {
    [CascadingParameter]
    public Func<string, Task>? SetPageTitleAsync { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (SetPageTitleAsync != null)
        {
            await SetPageTitleAsync.Invoke("Hitórico");
        }
    }
}