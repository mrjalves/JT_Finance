@page "/cartoes-credito"
@using JT_Classes.Financeiro
@using JT_Finance.Shared.Components
@using JT_Finance.Shared.Services
@using static JT_Finance.Shared.Components.Modal
@inject ToastService ToastService

<h3 class="mb-3">Gerenciador de Cartões de Crédito</h3>

<button class="btn btn-primary mb-3 shadow-sm" @onclick="AbrirModalParaNovoCartao">
    <i class="bi bi-plus-circle-fill me-2"></i>Novo Cartão
</button>

<DataGrid TItem="CartaoCredito" Items="listaCartoes" IsLoading="isLoading">
    <HeaderTemplate>
        <th>Nome</th>
        <th>Limite</th>
        <th>Vencimento</th>
        <th>Fechamento</th>
        <th>Status</th>
        <th class="text-end">Ações</th>
    </HeaderTemplate>
    <RowTemplate Context="cartao">
        <td>@cartao.Nome</td>
        <td>@cartao.Limite.ToString("C")</td>
        <td>Dia @cartao.DiaVencimento</td>
        <td>Dia @cartao.DiaFechamento</td>
        <td>
            @if (cartao.Ativo)
            {
                <span class="badge bg-success">Ativo</span>
            }
            else
            {
                <span class="badge bg-secondary">Inativo</span>
            }
        </td>
        <td class="text-end">
            <button class="btn btn-sm btn-outline-primary" @onclick="() => AbrirModalParaEditarCartao(cartao.Id)">
                <i class="bi bi-pencil-fill me-1"></i>Editar
            </button>
            <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmarRemocaoCartao(cartao.Id)">
                <i class="bi bi-trash-fill me-1"></i>Remover
            </button>
        </td>
    </RowTemplate>
    <EmptyTemplate>
        <p class="text-muted mb-0">Nenhum cartão de crédito cadastrado. Clique em "Novo Cartão" para começar.</p>
    </EmptyTemplate>
</DataGrid>

<Modal @ref="crudModal" Title="@modalTitle" OnClose="ResetarEstadoAposModal" Size="ModalSize.Large">
    <BodyContent>
        @if (cartaoAtual != null)
        {
            <EditForm Model="cartaoAtual" OnValidSubmit="() => HandleSalvarCartao(cartaoAtual)">
                <DataAnnotationsValidator />

                <div class="row">
                    <div class="col-md-12 mb-3">
                        <label for="nome" class="form-label">Nome do Cartão (Ex: Nubank, Inter Gold)</label>
                        <InputText id="nome" class="form-control" @bind-Value="cartaoAtual.Nome" />
                        <ValidationMessage For="@(() => cartaoAtual.Nome)" />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label for="limite" class="form-label">Limite de Crédito</label>
                        <InputNumber id="limite" class="form-control" @bind-Value="cartaoAtual.Limite" />
                        <ValidationMessage For="@(() => cartaoAtual.Limite)" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label for="dia_fechamento" class="form-label">Dia do Fechamento</label>
                        <InputNumber id="dia_fechamento" class="form-control" @bind-Value="cartaoAtual.DiaFechamento" />
                        <ValidationMessage For="@(() => cartaoAtual.DiaFechamento)" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label for="dia_vencimento" class="form-label">Dia do Vencimento</label>
                        <InputNumber id="dia_vencimento" class="form-control" @bind-Value="cartaoAtual.DiaVencimento" />
                        <ValidationMessage For="@(() => cartaoAtual.DiaVencimento)" />
                    </div>
                </div>

                <div class="form-check form-switch mb-3">
                    <InputCheckbox id="ativo" class="form-check-input" @bind-Value="cartaoAtual.Ativo" />
                    <label class="form-check-label" for="ativo">Cartão Ativo</label>
                </div>

                <hr />

                <div class="d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-secondary" @onclick="HandleCancelarFormularioModal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Salvar</button>
                </div>
            </EditForm>
        }
    </BodyContent>
</Modal>

<ConfirmDialog @ref="confirmDeleteDialog" OnConfirm="EfetuarRemocaoCartao" />

@code {
    private List<CartaoCredito>? listaCartoes;
    private CartaoCredito? cartaoAtual;
    private bool isLoading = true;

    private Modal crudModal = new();
    private string modalTitle = "";

    private ConfirmDialog confirmDeleteDialog = new();
    private int? idCartaoParaRemover;

    protected override async Task OnInitializedAsync()
    {
        await CarregarCartoes();
    }

    private async Task CarregarCartoes()
    {
        isLoading = true;
        await Task.Yield();

        // Sua lógica de acesso a dados
        listaCartoes = new CartaoCredito().Consultar<CartaoCredito>("SELECT * FROM CartoesCredito ORDER BY Nome");

        isLoading = false;
    }

    private void AbrirModalParaNovoCartao()
    {
        cartaoAtual = new CartaoCredito();
        modalTitle = "Novo Cartão de Crédito";
        crudModal.Open();
    }

    private void AbrirModalParaEditarCartao(int id)
    {
        cartaoAtual = listaCartoes?.FirstOrDefault(c => c.Id == id);
        if (cartaoAtual != null)
        {
            modalTitle = "Editar Cartão de Crédito";
            crudModal.Open();
        }
    }

    private async Task HandleSalvarCartao(CartaoCredito cartao)
    {
        bool sucesso;
        if (cartao.Id == 0)
        {
            cartao.Id = cartao.GetNextId<CartaoCredito>();
            sucesso = cartao.Salvar(cartao);
            ToastService.ShowSuccess("Sucesso!", "Novo cartão salvo.");
        }
        else
        {
            sucesso = cartao.Atualizar(cartao);
            ToastService.ShowSuccess("Sucesso!", "Cartão atualizado.");
        }

        if (!sucesso)
        {
            ToastService.ShowError("Erro!", "Ocorreu um problema ao salvar o cartão.");
        }

        await crudModal.Close();
        await CarregarCartoes();
    }

    private async Task EfetuarRemocaoCartao()
    {
        if (idCartaoParaRemover.HasValue)
        {
            var cartaoParaRemover = new CartaoCredito { Id = idCartaoParaRemover.Value };
            var sucesso = cartaoParaRemover.Excluir(cartaoParaRemover);
            if (sucesso)
            {
                ToastService.ShowSuccess("Removido!", "O cartão foi removido.");
            }
            else
            {
                ToastService.ShowError("Erro!", "Não foi possível remover o cartão. Verifique se ele não está em uso.");
            }
            idCartaoParaRemover = null;
            await CarregarCartoes();
        }
    }

    private async Task HandleCancelarFormularioModal()
    {
        await crudModal.Close();
    }

    private void ResetarEstadoAposModal()
    {
        cartaoAtual = null;
        modalTitle = "";
    }

    private async Task ConfirmarRemocaoCartao(int id)
    {
        idCartaoParaRemover = id;
        await confirmDeleteDialog.Show("Confirmar Remoção", "Deseja realmente remover este cartão?");
    }
}