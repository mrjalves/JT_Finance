@page "/cartoes-credito"
@using JT_Aplicacao
@using JT_Classes.Financeiro
@using JT_Classes.structs
@using JT_Finance.Shared.Components
@using JT_Finance.Shared.Components.Modais
@using JT_Finance.Shared.Services
@using JT_Finance.Shared.Services.Interfaces
@using Microsoft.JSInterop
@inject ICartaoCreditoService CartaoService
@inject FiltroService FiltroService
@inject IJSRuntime JSRuntime
@implements IDisposable

<div class="card shadow-sm mb-2">
    <div class="card-body d-flex justify-content-between align-items-center">
        <div class="d-flex align-items-center">
            <button class="btn btn-primary" title="Novo Cartão (Alt+N)" aria-label="Novo Cartão (Alt+N)" @onclick="AbrirModalParaNovoCartao">
                <i class="bi bi-plus-circle-fill me-2"></i>Novo Cartão
            </button>
        </div>
       @*  <div class="d-flex align-items-center gap-2">
            <SearchFilter />
            <button class="btn btn-outline-primary" @onclick="FiltroService.ToggleFiltros">
                <i class="bi bi-filter action-icon" title="Filtrar" />
            </button>
        </div> *@
    </div>
</div>


<JT_Finance.Shared.Components.Grids.GridCartoesCredito
    Cartoes="listaCartoes"
    IsLoading="isLoading"
    OnEditar="AbrirModalParaEditarCartao"
    OnRemover="ConfirmarRemocaoCartao"
/>


<JT_Finance.Shared.Components.Modais.ModalCartaoCredito
    @ref="modalCartao"
    Cartao="cartaoAtual"
    OnClose="ResetarEstadoAposModal" 
    OnCancel="HandleCancelarFormularioModal"
/>

<ConfirmDialog @ref="confirmDeleteDialog" OnConfirm="EfetuarRemocaoCartao" />

@code {
    [CascadingParameter]
    public Func<string, Task>? SetPageTitleAsync { get; set; }

    private List<sCartao> listaCartoes = new();
    private CartaoCredito cartaoAtual;
    private bool isLoading = true;

    private ModalCartaoCredito modalCartao = new();

    private ConfirmDialog confirmDeleteDialog = new();
    private int? idCartaoParaRemover;

    private DotNetObjectReference<CartoesCredito>? _novoHotkeysRef;

    protected override async Task OnInitializedAsync()
    {
        if (SetPageTitleAsync != null)
        {
            await SetPageTitleAsync.Invoke("Cartões Crédito");
        }
        CartaoService.OnDataChanged += AtualizarDadosDaPagina;
        await CarregarCartoes();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                _novoHotkeysRef = DotNetObjectReference.Create(this);
                await JSRuntime.InvokeVoidAsync("JTHotkeys.enableNewHotkeys", _novoHotkeysRef);
            }
            catch { }
        }
    }

    [JSInvokable]
    public async Task OnNovoHotkey()
    {
        await InvokeAsync(() =>
        {
            AbrirModalParaNovoCartao();
            StateHasChanged();
        });
    }

    private async void AtualizarDadosDaPagina()
    {
        await InvokeAsync(async () =>
        {
            await CarregarCartoes();
            StateHasChanged();
        });
    }
    private async Task CarregarCartoes()
    {
        isLoading = true;
        listaCartoes = await CartaoService.ObterTodosCartoesAsync();
        isLoading = false;
    }

    private void AbrirModalParaNovoCartao()
    {
        cartaoAtual = new CartaoCredito();
        modalCartao.Title = "Novo Cartão de Crédito";
        modalCartao.Open();
    }

    private void AbrirModalParaEditarCartao(int id)
    {
        var item = listaCartoes.FirstOrDefault(c => c.Id == id);
        cartaoAtual = sCartao.ToEntity(item);
        cartaoAtual.Status = StatusObjeto.EmEdicao;
        modalCartao.Title = "Editar Cartão de Crédito";
        modalCartao.Open();
    }

    private async Task EfetuarRemocaoCartao()
    {
        if (idCartaoParaRemover.HasValue)
        {
            await CartaoService.RemoverCartaoAsync(idCartaoParaRemover.Value);
            idCartaoParaRemover = null;
        }
    }
    private async Task ConfirmarRemocaoCartao(int id)
    {
        idCartaoParaRemover = id;
        confirmDeleteDialog.Show("Confirmar Remoção", "Deseja realmente remover este cartão?");
    }

    private async Task HandleCancelarFormularioModal()
    {
        await modalCartao.Close();
    }

    private void ResetarEstadoAposModal()
    {
        cartaoAtual = null;
    }
    public void Dispose()
    {
        CartaoService.OnDataChanged -= AtualizarDadosDaPagina;
        try { _ = JSRuntime.InvokeVoidAsync("JTHotkeys.disableNewHotkeys"); } catch { }
        _novoHotkeysRef?.Dispose();
    }
}