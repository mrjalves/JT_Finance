@page "/settings"
@using Microsoft.AspNetCore.Components.Forms

<h3>Configurações</h3>

<div class="settings-container mt-4">
    <section class="setting-section">
        <h4>Tema da Aplicação</h4>
        <p>Personalize a aparência da aplicação.</p>
        <div class="theme-options">
            <EditForm Model="currentThemeSettings">
                <div class="mb-3">
                    <label for="themeSelector" class="form-label">Escolha o tema:</label>
                    <InputSelect id="themeSelector" class="form-select" @bind-Value="currentThemeSettings.SelectedTheme">
                        <option value="light">Claro</option>
                        <option value="dark">Escuro</option>
                        <option value="system">Padrão do Sistema</option>
                    </InputSelect>
                </div>
                <button type="button" class="btn btn-primary" @onclick="ApplyThemeSettings">Aplicar Tema</button>
            </EditForm>
        </div>
    </section>

    <hr class="my-4">

    <section class="setting-section">
        <h4>Notificações</h4>
        <p>Gerencie suas preferências de notificação.</p>
        <div class="form-check">
            <InputCheckbox id="emailNotifications" class="form-check-input" @bind-Value="notificationSettings.EnableEmailNotifications" />
            <label class="form-check-label" for="emailNotifications">
                Receber notificações por e-mail
            </label>
        </div>
        <div class="form-check mt-2">
            <InputCheckbox id="pushNotifications" class="form-check-input" @bind-Value="notificationSettings.EnablePushNotifications" />
            <label class="form-check-label" for="pushNotifications">
                Habilitar notificações push (no aplicativo)
            </label>
        </div>
         <button type="button" class="btn btn-primary mt-3" @onclick="SaveNotificationSettings">Salvar Preferências de Notificação</button>
    </section>

    <hr class="my-4">

    <section class="setting-section">
        <h4>Conta</h4>
        <p>Opções relacionadas à sua conta de usuário.</p>
        <div>
            <button class="btn btn-outline-secondary btn-sm" @onclick="ChangePassword">Alterar Senha</button>
            <button class="btn btn-outline-danger btn-sm ms-2" @onclick="DeleteAccount">Excluir Conta</button>
        </div>
    </section>

</div>

@inject JT_Finance.Shared.Services.ThemeService ThemeService
@implements IDisposable

@code {
    private ThemeSettingsModel currentThemeSettings = new ThemeSettingsModel();
    private NotificationSettingsModel notificationSettings = new NotificationSettingsModel();

    protected override async Task OnInitializedAsync()
    {
        // Carrega o tema atual do serviço para preencher o InputSelect
        currentThemeSettings.SelectedTheme = ThemeService.CurrentTheme;
        ThemeService.OnThemeChanged += HandleThemeChangedAppSettings;

        // Simular carregamento de outras configurações salvas
        await Task.Delay(50); // Simula chamada assíncrona
        notificationSettings.EnableEmailNotifications = true; // Exemplo
    }

    private async Task ApplyThemeSettings()
    {
        await ThemeService.SetThemeAsync(currentThemeSettings.SelectedTheme);
        Console.WriteLine($"Configurações de Tema: Tema '{currentThemeSettings.SelectedTheme}' aplicado.");
        // O ThemeService já persiste e notifica outros componentes.
    }

    private void HandleThemeChangedAppSettings()
    {
        // Atualiza o valor no InputSelect se o tema for alterado por outros meios (ex: botão no Header)
        currentThemeSettings.SelectedTheme = ThemeService.CurrentTheme;
        InvokeAsync(StateHasChanged);
    }

    private void SaveNotificationSettings()
    {
        Console.WriteLine($"Salvar Notificações: Email={notificationSettings.EnableEmailNotifications}, Push={notificationSettings.EnablePushNotifications}");
        // Lógica para salvar preferências de notificação (ex: API, localStorage)
    }

    private void ChangePassword()
    {
        Console.WriteLine("Solicitar alteração de senha.");
        // Navegar para uma página de alteração de senha ou abrir modal.
    }

    private void DeleteAccount()
    {
        Console.WriteLine("Solicitar exclusão de conta.");
        // Abrir um modal de confirmação antes de prosseguir.
    }

    public void Dispose()
    {
        ThemeService.OnThemeChanged -= HandleThemeChangedAppSettings;
    }

    // Modelos para as configurações (podem ser movidos para arquivos separados depois)
    public class ThemeSettingsModel
    {
        public string SelectedTheme { get; set; } = "system"; // light, dark, system
    }

    public class NotificationSettingsModel
    {
        public bool EnableEmailNotifications { get; set; }
        public bool EnablePushNotifications { get; set; }
    }
}
