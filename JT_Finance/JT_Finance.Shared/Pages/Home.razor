@page "/"
@page "/home"
@using System.Globalization
@using JT_Classes
@using JT_Classes.Financeiro
@using JT_Classes.structs
@using JT_Finance.Shared.Components
@using JT_Finance.Shared.Services
@using JT_Finance.Shared.Services.Interfaces

@inject JT_UserInterface.Shared.Services.Interfaces.Comum.IFormFactor FormFactor
@inject IDespesaService DespesaService
@inject IReceitaService ReceitaService
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager

<PageTitle>Dashboard Executivo Financeiro</PageTitle>

<div class="container-fluid py-4 dashboard-home">
    <!-- Cabeçalho Executivo com Navegador de Mês Integrado -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3 dashboard-header">
        <div class="d-flex align-items-center gap-3">
            <div class="header-icon-badge shadow-sm">
                <i class="bi bi-wallet2"></i>
            </div>
            <div>
                <h1 class="h4 mb-0 fw-bold">Dashboard Executivo Financeiro</h1>
                <p class="text-muted small mb-0">Gestão consolidada de receitas, despesas, fluxo de caixa e compromissos.</p>
            </div>
        </div>

        <!-- Barra de Ações & Navegação de Mês -->
        <div class="d-flex flex-wrap align-items-center gap-2">
            <div class="month-nav-pill d-flex align-items-center px-2 py-1.5 shadow-sm border rounded-pill">
                <button class="btn btn-sm btn-icon month-nav-btn rounded-circle" @onclick="MudarMesAnterior" title="Mês anterior">
                    <i class="bi bi-chevron-left"></i>
                </button>
                <span class="fw-bold px-3 text-capitalize d-flex align-items-center" style="font-size: 0.92rem; min-width: 160px; justify-content: center;">
                    <i class="bi bi-calendar3 text-primary me-2"></i>
                    @mesReferencia.ToString("MMMM yyyy", new CultureInfo("pt-BR"))
                </span>
                <button class="btn btn-sm btn-icon month-nav-btn rounded-circle" @onclick="MudarMesProximo" title="Próximo mês">
                    <i class="bi bi-chevron-right"></i>
                </button>
            </div>

            @if (!IsMesAtual)
            {
                <button class="btn btn-sm btn-outline-primary rounded-pill px-3 shadow-sm fw-semibold" @onclick="IrParaMesAtualAsync" title="Voltar ao mês corrente">
                    <i class="bi bi-calendar-check me-1"></i>Mês Atual
                </button>
            }

            <button class="btn btn-sm btn-outline-secondary rounded-pill px-3 shadow-sm fw-semibold" @onclick="RecarregarMetricasAsync" title="Atualizar indicadores">
                <i class="bi bi-arrow-clockwise me-1 @(isLoading ? "spin-animation" : "")"></i>Atualizar
            </button>

            <button class="btn btn-sm btn-primary rounded-pill px-3 shadow-sm fw-bold" @onclick='() => NavigationManager.NavigateTo("/despesas")'>
                <i class="bi bi-plus-lg me-1"></i>Nova Despesa
            </button>
        </div>
    </div>

    <!-- 1. KPIs Principais: Receitas, Despesas, Saldo Líquido e Saúde Orçamentária -->
    <div class="row g-3 mb-4">
        <!-- Receitas (Mês) -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 kpi-card-refined kpi-accent-emerald h-100 p-3 shadow-sm">
                <div class="d-flex justify-content-between align-items-start">
                    <div class="flex-grow-1">
                        <div class="kpi-label">Receitas (Mês)</div>
                        <div class="kpi-value text-success">@totalReceitas.ToString("C")</div>
                        <div class="kpi-sub-badges mt-2 d-flex flex-wrap gap-1">
                            <span class="badge badge-subtle-success">
                                <i class="bi bi-arrow-up-right me-1"></i>Entradas confirmadas
                            </span>
                        </div>
                    </div>
                    <div class="kpi-icon-bubble kpi-bubble-emerald ms-2">
                        <i class="bi bi-cash-stack"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Despesas (Mês) -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 kpi-card-refined kpi-accent-rose h-100 p-3 shadow-sm card-clickable"
                 @onclick='() => AbrirModalDetalhes("Despesas do Mês", DespesaMes)'
                 title="Clique para ver a relação de despesas do mês">
                <div class="d-flex justify-content-between align-items-start">
                    <div class="flex-grow-1">
                        <div class="kpi-label">Despesas (Mês)</div>
                        <div class="kpi-value text-danger">@totalDespesas.ToString("C")</div>
                        <div class="kpi-sub-badges mt-2 d-flex flex-wrap gap-1">
                            <span class="badge badge-subtle-danger">
                                <i class="bi bi-arrow-down-right me-1"></i>@DespesaMes.Count lançamento(s)
                            </span>
                            <span class="badge badge-subtle-neutral">
                                <i class="bi bi-eye me-1"></i>Auditar
                            </span>
                        </div>
                    </div>
                    <div class="kpi-icon-bubble kpi-bubble-rose ms-2">
                        <i class="bi bi-receipt"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Saldo Líquido (Mês) -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 kpi-card-refined kpi-accent-indigo h-100 p-3 shadow-sm">
                <div class="d-flex justify-content-between align-items-start">
                    <div class="flex-grow-1">
                        <div class="kpi-label">Saldo Líquido (Mês)</div>
                        <div class="kpi-value @(saldoAtual >= 0 ? "text-primary" : "text-danger")">@saldoAtual.ToString("C")</div>
                        <div class="kpi-sub-badges mt-2 d-flex flex-wrap gap-1">
                            <span class="badge @(saldoAtual >= 0 ? "badge-subtle-success" : "badge-subtle-danger")">
                                <i class="bi @(saldoAtual >= 0 ? "bi-graph-up-arrow" : "bi-graph-down-arrow") me-1"></i>
                                @(saldoAtual >= 0 ? "Superávit no período" : "Déficit no período")
                            </span>
                        </div>
                    </div>
                    <div class="kpi-icon-bubble kpi-bubble-indigo ms-2">
                        <i class="bi bi-piggy-bank-fill"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Saúde Financeira / Comprometimento -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 kpi-card-refined kpi-accent-sky h-100 p-3 shadow-sm">
                <div class="d-flex justify-content-between align-items-start">
                    <div class="flex-grow-1">
                        <div class="kpi-label">Comprometimento de Renda</div>
                        <div class="d-flex align-items-baseline gap-2">
                            <div class="kpi-value">@TaxaComprometimento%</div>
                            <span class="small text-muted fw-semibold">gastos / receita</span>
                        </div>
                        <div class="progress mt-2" style="height: 6px; background-color: rgba(100, 116, 139, 0.12); border-radius: 999px;">
                            <div class="progress-bar @(TaxaComprometimento > 90 ? "bg-danger" : TaxaComprometimento > 70 ? "bg-warning" : "bg-success")"
                                 style="width: @(Math.Min(100, TaxaComprometimento))%; border-radius: 999px;"></div>
                        </div>
                        <div class="kpi-sub-badges mt-2 d-flex flex-wrap gap-1">
                            <span class="badge @(TaxaComprometimento > 90 ? "badge-subtle-danger" : TaxaComprometimento > 70 ? "badge-subtle-warning" : "badge-subtle-success")">
                                @(TaxaComprometimento > 100 ? "Gastos > Receitas" : TaxaComprometimento > 70 ? "Atenção ao teto" : "Equilíbrio saudável")
                            </span>
                        </div>
                    </div>
                    <div class="kpi-icon-bubble kpi-bubble-sky ms-2">
                        <i class="bi bi-speedometer2"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 2. Alertas Críticos de Vencimento -->
    <div class="row g-3 mb-4">
        <!-- Próximas ao Vencimento -->
        <div class="col-12 col-md-6">
            <div class="card border-0 kpi-card-refined kpi-accent-amber h-100 p-3 shadow-sm card-clickable"
                 @onclick='() => AbrirModalDetalhes("Próximas ao Vencimento", DespesaAVencer)'
                 title="Clique para auditar as despesas que vencem em breve">
                <div class="d-flex justify-content-between align-items-start">
                    <div class="flex-grow-1">
                        <div class="kpi-label">Próximas ao Vencimento</div>
                        <div class="kpi-value text-warning-emphasis">
                            @(DespesaAVencer?.Sum(d => d.Valor).ToString("C") ?? "R$ 0,00")
                        </div>
                        <div class="kpi-sub-badges mt-2 d-flex flex-wrap gap-1">
                            <span class="badge badge-subtle-warning">
                                <i class="bi bi-clock-history me-1"></i>@(DespesaAVencer?.Count ?? 0) conta(s) a vencer
                            </span>
                            <span class="badge badge-subtle-neutral">
                                <i class="bi bi-calendar2-check me-1"></i>Auditar pendências
                            </span>
                        </div>
                    </div>
                    <div class="kpi-icon-bubble kpi-bubble-amber ms-2">
                        <i class="bi bi-calendar-event-fill"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Despesas Vencidas -->
        <div class="col-12 col-md-6">
            <div class="card border-0 kpi-card-refined kpi-accent-danger h-100 p-3 shadow-sm card-clickable"
                 @onclick='() => AbrirModalDetalhes("Despesas Vencidas", DespesasVencidas)'
                 title="Clique para regularizar as despesas vencidas">
                <div class="d-flex justify-content-between align-items-start">
                    <div class="flex-grow-1">
                        <div class="kpi-label">Despesas Vencidas (Urgente)</div>
                        <div class="kpi-value text-danger">
                            @(DespesasVencidas?.Sum(d => d.Valor).ToString("C") ?? "R$ 0,00")
                        </div>
                        <div class="kpi-sub-badges mt-2 d-flex flex-wrap gap-1">
                            <span class="badge @((DespesasVencidas?.Count ?? 0) > 0 ? "badge-subtle-danger" : "badge-subtle-success")">
                                <i class="bi @((DespesasVencidas?.Count ?? 0) > 0 ? "bi-exclamation-triangle-fill" : "bi-check2-circle") me-1"></i>
                                @(DespesasVencidas?.Count ?? 0) conta(s) pendente(s)
                            </span>
                            <span class="badge badge-subtle-neutral">
                                <i class="bi bi-shield-check me-1"></i>Regularizar quitação
                            </span>
                        </div>
                    </div>
                    <div class="kpi-icon-bubble kpi-bubble-danger ms-2">
                        <i class="bi bi-exclamation-octagon-fill"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 3. Acessos Rápidos Operacionais (Estilo JT_Food) -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 quick-card h-100 p-3 shadow-sm" @onclick='() => NavigationManager.NavigateTo("/despesas")' style="cursor: pointer;">
                <div class="d-flex align-items-center">
                    <div class="quick-icon-bubble quick-bubble-rose me-3">
                        <i class="bi bi-dash-circle fs-4"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold mb-1">Despesas & Contas</h6>
                        <p class="text-muted small mb-0">Lançar saídas, baixas e agendamentos.</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 quick-card h-100 p-3 shadow-sm" @onclick='() => NavigationManager.NavigateTo("/receitas")' style="cursor: pointer;">
                <div class="d-flex align-items-center">
                    <div class="quick-icon-bubble quick-bubble-emerald me-3">
                        <i class="bi bi-plus-circle fs-4"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold mb-1">Receitas & Faturamento</h6>
                        <p class="text-muted small mb-0">Cadastrar recebimentos e rendimentos.</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 quick-card h-100 p-3 shadow-sm" @onclick='() => NavigationManager.NavigateTo("/cartoes-credito")' style="cursor: pointer;">
                <div class="d-flex align-items-center">
                    <div class="quick-icon-bubble quick-bubble-indigo me-3">
                        <i class="bi bi-credit-card-2-front fs-4"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold mb-1">Cartões de Crédito</h6>
                        <p class="text-muted small mb-0">Faturas abertas, limites e vencimentos.</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 quick-card h-100 p-3 shadow-sm" @onclick='() => NavigationManager.NavigateTo("/dashboards")' style="cursor: pointer;">
                <div class="d-flex align-items-center">
                    <div class="quick-icon-bubble quick-bubble-purple me-3">
                        <i class="bi bi-stars fs-4"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold mb-1">Dashboards & Relatórios</h6>
                        <p class="text-muted small mb-0">Composição IA e relatórios EDW.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 4. Painéis Operacionais: Últimas Despesas do Mês & Contas Vencidas -->
    <div class="row g-3 mb-4">
        <!-- Últimas Despesas Lançadas no Mês -->
        <div class="col-12 col-xl-7">
            <div class="card border-0 shadow-sm h-100 dashboard-panel">
                <div class="card-header py-3 px-3 d-flex justify-content-between align-items-center border-bottom bg-transparent">
                    <h5 class="fw-bold mb-0 fs-6">
                        <i class="bi bi-clock-history text-primary me-2"></i>Últimas Despesas do Mês (@DespesaMes.Count)
                    </h5>
                    @if (DespesaMes.Any())
                    {
                        <button class="btn btn-sm btn-link text-primary p-0 text-decoration-none fw-semibold"
                                @onclick='() => AbrirModalDetalhes("Despesas do Mês", DespesaMes)'>
                            Ver Todas <i class="bi bi-chevron-right small"></i>
                        </button>
                    }
                </div>
                <div class="card-body p-0">
                    @if (!DespesaMes.Any())
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="bi bi-inbox fs-1 opacity-25"></i>
                            <p class="mt-2 mb-0 fw-semibold">Nenhuma despesa registrada para este mês.</p>
                            <small class="text-muted">As despesas adicionadas serão listadas aqui.</small>
                            <div class="mt-3">
                                <button class="btn btn-sm btn-outline-primary rounded-pill px-3" @onclick='() => NavigationManager.NavigateTo("/despesas")'>
                                    <i class="bi bi-plus-lg me-1"></i>Cadastrar Despesa
                                </button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-header-custom">
                                    <tr>
                                        <th>Descrição</th>
                                        <th>Categoria</th>
                                        <th class="text-center">Data</th>
                                        <th class="text-end">Valor</th>
                                        <th class="text-center">Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var d in DespesaMes.OrderByDescending(x => x.DataDespesa).Take(7))
                                    {
                                        <tr>
                                            <td class="fw-bold">
                                                @d.Descricao
                                                @if (!string.IsNullOrWhiteSpace(d.Observacao))
                                                {
                                                    <small class="d-block text-muted fw-normal">Obs: @d.Observacao</small>
                                                }
                                            </td>
                                            <td>
                                                <span class="badge badge-subtle-neutral">
                                                    @(string.IsNullOrWhiteSpace(d.CategoriaStruct.Nome) ? "Geral" : d.CategoriaStruct.Nome)
                                                </span>
                                            </td>
                                            <td class="text-center text-muted small">
                                                @d.DataDespesa.ToString("dd/MM/yyyy")
                                            </td>
                                            <td class="text-end fw-bold text-danger">
                                                @d.Valor.ToString("C")
                                            </td>
                                            <td class="text-center">
                                                <span class="badge @(d.DespesaPaga ? "badge-subtle-success" : "badge-subtle-warning")">
                                                    <i class="bi @(d.DespesaPaga ? "bi-check2-circle" : "bi-clock") me-1"></i>
                                                    @(d.DespesaPaga ? "Paga" : "Pendente")
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Contas Vencidas & Alertas Prioritários -->
        <div class="col-12 col-xl-5">
            <div class="card border-0 shadow-sm h-100 dashboard-panel">
                <div class="card-header py-3 px-3 d-flex justify-content-between align-items-center border-bottom bg-transparent">
                    <h5 class="fw-bold mb-0 fs-6">
                        <i class="bi bi-shield-exclamation text-danger me-2"></i>Contas Vencidas (@(DespesasVencidas?.Count ?? 0))
                    </h5>
                    @if (DespesasVencidas?.Any() == true)
                    {
                        <button class="btn btn-sm btn-link text-danger p-0 text-decoration-none fw-semibold"
                                @onclick='() => AbrirModalDetalhes("Despesas Vencidas", DespesasVencidas)'>
                            Auditar Todas <i class="bi bi-chevron-right small"></i>
                        </button>
                    }
                </div>
                <div class="card-body p-0">
                    @if (DespesasVencidas == null || !DespesasVencidas.Any())
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="bi bi-check2-circle fs-1 text-success opacity-50"></i>
                            <p class="mt-2 mb-0 fw-semibold text-success">Nenhuma conta vencida!</p>
                            <small class="text-muted">Excelente! Todos os pagamentos e obrigações estão em dia.</small>
                        </div>
                    }
                    else
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var v in DespesasVencidas.Take(6))
                            {
                                <div class="list-group-item d-flex justify-content-between align-items-center p-3 border-bottom">
                                    <div>
                                        <div class="fw-bold text-truncate" style="max-width: 200px;">
                                            @v.Descricao
                                        </div>
                                        <small class="text-muted d-block">
                                            <i class="bi bi-tag me-1"></i>@(string.IsNullOrWhiteSpace(v.CategoriaStruct.Nome) ? "Geral" : v.CategoriaStruct.Nome)
                                            <span class="ms-2 text-danger fw-semibold">
                                                <i class="bi bi-calendar-x me-1"></i>@ObterStatusVencimento(v.DataDespesa)
                                            </span>
                                        </small>
                                    </div>
                                    <div class="text-end">
                                        <span class="fw-bold text-danger d-block fs-6">@v.Valor.ToString("C")</span>
                                        <button class="btn btn-sm btn-outline-danger rounded-pill py-0 px-2 mt-1 fw-semibold"
                                                @onclick='() => AbrirModalDetalhes("Detalhes da Conta Vencida", new List<sDespesa> { v })'
                                                style="font-size: 0.75rem;">
                                            Auditar
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- 5. Painéis de Gráficos Analíticos -->
    <div class="row g-3">
        <!-- Gráfico de Despesas por Categoria -->
        <div class="col-12 col-lg-6">
            <div class="card border-0 shadow-sm h-100 dashboard-panel">
                <div class="card-header py-3 px-3 d-flex justify-content-between align-items-center border-bottom bg-transparent">
                    <h5 class="fw-bold mb-0 fs-6">
                        <i class="bi bi-pie-chart-fill text-indigo me-2"></i>Despesas por Categoria
                    </h5>
                    <span class="badge badge-subtle-neutral">Distribuição do Mês</span>
                </div>
                <div class="card-body p-4">
                    @if (isLoading)
                    {
                        <div class="text-center py-5"><Loading /></div>
                    }
                    else if (datasetsGraficoPorCategoria.Any() && datasetsGraficoPorCategoria.First().Data.Any())
                    {
                        <Chart ChartId="despesasPorCategoriaChart"
                               Type="ChartType.Doughnut"
                               Labels="despesaCategoriasLabels"
                               Datasets="datasetsGraficoPorCategoria"
                               Title="Despesas por Categoria" />
                    }
                    else
                    {
                        <div class="text-center py-5 d-flex flex-column justify-content-center align-items-center h-100">
                            <div class="empty-state-bubble mb-3">
                                <i class="bi bi-pie-chart fs-2 text-muted"></i>
                            </div>
                            <h6 class="fw-semibold mb-1">Sem despesas categorizadas</h6>
                            <p class="text-muted small mb-3">Não há despesas com categoria vinculada registradas para este mês.</p>
                            <button class="btn btn-sm btn-outline-primary rounded-pill px-3" @onclick='() => NavigationManager.NavigateTo("/despesas")'>
                                <i class="bi bi-plus-lg me-1"></i>Lançar Despesa
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Gráfico de Despesas por Tipo -->
        <div class="col-12 col-lg-6">
            <div class="card border-0 shadow-sm h-100 dashboard-panel">
                <div class="card-header py-3 px-3 d-flex justify-content-between align-items-center border-bottom bg-transparent">
                    <h5 class="fw-bold mb-0 fs-6">
                        <i class="bi bi-bar-chart-line-fill text-primary me-2"></i>Despesas por Tipo
                    </h5>
                    <span class="badge badge-subtle-neutral">Fixas vs. Variáveis</span>
                </div>
                <div class="card-body p-4">
                    @if (isLoading)
                    {
                        <div class="text-center py-5"><Loading /></div>
                    }
                    else if (datasetsGraficoPorTipo.Any() && datasetsGraficoPorTipo.First().Data.Any())
                    {
                        <Chart ChartId="despesasPorTipoChart"
                               Type="ChartType.Bar"
                               Labels="despesaTiposLabels"
                               Datasets="datasetsGraficoPorTipo"
                               Title="Despesas por Tipo" />
                    }
                    else
                    {
                        <div class="text-center py-5 d-flex flex-column justify-content-center align-items-center h-100">
                            <div class="empty-state-bubble mb-3">
                                <i class="bi bi-bar-chart-line fs-2 text-muted"></i>
                            </div>
                            <h6 class="fw-semibold mb-1">Sem despesas por tipo</h6>
                            <p class="text-muted small mb-3">Não há registros de classificação de tipo de despesa para este mês.</p>
                            <button class="btn btn-sm btn-outline-primary rounded-pill px-3" @onclick='() => NavigationManager.NavigateTo("/despesas")'>
                                <i class="bi bi-plus-lg me-1"></i>Lançar Despesa
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal de Detalhes da Grade de Despesas -->
<JT_UserInterface.Shared.Components.Core.Modal @ref="modalDetalhes" Size="JT_UserInterface.Shared.Components.Core.Modal.ModalSize.ExtraLarge">
    <BodyContent>
