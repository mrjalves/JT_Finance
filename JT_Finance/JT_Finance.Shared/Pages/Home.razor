@page "/"
@using JT_Finance.Shared.Services
@inject IFormFactor FormFactor

<PageTitle>Home</PageTitle>

<h1>Painel Financeiro</h1>
<p>Resumo das suas finanças.</p>

<div class="row mb-3">
    <div class="col-md-4 mb-3">
        <div class="card text-white bg-success h-100">
            <div class="card-header">Saldo Atual (Mês)</div>
            <div class="card-body">
                <h4 class="card-title">@saldoAtual.ToString("C")</h4>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-3">
        <div class="card text-white bg-primary h-100">
            <div class="card-header">Total Receitas (Mês)</div>
            <div class="card-body">
                <h4 class="card-title">@totalReceitas.ToString("C")</h4>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-3">
        <div class="card text-white bg-danger h-100">
            <div class="card-header">Total Despesas (Mês)</div>
            <div class="card-body">
                <h4 class="card-title">@totalDespesas.ToString("C")</h4>
            </div>
        </div>
    </div>
</div>

<hr />

<div class="row mt-4">
    <div class="col-lg-8 offset-lg-2 col-xl-6 offset-xl-3">
        @if (dadosGraficoCarregados && despesaCategoriasValores != null && despesaCategoriasValores.Any())
        {
            <PieChart ChartId="despesasMensaisChart"
                      Labels="despesaCategoriasLabels"
                      DataValues="despesaCategoriasValores"
                      Title="Distribuição de Despesas por Categoria (Mês Atual)" />
        }
        else if (dadosGraficoCarregados && (despesaCategoriasValores == null || !despesaCategoriasValores.Any()))
        {
            <div class="text-center p-4 border rounded bg-light">
                <p class="mb-0">Não há dados de despesas para exibir no gráfico este mês.</p>
            </div>
        }
        else
        {
            <div class="text-center p-4">
                <p class="mb-0"><em>Carregando dados do gráfico...</em></p>
            </div>
        }
    </div>
</div>

<hr />

<p><em>Informações de debug: App rodando em @factor usando @platform.</em></p>

@code {
    private string factor => FormFactor.GetFormFactor();
    private string platform => FormFactor.GetPlatform();

    // Variáveis para os cards de resumo
    private decimal totalReceitas;
    private decimal totalDespesas;
    private decimal saldoAtual;

    // Variáveis para o gráfico de pizza
    private List<string> despesaCategoriasLabels = new List<string>();
    private List<decimal> despesaCategoriasValores = new List<decimal>();
    private bool dadosGraficoCarregados = false; // Flag para controlar a renderização do gráfico

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardData();
    }

    // TODO: Substituir pela chamada real aos seus serviços da camada de negócios/dados
    private async Task LoadDashboardData()
    {
        // Simulação de carregamento de dados
        dadosGraficoCarregados = false; // Reseta a flag antes de carregar
        await Task.Delay(150); // Simula uma latência de rede/DB um pouco maior para ver o "Carregando..."

        totalReceitas = await GetTotalReceitasMesAtualAsync_Simulated();
        totalDespesas = await GetTotalDespesasMesAtualAsync_Simulated();
        saldoAtual = totalReceitas - totalDespesas;

        // Carregar dados para o gráfico de pizza
        var despesasPorCategoria = await GetDespesasPorCategoriaMesAtualAsync_Simulated();
        if (despesasPorCategoria != null)
        {
            despesaCategoriasLabels = despesasPorCategoria.Keys.ToList();
            despesaCategoriasValores = despesasPorCategoria.Values.ToList();
        }
        else
        {
            despesaCategoriasLabels = new List<string>();
            despesaCategoriasValores = new List<decimal>();
        }
        dadosGraficoCarregados = true;
        StateHasChanged(); // Notifica o componente que os dados foram atualizados e precisa re-renderizar
    }

    private async Task<decimal> GetTotalReceitasMesAtualAsync_Simulated()
    {
        // Simulação: Em um cenário real, você chamaria seu serviço aqui.
        // Ex: return await _meuServicoFinanceiro.GetTotalReceitasAsync(DateTime.Now.Month, DateTime.Now.Year);
        await Task.Delay(10); // Simula trabalho
        Random rnd = new Random();
        return (decimal)(rnd.Next(5000, 15000) + rnd.NextDouble());
    }

    private async Task<decimal> GetTotalDespesasMesAtualAsync_Simulated()
    {
        // Simulação: Em um cenário real, você chamaria seu serviço aqui.
        // Ex: return await _meuServicoFinanceiro.GetTotalDespesasAsync(DateTime.Now.Month, DateTime.Now.Year);
        await Task.Delay(10); // Simula trabalho
        Random rnd = new Random();
        return (decimal)(rnd.Next(2000, 10000) + rnd.NextDouble());
    }

    private async Task<Dictionary<string, decimal>> GetDespesasPorCategoriaMesAtualAsync_Simulated()
    {
        await Task.Delay(20); // Simula trabalho
        Random rnd = new Random();
        // Simula chance de não haver despesas
        if (rnd.Next(0, 5) == 0) {
            return new Dictionary<string, decimal>(); // Retorna vazio
        }
        return new Dictionary<string, decimal>
        {
            { "Alimentação", (decimal)(rnd.Next(200, 800) + rnd.NextDouble()) },
            { "Transporte", (decimal)(rnd.Next(50, 300) + rnd.NextDouble()) },
            { "Moradia", (decimal)(rnd.Next(300, 1200) + rnd.NextDouble()) },
            { "Lazer", (decimal)(rnd.Next(30, 250) + rnd.NextDouble()) },
            { "Saúde", (decimal)(rnd.Next(0, 150) + rnd.NextDouble()) },
            { "Outros", (decimal)(rnd.Next(20, 200) + rnd.NextDouble()) }
        };
    }
}
