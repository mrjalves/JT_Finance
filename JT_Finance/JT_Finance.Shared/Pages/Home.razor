@page "/"
@using System.Globalization
@using JT_Classes
@using JT_Classes.Financeiro
@using JT_Finance.Shared.Components
@using JT_Finance.Shared.Components.Charts
@using JT_Finance.Shared.Services
@using JT_Finance.Shared.Services.Interfaces
@using static JT_Finance.Shared.Components.Modal
@inject IFormFactor FormFactor
@inject IDespesaService DespesaService
@inject IReceitaService ReceitaService
<PageTitle>Dashboard</PageTitle>

<!-- SELETOR DE MÊS -->
<div class="d-flex justify-content-center align-items-center my-4">
    <button class="btn btn-outline-primary" @onclick="MudarMesAnterior">
        <i class="bi bi-chevron-left"></i>
    </button>
    <h2 class="mx-4 mb-0" style="min-width: 200px; text-align: center;">
        @mesReferencia.ToString("MMMM yyyy", new CultureInfo("pt-BR"))
    </h2>
    <button class="btn btn-outline-primary" @onclick="MudarMesProximo">
        <i class="bi bi-chevron-right"></i>
    </button>
</div>


<!-- CARDS DE RESUMO -->
<div class="row mb-2">
    <div class="col-md-4 mb-2">
        <div class="card border-left-success shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-success text-uppercase mb-1">Receitas (Mês)</div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">@totalReceitas.ToString("C")</div>
                    </div>
                    <div class="col-auto">
                        <i class="bi bi-cash-coin fs-2 text-gray-300"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-2">
        <div class="card border-left-danger shadow h-100 py-2 card-clickable" @onclick='() => AbrirModalDetalhes(" Do mês", DespesaMes)'>
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-danger text-uppercase mb-1">Despesas (Mês)</div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">@totalDespesas.ToString("C")</div>
                    </div>
                    <div class="col-auto">
                        <i class="bi bi-receipt fs-2 text-gray-300"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-2">
        <div class="card border-left-primary shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">Saldo (Mês)</div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">@saldoAtual.ToString("C")</div>
                    </div>
                    <div class="col-auto">
                        <i class="bi bi-piggy-bank-fill fs-2 text-gray-300"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row mb-2">
    @* Card para Despesas a Vencer *@
    <div class="col-lg-6 mb-2">
        <div class="card border-left-warning shadow h-100 py-2 card-clickable" @onclick='() => AbrirModalDetalhes(" Próximas ao Vencimento", DespesaAVencer)'>
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">
                            Próximas ao Vencimento
                        </div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">
                            @DespesaAVencer?.Count() despesa(s)
                        </div>
                        <div class="text-md text-gray-600">
                            Total: @(DespesaAVencer?.Sum(d => d.Valor).ToString("C") ?? "R$ 0,00")
                        </div>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-calendar-alt fa-2x text-gray-300"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* Card para Despesas Vencidas *@
    <div class="col-lg-6 mb-2">
        <div class="card border-left-danger shadow h-100 py-2 card-clickable" @onclick='() => AbrirModalDetalhes(" Despesas Vencidas", DespesasVencidas)'>
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-danger text-uppercase mb-1">
                            Vencidas
                        </div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">
                            @DespesasVencidas?.Count() despesa(s)
                        </div>
                        <div class="text-md text-gray-600">
                            Total: @(DespesasVencidas?.Sum(d => d.Valor).ToString("C") ?? "R$ 0,00")
                        </div>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-exclamation-triangle fa-2x text-gray-300"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- GRÁFICOS -->
<div class="row mt-2">
    <div class="col-lg-6 mb-4">
        <div class="card shadow h-100">
            <div class="card-body">
                @if (isLoading)
                {
                    <Loading/>
                }
                else if (datasetsGraficoPorCategoria.Any() && datasetsGraficoPorCategoria.First().Data.Any())
                {
                    <Chart ChartId="despesasPorCategoriaChart"
                           Type="ChartType.Doughnut"
                           Labels="despesaCategoriasLabels"
                           Datasets="datasetsGraficoPorCategoria"
                           Title="Despesas por Categoria" />
                }
                else
                {
                    <div class="text-center p-4 d-flex flex-column justify-content-center align-items-center h-100">
                        <i class="bi bi-pie-chart fs-1 text-muted"></i>
                        <p class="mt-2">Não há dados de despesa por categoria para este mês.</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-6 mb-4">
        <div class="card shadow h-100">
            <div class="card-body">
                @if (isLoading)
                {
                    <Loading />
                }
                else if (datasetsGraficoPorTipo.Any() && datasetsGraficoPorTipo.First().Data.Any())
                {
                    <Chart ChartId="despesasPorTipoChart"
                           Type="ChartType.Bar"
                           Labels="despesaTiposLabels"
                           Datasets="datasetsGraficoPorTipo"
                           Title="Despesas por Tipo" />
                }
                else
                {
                    <div class="text-center p-4 d-flex flex-column justify-content-center align-items-center h-100">
                        <i class="bi bi-bar-chart-line fs-1 text-muted"></i>
                        <p class="mt-2">Não há dados de despesa por tipo para este mês.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<Modal @ref="modalDetalhes" Size="ModalSize.ExtraLarge">
    <BodyContent>
        <JT_Finance.Shared.Components.Grids.GridDespesas
           Despesas="despesasParaExibir"
           HideActions="true"
        />
    </BodyContent>
</Modal>

@code {
    [CascadingParameter]
    public Func<string, Task>? SetPageTitleAsync { get; set; }

    // --- Estado da Página ---
    private DateTime mesReferencia = DateTime.Now;
    private bool isLoading = true;

    // --- Dados para os Cards ---
    private decimal totalReceitas;
    private decimal totalDespesas;
    private decimal saldoAtual;

    // --- Dados para os Gráficos ---
    private List<string> despesaTiposLabels = new();
    private List<ChartDataset> datasetsGraficoPorTipo = new();
    private List<string> despesaCategoriasLabels = new();
    private List<ChartDataset> datasetsGraficoPorCategoria = new();
    private List<Despesa> DespesasVencidas = new();
    private List<Despesa> DespesaAVencer = new();
    private List<Despesa> DespesaMes = new();
    protected override async Task OnInitializedAsync()
    {
        if (SetPageTitleAsync != null)
        {
            await SetPageTitleAsync.Invoke("Dashboard");
        }
        await LoadDashboardData();
        DespesaAVencer = await DespesaService.ObterDespesasAVencerAsync();
        DespesasVencidas = await DespesaService.ObterDespesasVencidasAsync();
    }

    private async Task LoadDashboardData()
    {
        isLoading = true;
        await InvokeAsync(StateHasChanged);

        // Usar Task.Run para não bloquear a UI enquanto os dados são buscados
        await Task.Run(async () =>
        {
            // --- CARREGA DADOS DOS CARDS ---
            totalReceitas = await ReceitaService.GetTotalMes(mesReferencia);
            totalDespesas = await DespesaService.GetTotalMes(mesReferencia);
            saldoAtual = totalReceitas - totalDespesas;

           
            DespesaMes = await DespesaService.ObterDespesasMesAsync(mesReferencia);

            // --- GRÁFICO DE TIPO (BARRAS) ---
            var despesasPorTipo = await DespesaService.GetDespesaPorTipo(mesReferencia);
            despesaTiposLabels = despesasPorTipo.Select(d => d.Tipo).ToList();
            datasetsGraficoPorTipo = new List<ChartDataset>
            {
                new() {
                    Label = "Total por Tipo",
                    Data = despesasPorTipo.Select(d => d.ValorTotal).ToList()
                }
            };

            // --- GRÁFICO DE CATEGORIA (ROSCA) ---
            var despesasPorCategoria = await DespesaService.GetDespesaPorCategoria(mesReferencia);
            despesaCategoriasLabels = despesasPorCategoria.Select(d => d.Categoria).ToList();
            datasetsGraficoPorCategoria = new List<ChartDataset>
            {
                new() {
                    Data = despesasPorCategoria.Select(d => d.ValorTotal).ToList()
                }
            };
        });

        isLoading = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task MudarMes(int mesesParaAdicionar)
    {
        mesReferencia = mesReferencia.AddMonths(mesesParaAdicionar);
        await LoadDashboardData();
    }

    private async Task MudarMesAnterior() => await MudarMes(-1);
    private async Task MudarMesProximo() => await MudarMes(1);


    private Modal modalDetalhes;
    private List<Despesa> despesasParaExibir = new();
    private void AbrirModalDetalhes(string titulo, List<Despesa> despesas)
    {
        despesasParaExibir = despesas;
        modalDetalhes.Title = titulo;
        modalDetalhes.Open();
    }
}
