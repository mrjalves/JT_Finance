@page "/"
@using JT_Classes
@using JT_Classes.Financeiro
@using JT_Finance.Shared.Components
@using JT_Finance.Shared.Components.Charts
@using JT_Finance.Shared.Services
@inject IFormFactor FormFactor

<PageTitle>Dashboard</PageTitle>

<h1>Painel Financeiro</h1>
<p>Resumo das suas finanças.</p>

<div class="row mb-3">
    <div class="col-md-4 mb-3">
        <div class="card text-white bg-success h-100">
            <div class="card-header">Saldo Atual (Mês)</div>
            <div class="card-body">
                <h4 class="card-title">@saldoAtual.ToString("C")</h4>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-3">
        <div class="card text-white bg-primary h-100">
            <div class="card-header">Total Receitas (Mês)</div>
            <div class="card-body">
                <h4 class="card-title">@totalReceitas.ToString("C")</h4>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-3">
        <div class="card text-white bg-danger h-100">
            <div class="card-header">Total Despesas (Mês)</div>
            <div class="card-body">
                <h4 class="card-title">@totalDespesas.ToString("C")</h4>
            </div>
        </div>
    </div>
</div>

<hr />


<div class="row mt-4">
    <div class="col-lg-6 mb-4">
        <div class="card h-100">
            <div class="card-body">
                @if (dadosGraficoCarregados && datasetsGraficoPorTipo.Any() && datasetsGraficoPorTipo.First().Data.Any())
                {
                    <Chart ChartId="despesasPorTipoChart"
                           Type="ChartType.Bar"
                           Labels="despesaTiposLabels"
                           Datasets="datasetsGraficoPorTipo"
                           Title="Despesas por Tipo (Mês Atual)" />
                }
                else if (dadosGraficoCarregados)
                {
                    <div class="text-center p-4"><p>Não há dados de despesa por tipo.</p></div>
                }
                else
                {
                    <div class="text-center p-4"><p><em>Carregando...</em></p></div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-6 mb-4">
        <div class="card h-100">
            <div class="card-body">
                @if (dadosGraficoCarregados && datasetsGraficoPorCategoria.Any() && datasetsGraficoPorCategoria.First().Data.Any())
                {
                    <Chart ChartId="despesasPorCategoriaChart"
                           Type="ChartType.Pie"
                           Labels="despesaCategoriasLabels"
                           Datasets="datasetsGraficoPorCategoria"
                           Title="Despesas por Categoria (Mês Atual)" />
                }
                else if (dadosGraficoCarregados)
                {
                    <div class="text-center p-4"><p>Não há dados de despesa por categoria.</p></div>
                }
                else
                {
                    <div class="text-center p-4"><p><em>Carregando...</em></p></div>
                }
            </div>
        </div>
    </div>
</div>


@code {
    [CascadingParameter]
    public Func<string, Task>? SetPageTitleAsync { get; set; }

    // --- Variáveis para os cards de resumo ---
    private decimal totalReceitas;
    private decimal totalDespesas;
    private decimal saldoAtual;

    // --- Variáveis para os Gráficos ---
    private List<string> despesaTiposLabels = new();
    private List<ChartDataset> datasetsGraficoPorTipo = new();

    private List<string> despesaCategoriasLabels = new();
    private List<ChartDataset> datasetsGraficoPorCategoria = new();

    private bool dadosGraficoCarregados = false;

    protected override async Task OnInitializedAsync()
    {
        if (SetPageTitleAsync != null)
        {
            await SetPageTitleAsync.Invoke("Dashboard");
        }
        await LoadDashboardData();
    }

    private async Task LoadDashboardData()
    {
        dadosGraficoCarregados = false;
        await InvokeAsync(StateHasChanged);

        await Task.Run(() =>
        {
            var mesAtual = DateTime.Now;

            // --- CARREGA DADOS DOS CARDS ---
            totalReceitas = Receita.GetTotalReceitasMes(mesAtual);
            totalDespesas = Despesa.GetTotalDespesaMes(mesAtual);
            saldoAtual = totalReceitas - totalDespesas;

            // --- CARREGA DADOS PARA O GRÁFICO DE TIPO (BARRAS) ---
            var despesasPorTipo = Despesa.GetDespesasAgrupadasPorTipo(mesAtual);
            datasetsGraficoPorTipo.Clear();
            if (despesasPorTipo.Any())
            {
                despesaTiposLabels = despesasPorTipo.Select(d => d.Tipo).ToList();
                datasetsGraficoPorTipo.Add(new ChartDataset
                {
                    Label = "Total por Tipo",
                    Data = despesasPorTipo.Select(d => d.ValorTotal).ToList(),
                    BackgroundColor = new List<string> { "rgba(54, 162, 235, 0.7)", "rgba(255, 99, 132, 0.7)" }
                });
            }

            // --- CARREGA DADOS PARA O GRÁFICO DE CATEGORIA (PIZZA) ---
            var despesasPorCategoria = Despesa.GetDespesasAgrupadasPorCategoria(mesAtual);
            datasetsGraficoPorCategoria.Clear();
            if (despesasPorCategoria.Any())
            {
                despesaCategoriasLabels = despesasPorCategoria.Select(d => d.Categoria).ToList();
                datasetsGraficoPorCategoria.Add(new ChartDataset
                {
                    Data = despesasPorCategoria.Select(d => d.ValorTotal).ToList()
                });
            }
        });

        dadosGraficoCarregados = true;
        await InvokeAsync(StateHasChanged);
    }
}