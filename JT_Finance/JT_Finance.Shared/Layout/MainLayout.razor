@inherits LayoutComponentBase

<div class="page">

    <div class="main-content-wrapper"> @* Adicionado um wrapper para sidebar e main *@
        <div class="sidebar @(isMinimizedNav ? "minimized" : "")">
            <NavMenu IsMinimized="isMinimizedNav" OnToggleMinimize="ToggleNavMenuMinimize" />
        </div>

        <main class="@(isMinimizedNav ? "sidebar-minimized" : "")">
            <Header /> @* <-- Adicionado o Header aqui *@
            @* Comentários sobre Header e NavMenu mantidos para referência futura *@
            <article class="content px-4">
                @Body
            </article>
        </main>
    </div>

    <Footer /> @* <-- Adicionado o Footer aqui *@
</div>

<ToastContainer /> @* <-- Adicionado o ToastContainer aqui *@

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool isMinimizedNav = false;

    private void ToggleNavMenuMinimize()
    {
        isMinimizedNav = !isMinimizedNav;
    }
}
