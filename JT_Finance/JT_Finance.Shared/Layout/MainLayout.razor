@using JT_Finance.Shared.Components.Toasts
@using JT_Finance.Shared.Components
@using JT_Finance.Shared.Services
@using JT_Finance.Shared.Services.Interfaces
@using JT_Finance.Shared.Models
@inherits LayoutComponentBase
@implements IDisposable

@{
    var layoutClass = _isSidebarExpanded ? "dashboard-layout expanded" : "dashboard-layout";
}

@if (_isInitialized)
{
    <div class="@layoutClass" style="@themeStyle">
        
            <NavMenu IsExpanded="@_isSidebarExpanded" OnToggle="@ToggleSidebar" />

            <div class="main-content">
                @* <div class="top-row px-4">
                    <span class="page-title">@_currentPageTitle</span>
                    <div class="user-info">
                        <span>Olá, @CurrentUserState.UsuarioName</span>
                        <button class="btn btn-link logout-button" @onclick="HandleLogout">Sair</button>
                    </div>
                </div> *@
            <Header PageTitle="@_currentPageTitle"  />
                <main class="content-body">
                    <CascadingValue Value="(Func<string, Task>)SetPageTitleAsync">
                        @Body
                    </CascadingValue>
                </main>
                <Footer />
            </div>
    </div>

    <ToastContainer />
    <Filtros />
}
else
{
    <div class="loading-container">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Carregando...</span>
        </div>
    </div>
}

@code {
    [Inject] private IThemeService ThemeService { get; set; }
    [Inject] private IJSRuntime JSRuntime { get; set; } // já tem @inject no topo
    [Inject] private FirebaseAuthService AuthService { get; set; }
    [Inject] private CurrentUserState CurrentUserState { get; set; }
    [Inject] private NavigationManager NavigationManager { get; set; }

    private bool _isSidebarExpanded = false;
    private string _currentPageTitle = "Dashboard";
    private string themeStyle = "";
    private bool _isInitialized = false;

    // Apenas registra handlers e aplica tema (sincronamente) - sem JS aqui
    protected override void OnInitialized()
    {
        ThemeService.OnChange += ApplyTheme;
        CurrentUserState.OnStateChanged += HandleAuthStateChanged;
        ApplyTheme();
    }

    // Executa a inicialização que usa JS (localStorage / Firebase JS) apenas depois do primeiro render
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        try
        {
            // Garante que o CurrentUserState possua o IJSRuntime certo deste circuito
            CurrentUserState.Initialize(JSRuntime);

            // Inicializa o auth (vai carregar o estado do localStorage internamente)
            await AuthService.InitializeAsync();

            // Se você usa login por redirect (Google), processa o resultado retornado
            var redirectResult = await AuthService.GetRedirectResultAsync();
            if (redirectResult != null && redirectResult.Success)
            {
                // usuário salvo pelo CurrentUserState dentro de GetRedirectResultAsync/InitializeAsync
            }

            // Checa se deve redirecionar à página de login
            var path = new Uri(NavigationManager.Uri).AbsolutePath;
            var isPublic = path == "/login" || path == "/cadastro";
            if (!CurrentUserState.Autenticado && !isPublic)
            {
                NavigationManager.NavigateTo("/login");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Falha na inicialização do Auth (OnAfterRender): {ex.Message}");
        }

        _isInitialized = true;
        await InvokeAsync(StateHasChanged);
    }

    // Quando o estado do usuário mudar, usa InvokeAsync para navegar/atualizar UI com segurança
    private void HandleAuthStateChanged() => _ = InvokeAsync(() =>
    {
        if (!CurrentUserState.Autenticado)
        {
            var currentPath = new Uri(NavigationManager.Uri).AbsolutePath;
            if (currentPath != "/login" && currentPath != "/cadastro")
            {
                NavigationManager.NavigateTo("/login");
            }
        }
        StateHasChanged();
    });

    private async Task HandleLogout()
    {
        await AuthService.SignOutAsync();
        NavigationManager.NavigateTo("/login", forceLoad: true);
    }

    public void Dispose()
    {
        ThemeService.OnChange -= ApplyTheme;
        CurrentUserState.OnStateChanged -= HandleAuthStateChanged;
    }

    private void ToggleSidebar()
    {
        _isSidebarExpanded = !_isSidebarExpanded;
        StateHasChanged();
    }

    private async Task SetPageTitleAsync(string title)
    {
        if (_currentPageTitle != title)
        {
            _currentPageTitle = title;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void ApplyTheme()
    {
        var theme = ThemeService.CurrentTheme;
        if (theme != null)
        {
            themeStyle = string.Join(";", theme.Colors.Select(c => $"{c.Key}:{c.Value}"));
            StateHasChanged();
        }
    }
}
