@using JT_Finance.Shared.Components.Toasts
@inherits LayoutComponentBase

@{
    var layoutClass = _isSidebarExpanded ? "dashboard-layout expanded" : "dashboard-layout";
}

<div class="@layoutClass">
    <NavMenu IsExpanded="@_isSidebarExpanded" OnToggle="@ToggleSidebar" />

    <div class="main-content">
        <Header PageTitle="@_currentPageTitle" />

        <main class="content-body">
            <CascadingValue Value="(Func<string, Task>)SetPageTitleAsync">
                @Body
            </CascadingValue>
        </main>
        <Footer/>
    </div>
</div>
<ToastContainer /> 

@code {
    private bool _isSidebarExpanded = false;
    private string _currentPageTitle = "Dashboard"; // Título padrão

    private void ToggleSidebar()
    {
        _isSidebarExpanded = !_isSidebarExpanded;
    }

    // --- INÍCIO DA MUDANÇA ---
    // Método agora é assíncrono para garantir a atualização da UI
    private async Task SetPageTitleAsync(string title)
    {
        if (_currentPageTitle != title)
        {
            _currentPageTitle = title;
            await InvokeAsync(StateHasChanged); // Força a atualização da UI de forma segura
        }
    }
    // --- FIM DA MUDANÇA ---
}