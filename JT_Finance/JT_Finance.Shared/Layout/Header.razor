@using Microsoft.AspNetCore.Components.Routing
@inject NavigationManager Navigation

<header class="header">
    <div class="header-start">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item">
                    <a href="/">
                        <i class="bi bi-house-door"></i>
                        <span>Home</span>
                    </a>
                </li>
                @if (!IsHomePage())
                {
                    <li class="breadcrumb-item active" aria-current="page">
                        @PageTitle
                    </li>
                }
            </ol>
        </nav>
    </div>
    <div class="header-end">
        <div class="header-actions">

            @if (isSearchVisible)
            {
                <input @ref="searchInputElement"
                       type="text"
                       class="search-input"
                       placeholder="Pesquisar..."
                       @onblur="HideSearchInput" />
            }
            else
            {
                <i class="bi bi-search action-icon" title="Pesquisar" @onclick="ShowSearchInput"></i>
            }

            <i class="bi bi-filter action-icon" title="Filtrar"></i>
            <i class="bi bi-three-dots-vertical action-icon" title="Mais Opções"></i>
        </div>
    </div>
</header>

@code {
    [Parameter]
    public string PageTitle { get; set; } = "Dashboard";

    private bool isSearchVisible = false;
    private ElementReference searchInputElement;

    private bool IsHomePage()
    {
        return Navigation.Uri == Navigation.BaseUri;
    }

    private async Task ShowSearchInput()
    {
        isSearchVisible = true;
        // Pequeno delay para garantir que o elemento exista no DOM antes de focar
        await Task.Delay(50);
        await searchInputElement.FocusAsync();
    }

    private void HideSearchInput()
    {
        isSearchVisible = false;
    }
}