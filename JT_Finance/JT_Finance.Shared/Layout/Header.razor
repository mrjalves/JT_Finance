@using Microsoft.AspNetCore.Components.Routing
@using JT_Finance.Shared.Services
@using JT_Finance.Shared.Components
@inject NavigationManager Navigation
@inject FiltroService FiltroService

<header class="header">
    <div class="header-start">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item">
                    <a href="/">
                        <i class="bi bi-house-door"></i>
                        <span>Home</span>
                    </a>
                </li>
                @if (!IsHomePage())
                {
                    <li class="breadcrumb-item active" aria-current="page">
                        @PageTitle
                    </li>
                }
            </ol>
        </nav>
    </div>
    <div class="header-end">
        <div class="header-actions">
           
            <Notificacao/>
            <i class="bi bi-three-dots-vertical action-icon" title="Mais Opções"></i>
        </div>
    </div>
</header>

@code {
    [Parameter]
    public string PageTitle { get; set; } = "Dashboard";

    private bool IsHomePage()
    {
        return Navigation.Uri == Navigation.BaseUri;
    }
}