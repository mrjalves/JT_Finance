@using JT_Finance.Shared.Models
@using Microsoft.AspNetCore.Components.Routing
@using JT_Finance.Shared.Services
@using JT_Finance.Shared.Components
@inject NavigationManager Navigation
@inject FiltroService FiltroService
@inject FirebaseAuthService AuthService
@inject CurrentUserState CurrentUserState

<header class="header">
    <div class="header-start">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item">
                    <a href="/">
                        <i class="bi bi-house-door"></i>
                        <span>Home</span>
                    </a>
                </li>
                @if (!IsHomePage())
                {
                    <li class="breadcrumb-item active" aria-current="page">
                        @PageTitle
                    </li>
                }
            </ol>
        </nav>
    </div>

    <div class="header-end">
           
        <div class="header-actions ms-3">
                <span class="saudacao">
                    👋 Olá, <strong>@(CurrentUserState.UsuarioName ?? "Usuário")</strong>
                </span>

            <Notificacao />
            <i class="bi bi-three-dots-vertical action-icon" title="Mais Opções"></i>
                <button class="btn btn-sm btn-outline-danger ms-2" @onclick="HandleLogout" title="Sair">
                    <i class="bi bi-box-arrow-right"></i>
                </button>
        </div>
    </div>
</header>

@code {
    [Parameter] public string PageTitle { get; set; } = "Dashboard";

    private bool IsHomePage()
        => Navigation.Uri == Navigation.BaseUri;

    private async Task HandleLogout()
    {
        await AuthService.SignOutAsync();
        Navigation.NavigateTo("/login", forceLoad: true);
    }
}
