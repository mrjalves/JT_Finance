<nav class="sidebar @(IsExpanded ? "expanded" : "")">
    <div class="sidebar-brand">
        <a href="" class="brand-link">
            <i class="bi-bank2"></i>
            <span class="brand-text">JT_Finance</span>
        </a>

        <button class="toggle-button" @onclick="Toggle" title="@(IsExpanded ? "Minimizar Menu" : "Expandir Menu")">
            <i class="@(IsExpanded ? "bi-arrow-left-circle-fill" : "bi-arrow-right-circle-fill")"></i>
        </button>
    </div>

    <ul class="sidebar-nav">
        <li class="nav-item">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All" title="Home">
                <i class="bi-house-door-fill"></i>
                <span class="nav-text">Home</span>
            </NavLink>
        </li>
        <li class="nav-item">
            <NavLink class="nav-link" href="historico" Match="NavLinkMatch.All" title="Histórico">
                <i class="bi-calendar-fill"></i>
                <span class="nav-text">Histórico</span>
            </NavLink>
        </li>
        <li class="nav-item">
            <NavLink class="nav-link" href="receitas" title="Receitas">
                <i class="bi-graph-up-arrow"></i>
                <span class="nav-text">Receitas</span>
            </NavLink>
        </li>
        <li class="nav-item">
            <NavLink class="nav-link" href="despesas" title="Despesas">
                <i class="bi-graph-down-arrow"></i>
                <span class="nav-text">Despesas</span>
            </NavLink>
        </li>
        <li class="nav-item">
            <NavLink class="nav-link" href="cartoes-credito" title="Cartões de Crédito">
                <i class="bi-credit-card-fill"></i>
                <span class="nav-text">Cartões</span>
            </NavLink>
        </li>
        <li class="nav-item">
            <NavLink class="nav-link" href="listacompras" title="Lista de Compras">
                <i class="bi-cart-fill"></i>
                <span class="nav-text">Lista Compras</span>
            </NavLink>
        </li>
        <li class="nav-item">
            <NavLink class="nav-link" href="gerenciar-categorias" title="Gerenciar Categorias">
                <i class="bi-tags-fill"></i>
                <span class="nav-text">Categorias</span>
            </NavLink>
        </li>
    </ul>

    <div class="sidebar-footer">
        <a href="configuracoes" class="nav-link" title="Configurações">
            <i class="bi-gear-fill"></i>
            <span class="nav-text">Configurações</span>
        </a>
    </div>
</nav>

@code {
    [Parameter]
    public bool IsExpanded { get; set; }

    [Parameter]
    public EventCallback OnToggle { get; set; }

    private async Task Toggle()
    {
        await OnToggle.InvokeAsync();
    }
}