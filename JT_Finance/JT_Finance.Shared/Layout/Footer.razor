@using JT_Finance.Shared.Services
@inject IFormFactor FormFactor

<footer class="app-footer">
    <div class="container-fluid">
        <span class="footer-item">
            <a href="logs">Logs do Sistema</a>
        </span>
        <span class="footer-item">
            Versão: @AppVersion
        </span>
        <span class="footer-item">
            Plataforma: @CurrentPlatform
        </span>
    </div>
</footer>

@code {
    private string AppVersion { get; set; } = "1.0.0-beta"; // Mock version
    private string CurrentPlatform => FormFactor.GetPlatform();

  
}
