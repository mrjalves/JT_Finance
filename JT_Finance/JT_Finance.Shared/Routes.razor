@using Microsoft.AspNetCore.Components.Routing
@using JT_UserInterface.Shared.Layout

<Router AppAssembly="typeof(JT_Finance.Shared._Imports).Assembly" AdditionalAssemblies="new[] { typeof(JT_UserInterface.Shared._Imports).Assembly }">
    <Found Context="routeData">
        <RouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)" />
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
    <NotFound>
        <PageTitle>Página não encontrada</PageTitle>
        <LayoutView Layout="typeof(MainLayout)">
            <div class="container py-5 text-center">
                <div class="card p-5 shadow-sm border-0 mx-auto" style="max-width: 500px; border-radius: 1rem;">
                    <i class="bi bi-compass text-primary display-1 mb-3"></i>
                    <h2 class="fw-bold mb-2">404 - Página Não Encontrada</h2>
                    <p class="text-muted mb-4">A página requisitada não existe ou mudou de endereço no sistema financeiro.</p>
                    <a href="/" class="btn btn-primary btn-lg rounded-pill px-4">
                        <i class="bi bi-house-door me-2"></i>Ir para o Dashboard
                    </a>
                </div>
            </div>
        </LayoutView>
    </NotFound>
</Router>