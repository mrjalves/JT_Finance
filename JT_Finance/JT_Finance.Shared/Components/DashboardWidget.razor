@using JT_Classes.Financeiro
@using JT_Finance.Shared.Services.Dashboard
@using JT_UserInterface.Shared.Components.Core.Charts

<div class="card shadow h-100 dashboard-widget">
    <div class="card-body d-flex flex-column">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <h6 class="mb-0 fw-semibold text-muted text-uppercase small">@Resultado.Titulo</h6>
            <i class="bi @Resultado.Icone fs-4 text-muted"></i>
        </div>

        @if (Resultado.Formato == eDashboardFormato.Card)
        {
            <div class="d-flex align-items-center flex-grow-1">
                <div class="fs-3 fw-bold text-gray-800">@Resultado.Valor</div>
            </div>
        }
        else if (Resultado.SemDados || !Resultado.Datasets.Any() || !Resultado.Datasets.First().Data.Any())
        {
            <div class="d-flex flex-column align-items-center justify-content-center flex-grow-1 text-muted py-3">
                <i class="bi @Resultado.Icone fs-2 text-muted"></i>
                <p class="mt-2 mb-0 small">Sem dados para este mês.</p>
            </div>
        }
        else
        {
            <div class="flex-grow-1">
                <Chart ChartId="@ChartId"
                       Type="@TipoChartEnum"
                       Labels="@Resultado.Labels"
                       Datasets="@Resultado.Datasets"
                       Title="@Resultado.Titulo" />
            </div>
        }
    </div>
</div>

@code {
    [Parameter]
    public string ChartId { get; set; } = Guid.NewGuid().ToString("N");

    [Parameter]
    public DashboardIndicadorResultado Resultado { get; set; } = new();

    private ChartType TipoChartEnum => (Resultado.TipoGrafico ?? "bar").ToLower() switch
    {
        "line" => ChartType.Line,
        "pie" => ChartType.Pie,
        "doughnut" => ChartType.Doughnut,
        "radar" => ChartType.Radar,
        _ => ChartType.Bar
    };
}
