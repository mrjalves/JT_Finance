@using JT_Finance.Shared.Services
@implements IDisposable
@inject ToastService ToastService

@if (_isVisible)
{
    <div class="@($"toast-single fade {_animationClass}")" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="@($"toast-header {_toastLevelCssClass}")">
            <strong class="me-auto">@Settings.Heading</strong>
            <small class="text-muted ms-2">@TimeAgo(Settings.Timestamp)</small>
            <button type="button" class="btn-close @(_toastLevelCssClass.Contains("text-white") ? "btn-close-white" : "")" @onclick="Close" aria-label="Close"></button>
        </div>
        <div class="toast-body">
            @Settings.Message
        </div>
        @if (Settings.DurationInSeconds > 0)
        {
            <div class="toast-progress" style="width: @_progressWidth%;"></div>
        }
    </div>
}

@code {
    [Parameter] public ToastSettings Settings { get; set; }

    private bool _isVisible = false;
    private string _animationClass = "";
    private string _toastLevelCssClass = "";
    private Timer _timer;
    private Timer _progressTimer;
    private double _progressWidth = 100;
    private const int ProgressUpdateIntervalMs = 50; // Intervalo para atualizar a barra de progresso

    protected override void OnInitialized()
    {
        _toastLevelCssClass = GetToastLevelCssClass(Settings.Level);
        // A visibilidade inicial e a configuração do timer serão feitas em OnAfterRenderAsync
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Inicia a animação de entrada
            _isVisible = true;
            // Primeiro renderiza o toast como visível mas sem a classe 'show'
            await InvokeAsync(StateHasChanged);

            // Pequeno atraso para garantir que o navegador processou a renderização anterior
            await Task.Delay(10);
            _animationClass = "show"; // Ativa a animação de fade-in

            if (Settings.DurationInSeconds > 0)
            {
                _timer = new Timer(CloseAfterDelay, null, Settings.DurationInSeconds * 1000, Timeout.Infinite);
                _progressTimer = new Timer(UpdateProgress, null, 0, ProgressUpdateIntervalMs);
            }
            // Notifica o Blazor para re-renderizar com a classe de animação e potencialmente iniciar os timers
            await InvokeAsync(StateHasChanged);
        }
    }

    private void UpdateProgress(object state)
    {
        if (!_isVisible || Settings.DurationInSeconds <= 0)
        {
            _progressTimer?.Change(Timeout.Infinite, Timeout.Infinite); // Para o timer
            return;
        }

        var elapsedTimeMs = (DateTime.Now - Settings.Timestamp).TotalMilliseconds;
        var totalDurationMs = Settings.DurationInSeconds * 1000;

        _progressWidth = Math.Max(0, 100 - (elapsedTimeMs / totalDurationMs * 100));

        if (_progressWidth <= 0)
        {
             _progressWidth = 0;
            _progressTimer?.Change(Timeout.Infinite, Timeout.Infinite); // Para o timer
        }
        InvokeAsync(StateHasChanged);
    }


    private void CloseAfterDelay(object state)
    {
        InvokeAsync(Close);
    }

    public async Task Close()
    {
        _animationClass = ""; // Triggers fade-out
        await InvokeAsync(StateHasChanged);

        // Espera a animação de fade-out terminar antes de remover do serviço
        await Task.Delay(200); // Deve ser igual ou maior que a duração da transição CSS
        _isVisible = false; // Marcar como não visível pode ajudar a evitar interações enquanto o container o remove.
        ToastService.RemoveToast(Settings.Id); // Notifica o serviço para remover este toast da lista global.
                                              // O ToastContainer irá re-renderizar e remover este componente.
                                              // A chamada StateHasChanged() anterior aqui foi removida,
                                              // pois o componente pode já ter sido descartado pelo seu pai (ToastContainer)
                                              // após a chamada a ToastService.RemoveToast.
    }

    private string GetToastLevelCssClass(ToastLevel level)
    {
        return level switch
        {
            ToastLevel.Success => "bg-success text-white",
            ToastLevel.Error => "bg-danger text-white",
            ToastLevel.Warning => "bg-warning text-dark", // text-dark para melhor contraste com amarelo
            ToastLevel.Info => "bg-info text-white",
            _ => "bg-light text-dark" // Default
        };
    }

    private string TimeAgo(DateTime timestamp)
    {
        var timespan = DateTime.Now - timestamp;
        if (timespan.TotalSeconds < 60) return $"{(int)timespan.TotalSeconds}s ago";
        if (timespan.TotalMinutes < 60) return $"{(int)timespan.TotalMinutes}m ago";
        if (timespan.TotalHours < 24) return $"{(int)timespan.TotalHours}h ago";
        return $"{timestamp:g}";
    }

    public void Dispose()
    {
        _timer?.Dispose();
        _progressTimer?.Dispose();
    }
}
