@using JT_Classes.Financeiro
@using JT_UserInterface.Shared.Models
@using JT_Finance.Shared.Services.Interfaces

@* 1. Injetamos os serviços que criámos nas refatorações anteriores *@
@inject IDespesaService DespesaService

@* Assumo que tenhas uma interface semelhante para as Receitas.
   Se usares diretamente o serviço base, podes mudar para: @inject JT_Servicos.Financeiro.ReceitaService ReceitaService *@
@inject IReceitaService ReceitaService

<div class="row mb-4">
    <div class="col-12">
        @* 2. Magia! Toda a interface complexa foi reduzida a esta única linha.
              Dizemos ao calendário: "Quando precisares de dados, chama esta função" *@
        <CalendarioBase OnLoadEvents="CarregarEventosFinanceirosAsync" />
    </div>
</div>

@code {
    /// <summary>
    /// Este método é acionado pelo CalendarioBase (no OnInitialized e ao mudar de mês).
    /// Ele recebe a data de referência que o calendário quer mostrar, e devolve a lista de eventos.
    /// </summary>
    private async Task<List<EventoCalendario>> CarregarEventosFinanceirosAsync(DateTime mesReferencia)
    {
        var eventos = new List<EventoCalendario>();

        // 3. Buscamos os dados de forma assíncrona, usando as boas práticas implementadas
        var despesas = await DespesaService.ObterDespesasMesAsync(mesReferencia);

        // *Nota: Ajusta o nome do método de Receita se for diferente na tua IReceitaService
        var receitas = await ReceitaService.ObterReceitasMesAsync(mesReferencia);

        // 4. Mapeamos as Despesas para o modelo de Eventos do Calendário
        if (despesas != null && despesas.Any())
        {
            eventos.AddRange(despesas.Select(d => new EventoCalendario
            {
                Data = d.DataDespesa,
                Descricao = d.Descricao,
                Valor = d.Valor,
                Tipo = TipoEvento.Despesa
            }));
        }

        // 5. Mapeamos as Receitas para o modelo de Eventos do Calendário
        if (receitas != null && receitas.Any())
        {
            eventos.AddRange(receitas.Select(r => new EventoCalendario
            {
                Data = r.DataReceita,
                Descricao = r.Descricao,
                Valor = r.Valor,
                Tipo = TipoEvento.Receita
            }));
        }

        return eventos;
    }
}


