@using JT_Aplicacao
@using JT_Classes
@using JT_Classes.Financeiro
@using JT_Classes.structs
@using JT_Finance.Shared.Services.Interfaces
@using JT_UserInterface.Shared.Components.Core
@using JT_UserInterface.Shared.Services.Interfaces
@inject IDespesaService DespesaService
@inject ICartaoCreditoService CartoesService
@inject JT_UserInterface.Shared.Services.Interfaces.Comum.ICategoriaService CategoriaService
@using static JT_UserInterface.Shared.Components.Core.Modal
<Modal @ref="ModalRef" Title="@Title" OnClose="OnClose" Size="ModalSize.Large" CloseOnBackdropClick="false" EnableIA="true" EntidadeContexto="@Despesa" NomeEntidade="Despesa">
    <BodyContent>
        @if (Despesa != null)
        {
            <EditForm Model="Despesa" OnValidSubmit="HandleSubmit">
                <DataAnnotationsValidator />
                <div class="form-check form-switch mb-3">
                    <InputCheckbox id="isCardExpense" class="form-check-input" @bind-Value="Despesa.EhDespesaCartaoCredito" />
                    <label class="form-check-label" for="isCardExpense">É uma despesa de Cartão de Crédito?</label>
                </div>
                <hr />

                <div class="row">
                    <div class="col-md-12 mb-3">
                        <label for="descricao" class="form-label">Descrição</label>
                        <InputText id="descricao" class="form-control" @bind-Value="Despesa.Descricao" />
                        <ValidationMessage For="@(() => Despesa.Descricao)" />
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label for="valor" class="form-label">Valor</label>
                        <InputNumber id="valor" step="0.01" class="form-control" @bind-Value="Despesa.Valor" />
                        <ValidationMessage For="@(() => Despesa.Valor)" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label for="data_despesa" class="form-label">Data da Despesa</label>
                        <InputDate id="data_despesa" class="form-control" @bind-Value="Despesa.DataDespesa" />
                        <ValidationMessage For="@(() => Despesa.DataDespesa)" />
                    </div>
                </div>
                @if (Despesa.EhDespesaCartaoCredito && Despesa.DetalhesCartaoCredito != null)
                {
                    <div class="row p-3 mb-3 bg-light border rounded animate__animated animate__fadeIn">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Cartão de Crédito</label>
                            <JT_UserInterface.Shared.Components.Core.SeletorPesquisa TItem="sCartao"
                                             TituloPesquisa="Selecionar Cartão"
                                             Itens="CartoesCredito"
                                             Colunas="@(new Dictionary<string, string> { { "ID", "Id" }, { "Nome do Cartão", "Nome" }, { "Limite", "Limite" } })"
                                             ObterCodigo="@(c => c.Id.ToString())"
                                             ObterDescricao="@(c => c.Nome)"
                                             ValorSelecionado="cartaoSelecionado"
                                             ValorSelecionadoChanged="OnCartaoSelecionado" />
                            <ValidationMessage For="@(() => Despesa.DetalhesCartaoCredito.IdCartao)" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="parcelas" class="form-label">Quantidade de Parcelas</label>
                            <InputNumber id="parcelas" class="form-control" @bind-Value="Despesa.DetalhesCartaoCredito.QuantidadeParcelas" />
                            <ValidationMessage For="@(() => Despesa.DetalhesCartaoCredito.QuantidadeParcelas)" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="data_vencimento_fatura" class="form-label">Data Vencimento Fatura (Primeira Parcela)</label>
                            <InputDate id="data_vencimento_fatura" class="form-control" @bind-Value="Despesa.DetalhesCartaoCredito.DataVencimento" />
                            <ValidationMessage For="@(() => Despesa.DetalhesCartaoCredito.DataVencimento)" />
                        </div>
                    </div>
                }
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label for="tipo_despesa" class="form-label">Tipo de Despesa</label>
                        <div class="input-group">
                            <InputSelect id="tipo_despesa" class="form-select" @bind-Value="Despesa.TipoDespesa" disabled="@showNewTipoForm">
                                <option value="0">Selecione um tipo...</option>
                                @if (TiposDespesa != null)
                                {
                                    @foreach (var tipo in TiposDespesa)
                                    {
                                        <option value="@tipo.Id">@tipo.Descricao</option>
                                    }
                                }
                            </InputSelect>
                            <button class="btn btn-outline-secondary" type="button" @onclick='() => ToggleInlineForm("TipoDespesa")' title="Adicionar Novo Tipo">
                                <i class="bi bi-plus-lg"></i>
                            </button>
                        </div>
                        <ValidationMessage For="@(() => Despesa.TipoDespesa)" />

                        @if (showNewTipoForm)
                        {
                            <div class="input-group mt-2 animate__animated animate__fadeIn">
                                <InputText @bind-Value="novaCategoriaDescricao" class="form-control" placeholder="Nova descrição para Tipo..." />
                                <button type="button" class="btn btn-success" @onclick='() => SalvarNovaCategoria("TipoDespesa")'>Salvar</button>
                                <button type="button" class="btn btn-secondary" @onclick='() => ToggleInlineForm("TipoDespesa")'>Cancelar</button>
                            </div>
                        }
                    </div>

                    <div class="col-md-6 mb-3">
                        <label for="categoria" class="form-label">Categoria</label>
                        <div class="input-group">
                            <InputSelect id="categoria" class="form-select" @bind-Value="Despesa.Categoria" disabled="@showNewCategoriaForm">
                                <option value="0">Selecione uma categoria...</option>
                                @if (CategoriasDespesa != null)
                                {
                                    @foreach (var cat in CategoriasDespesa)
                                    {
                                        <option value="@cat.Id">@cat.Descricao</option>
                                    }
                                }
                            </InputSelect>
                            <button class="btn btn-outline-secondary" type="button" @onclick='() => ToggleInlineForm("Categoria")' title="Adicionar Nova Categoria">
                                <i class="bi bi-plus-lg"></i>
                            </button>
                        </div>
                        <ValidationMessage For="@(() => Despesa.Categoria)" />

                        @if (showNewCategoriaForm)
                        {
                            <div class="input-group mt-2 animate__animated animate__fadeIn">
                                <InputText @bind-Value="novaCategoriaDescricao" class="form-control" placeholder="Nova descrição para Categoria..." />
                                <button type="button" class="btn btn-success" @onclick='() => SalvarNovaCategoria("Categoria")'>Salvar</button>
                                <button type="button" class="btn btn-secondary" @onclick='() => ToggleInlineForm("Categoria")'>Cancelar</button>
                            </div>
                        }
                    </div>
                </div>

                <div class="form-group mb-3">
                    <label for="observacao" class="form-label">Observação</label>
                    <InputTextArea id="observacao" class="form-control" @bind-Value="Despesa.Observacao" rows="3" />
                    <ValidationMessage For="@(() => Despesa.Observacao)" />
                </div>

                <div class="row align-items-center">
                    <div class="col-md-6 mb-3">
                        <div class="form-check form-switch">
                            <InputCheckbox id="paga" class="form-check-input" @bind-Value="Despesa.DespesaPaga" />
                            <label class="form-check-label" for="paga">Despesa já foi paga?</label>
                        </div>
                    </div>
                    @if (Despesa.DespesaPaga)
                    {
                        <div class="col-md-6 mb-3">
                            <label for="data_pagamento" class="form-label">Data de Pagamento</label>
                            <InputDate id="data_pagamento" class="form-control" @bind-Value="Despesa.DataPagamento" />
                            <ValidationMessage For="@(() => Despesa.DataPagamento)" />
                        </div>
                    }
                </div>

                <hr />

                <div class="d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-secondary" @onclick="HandleCancel">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Salvar</button>
                </div>
            </EditForm>
        }
        else
        {
            <p>Carregando formulário...</p>
        }
    </BodyContent>
</Modal>




