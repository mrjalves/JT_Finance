@namespace JT_Finance.Shared.Components

﻿
<!--
    Componente que representa uma única aba dentro de um TabControl.
-->
<CascadingValue Value="this">
    @if (Parent?.IsActive(this) == true)
    {
        @ChildContent
    }
</CascadingValue>

@code {
    [CascadingParameter]
    protected TabControl? Parent { get; set; }

    /// <summary>
    /// O título da aba, que será exibido na navegação do TabControl.
    /// </summary>
    [Parameter]
    public string? Title { get; set; }

    /// <summary>
    /// O conteúdo a ser exibido quando esta aba estiver ativa.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    protected override void OnInitialized()
    {
        if (Parent == null)
        {
            throw new ArgumentNullException(nameof(Parent), "TabPage must exist within a TabControl.");
        }
        Parent.AddPage(this);
    }
}
