@using JT_Finance.Shared.Models
@using JT_Finance.Shared.Services.Interfaces
@inject INotificationService NotificationService
@implements IDisposable

<div class="notification-icon dropdown">
    <a href="#" class="dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
        <i class="bi bi-bell action-icon"></i>
        @if (unreadCount > 0)
        {
            <span class="badge bg-danger rounded-pill">@unreadCount</span>
        }
    </a>
    <ul class="dropdown-menu dropdown-menu-end">
        @if (notifications.Any())
        {
            foreach (var notification in notifications)
            {
                <li><a class="dropdown-item" href="#">@notification.Message</a></li>
            }
        }
        else
        {
            <li><span class="dropdown-item-text">Nenhuma notificação</span></li>
        }
    </ul>
</div>

@code {
    private int unreadCount;
    private List<Notification> notifications = new();

    protected override async Task OnInitializedAsync()
    {
        NotificationService.OnChange += OnNotificationChanged;
        await LoadDataAsync();
    }

    private async void OnNotificationChanged()
    {
        await LoadDataAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadDataAsync()
    {
        unreadCount = NotificationService.GetUnreadCount();
        notifications = await NotificationService.GetNotificationsAsync();
    }

    public void Dispose()
    {
        NotificationService.OnChange -= OnNotificationChanged;
    }
}
