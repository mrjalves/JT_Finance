@inject IJSRuntime JSRuntime

<div class="chart-container" style="position: relative; min-height: 350px; width: 100%;">
    <canvas id="@ChartId"></canvas>
</div>

@code {
    [Parameter]
    public string ChartId { get; set; } = "myChart";

    [Parameter]
    public ChartType Type { get; set; } = ChartType.Bar;

    [Parameter]
    public List<string> Labels { get; set; } = new();

    [Parameter]
    public List<ChartDataset> Datasets { get; set; } = new();

    [Parameter]
    public string Title { get; set; } = "Meu Gráfico";

    // Usado para evitar re-renderização desnecessária
    private int _dataHash; 

    protected override async Task OnParametersSetAsync()
    {
        // Só renderiza se os dados existirem e tiverem mudado
        if (Datasets.Any() && Datasets.First().Data.Any())
        {
            var newDataHash = System.Text.Json.JsonSerializer.Serialize(Datasets).GetHashCode();
            if (newDataHash != _dataHash)
            {
                _dataHash = newDataHash;
                await RenderChart();
            }
        }
    }

    public async Task RenderChart()
    {
        if (JSRuntime != null)
        {
            await JSRuntime.InvokeVoidAsync("blazorCharts.createChart",
                ChartId,
                Type.ToString().ToLower(),
                Labels,
                Datasets,
                Title);
        }
    }
}
