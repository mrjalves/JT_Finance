@inject IJSRuntime JSRuntime

<div class="chart-container" style="position: relative; min-height: 350px; width: 100%;">
    <canvas id="@ChartId"></canvas>
</div>

@code {
    [Parameter]
    public string ChartId { get; set; } = "myChart";

    [Parameter]
    public ChartType Type { get; set; } = ChartType.Bar;

    [Parameter]
    public List<string> Labels { get; set; } = new();

    [Parameter]
    public List<ChartDataset> Datasets { get; set; } = new();

    [Parameter]
    public string Title { get; set; } = "Meu Gráfico";

    // Usado para evitar re-renderização desnecessária
    private int _dataHash;

    // ----- CÓDIGO CORRIGIDO ABAIXO -----

    // OnAfterRenderAsync é o lugar correto para interações com JavaScript que manipulam o DOM.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Garante que existem dados para renderizar.
        if (Datasets.Any() && Datasets.First().Data.Any())
        {
            // Calcula um hash para verificar se os dados foram alterados.
            var newDataHash = System.Text.Json.JsonSerializer.Serialize(Datasets).GetHashCode();

            // Renderiza o gráfico na primeira vez ou sempre que os dados mudarem.
            // Esta é a condição mais robusta.
            if (firstRender || newDataHash != _dataHash)
            {
                _dataHash = newDataHash; // Atualiza o hash com os novos dados.
                await RenderChart();
            }
        }
    }

    public async Task RenderChart()
    {
        if (JSRuntime != null)
        {
            await JSRuntime.InvokeVoidAsync("blazorCharts.createChart",
                ChartId,
                Type.ToString().ToLower(),
                Labels,
                Datasets,
                Title);
        }
    }
}
