@using JT_Classes
@using JT_Classes.Financeiro

<DataGrid TItem="Receita" Items="Receitas" IsLoading="IsLoading">
    <HeaderTemplate>
        <th>Descrição</th>
        <th>Valor</th>
        <th>Data</th>
        <th>Categoria</th>
        <th>Tipo</th>
        <th>Recebida</th>
        <th class="text-end">Ações</th>
    </HeaderTemplate>
    <RowTemplate Context="receita">
        @if (IsLoading)
        {
            <Loading />
        }
        else
        {
            
            <td>@receita.Descricao</td>
            <td>@receita.Valor.ToString("C")</td>
            <td>@receita.DataReceita.ToShortDateString()</td>
            <td>@(opcoesCategoriaReceita.FirstOrDefault(c => c.Id == receita.Categoria)?.Descricao)</td>
            <td>@(opcoesTipoReceita.FirstOrDefault(c => c.Id == receita.TipoReceita)?.Descricao)</td>
            <td>
                @if (receita.ReceitaRecebida)
                {
                    <span class="badge bg-success">Sim</span>
                }
                else
                {
                    <span class="badge bg-secondary">Não</span>
                }
            </td>
            <td class="text-end">
                <button class="btn btn-sm btn-outline-success me-2" title="Duplicar Receita" @onclick="() => OnDuplicar.InvokeAsync(receita)" @onclick:stopPropagation="true">
                    <i class="bi bi-copy"></i>
                </button>

                <button class="btn btn-sm btn-outline-primary me-2" @onclick="() => OnEditar.InvokeAsync(receita)" @onclick:stopPropagation="true">
                    <i class="bi bi-pencil-fill me-1"></i>
                </button>
                <button class="btn btn-sm btn-outline-danger" @onclick="() => OnRemover.InvokeAsync(receita.Id)" @onclick:stopPropagation="true">
                    <i class="bi bi-trash-fill me-1"></i>
                </button>
            </td>
        }

    </RowTemplate>
    <EmptyTemplate>
        <p class="text-muted mb-0">Nenhuma receita cadastrada ainda. Clique em "Nova Receita" para começar.</p>
    </EmptyTemplate>
</DataGrid>

@code {

    #region PARAMETROS
    [Parameter]
    public List<Receita> Receitas { get; set; } = new();

    [Parameter]
    public bool IsLoading { get; set; }

    [Parameter]
    public EventCallback<Receita> OnEditar { get; set; }

    [Parameter]
    public EventCallback<int> OnRemover { get; set; }
    [Parameter]
    public EventCallback<Receita> OnDuplicar { get; set; }
    [Parameter]
    public List<Categoria>? opcoesTipoReceita { get; set; }
    [Parameter]
    public List<Categoria>? opcoesCategoriaReceita { get; set; }
    #endregion

  
}