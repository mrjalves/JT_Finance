@using JT_Aplicacao
@using JT_Classes
@using JT_Classes.Financeiro
@using JT_Finance.Shared.Models
@using JT_Finance.Shared.Services.Interfaces
@using JT_UserInterface.Shared.Services.Interfaces
@inject IReceitaService ReceitaService
@inject FiltroService FiltroService

<div class="card border-left-success shadow h-80 py-2">
    <DataGrid TItem="Receita"
              Items="ItensBase"
              IsLoading="IsLoading"
              SortSelectors="SortSelectors"
              ViewportMaxHeight="calc(100vh - 17rem)">
        <SortableHeaderTemplate Context="ctx">
            <th role="button" @onclick="() => ctx.SortBy(KeyDescricao)">
                Descrição
                @if (ctx.IsSortedBy(KeyDescricao))
                {
                    <span class="ms-1">@((ctx.Direction == DataGrid<Receita>.SortDirection.Asc) ? "▲" : "▼")</span>
                }
            </th>
            <th role="button" @onclick="() => ctx.SortBy(KeyValor)">
                Valor
                @if (ctx.IsSortedBy(KeyValor))
                {
                    <span class="ms-1">@((ctx.Direction == DataGrid<Receita>.SortDirection.Asc) ? "▲" : "▼")</span>
                }
            </th>
            <th role="button" @onclick="() => ctx.SortBy(KeyData)">
                Data
                @if (ctx.IsSortedBy(KeyData))
                {
                    <span class="ms-1">@((ctx.Direction == DataGrid<Receita>.SortDirection.Asc) ? "▲" : "▼")</span>
                }
            </th>
            <th role="button" @onclick="() => ctx.SortBy(KeyCategoria)">
                Categoria
                @if (ctx.IsSortedBy(KeyCategoria))
                {
                    <span class="ms-1">@((ctx.Direction == DataGrid<Receita>.SortDirection.Asc) ? "▲" : "▼")</span>
                }
            </th>
            <th role="button" @onclick="() => ctx.SortBy(KeyTipo)">
                Tipo
                @if (ctx.IsSortedBy(KeyTipo))
                {
                    <span class="ms-1">@((ctx.Direction == DataGrid<Receita>.SortDirection.Asc) ? "▲" : "▼")</span>
                }
            </th>
            <th role="button" @onclick="() => ctx.SortBy(KeyRecebida)">
                Recebida
                @if (ctx.IsSortedBy(KeyRecebida))
                {
                    <span class="ms-1">@((ctx.Direction == DataGrid<Receita>.SortDirection.Asc) ? "▲" : "▼")</span>
                }
            </th>
            <th class="text-end">Ações</th>
        </SortableHeaderTemplate>

        <RowTemplate Context="receita">
            <td>@receita.Descricao</td>
            <td>@receita.Valor.ToString("C")</td>
            <td>@receita.DataReceita.ToShortDateString()</td>
            <td>@(CategoriasReceita.FirstOrDefault(c => c.Id == receita.Categoria)?.Descricao)</td>
            <td>@(TiposReceita.FirstOrDefault(c => c.Id == receita.TipoReceita)?.Descricao)</td>
            <td>
                @if (receita.ReceitaRecebida)
                {
                    <span class="badge bg-success">Sim</span>
                }
                else
                {
                    <span class="badge bg-secondary">Não</span>
                }
            </td>
            <td class="text-end">
                @if (!receita.ReceitaRecebida)
                {
                    <button class="btn btn-sm btn-success me-2"
                            title="Marcar como recebida"
                            @onclick="() => MarcarComoRecebidaAsync(receita)"
                            @onclick:stopPropagation="true">
                        <i class="bi bi-check2-circle"></i>
                    </button>
                }

                <button class="btn btn-sm btn-outline-success me-2" title="Duplicar Receita" @onclick="() => OnDuplicar.InvokeAsync(receita)" @onclick:stopPropagation="true">
                    <i class="bi bi-copy"></i>
                </button>

                <button class="btn btn-sm btn-outline-primary me-2" @onclick="() => OnEditar.InvokeAsync(receita)" @onclick:stopPropagation="true">
                    <i class="bi bi-pencil-fill me-1"></i>
                </button>
                <button class="btn btn-sm btn-outline-danger" @onclick="() => OnRemover.InvokeAsync(receita.Id)" @onclick:stopPropagation="true">
                    <i class="bi bi-trash-fill me-1"></i>
                </button>
            </td>
        </RowTemplate>
        <EmptyTemplate>
            <p class="text-muted mb-0">Nenhuma receita cadastrada ainda. Clique em "Nova Receita" para começar.</p>
        </EmptyTemplate>
    </DataGrid>

    <!-- Totais -->
    <div class="card-footer totals-footer d-flex flex-wrap gap-3 justify-content-between align-items-center">
        <div class="d-flex flex-wrap gap-3">
            <span><strong>Itens:</strong> @QtdReceitas</span>
            <span><strong>Total:</strong> @TotalReceitas.ToString("C")</span>
            <span class="text-success"><strong>Recebidas:</strong> @TotalRecebidas.ToString("C")</span>
            <span class="text-warning"><strong>Pendentes:</strong> @TotalPendentes.ToString("C")</span>
        </div>
    </div>
</div>
