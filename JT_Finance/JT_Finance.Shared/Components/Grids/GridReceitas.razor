@using JT_Aplicacao
@using JT_Classes
@using JT_Classes.Financeiro
@using JT_Finance.Shared.Models
@using JT_Finance.Shared.Services.Interfaces
@using JT_UserInterface.Shared.Components.Core
@using JT_UserInterface.Shared.Services.Interfaces.Comum
@using JT_UserInterface.Shared.Services.Comum
@inject IReceitaService ReceitaService
@inject ICategoriaService CategoriaService
@inject FiltroService FiltroService

<div class="card border-left-success shadow h-80 py-2">
    <DataGrid TItem="Receita"
              Items="ItensPaginados"
              Columns="gridColumns"
              IsLoading="IsLoading"
              SortSelectors="SortSelectors"
              PageSize="@PageSize"
              TotalItems="QtdReceitas"
              CurrentPage="CurrentPage"
              OnPageChanged="MudarPagina"
              UseServerPagination="true"
              EnableIA="true"
              NomeEntidade="Receita"
              EnableSearch="true"
              OnSearchChanged="AplicarPesquisa"
              ShowFilterButton="true"
              EnableColumnToggle="true">
        <EmptyTemplate>
            <p class="text-muted mb-0">Nenhuma receita cadastrada ainda. Clique em "Nova Receita" para começar.</p>
        </EmptyTemplate>
    </DataGrid>

    <!-- Totais -->
    <div class="card-footer totals-footer d-flex flex-wrap gap-3 justify-content-between align-items-center">
        <div class="d-flex flex-wrap gap-3">
            <span><strong>Itens:</strong> @QtdReceitas</span>
            <span><strong>Total:</strong> @TotalReceitas.ToString("C")</span>
            <span class="text-success"><strong>Recebidas:</strong> @TotalRecebidas.ToString("C")</span>
            <span class="text-warning"><strong>Pendentes:</strong> @TotalPendentes.ToString("C")</span>
        </div>
    </div>
</div>

@code {
    private void InicializarColunas()
    {
        gridColumns.Add(new DataGridColumn<Receita>(KeyDescricao, "Descrição") { CellTemplate = r => @<text>@r.Descricao</text> });
        gridColumns.Add(new DataGridColumn<Receita>(KeyValor, "Valor") { CellTemplate = r => @<text>@r.Valor.ToString("C")</text> });
        gridColumns.Add(new DataGridColumn<Receita>(KeyData, "Data") { CellTemplate = r => @<text>@r.DataReceita.ToShortDateString()</text> });
        gridColumns.Add(new DataGridColumn<Receita>(KeyCategoria, "Categoria") { CellTemplate = r => @<text>@(CategoriasReceita.FirstOrDefault(c => c.Id == r.Categoria).Descricao)</text> });
        gridColumns.Add(new DataGridColumn<Receita>(KeyTipo, "Tipo") { CellTemplate = r => @<text>@(TiposReceita.FirstOrDefault(c => c.Id == r.TipoReceita).Descricao)</text> });
        gridColumns.Add(new DataGridColumn<Receita>(KeyRecebida, "Recebida") { 
            CellTemplate = r => r.ReceitaRecebida ? @<span class="badge bg-success">Sim</span> : @<span class="badge bg-secondary">Não</span>
        });
        gridColumns.Add(new DataGridColumn<Receita>("Acoes", "Ações", sortable: false) {
            CellTemplate = r => @<text>
                @if (!r.ReceitaRecebida)
                {
                    <button class="btn btn-sm btn-success me-2" title="Marcar como recebida" @onclick="() => MarcarComoRecebidaAsync(r)" @onclick:stopPropagation="true">
                        <i class="bi bi-check2-circle"></i>
                    </button>
                }
                <button class="btn btn-sm btn-outline-success me-2" title="Duplicar Receita" @onclick="() => OnDuplicar.InvokeAsync(r)" @onclick:stopPropagation="true">
                    <i class="bi bi-copy"></i>
                </button>
                <button class="btn btn-sm btn-outline-primary me-2" title="Editar (@HotkeysDisplay.Atalho("editar"))" @onclick="() => OnEditar.InvokeAsync(r)" @onclick:stopPropagation="true">
                    <i class="bi bi-pencil-fill me-1"></i>
                </button>
                <button class="btn btn-sm btn-outline-danger" title="Remover (@HotkeysDisplay.Atalho("deletar"))" @onclick="() => OnRemover.InvokeAsync(r.Id)" @onclick:stopPropagation="true">
                    <i class="bi bi-trash-fill me-1"></i>
                </button>
            </text>
        });
    }
}


