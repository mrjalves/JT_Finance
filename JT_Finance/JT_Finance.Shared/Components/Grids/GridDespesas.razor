@using JT_Aplicacao
@using JT_Classes
@using JT_Classes.Financeiro
@using JT_Classes.structs
@using JT_Finance.Shared.Models
@using JT_Finance.Shared.Services.Interfaces
@using JT_Servicos
@using JT_UserInterface.Shared.Services.Comum
@using JT_UserInterface.Shared.Services.Interfaces
@using JT_UserInterface.Shared.Components.Core
@inject IDespesaService DespesaService
@inject FiltroService FiltroService
@inject NavigationManager NavigationManager

<div class="card border-left-success shadow h-80 py-2">
<DataGrid TItem="sDespesa"
          Items="ItensPaginados"
          Columns="gridColumns"
          IsLoading="IsLoading"
          SortSelectors="SortSelectors"
          PageSize="PageSize"
          UseServerPagination="true"
          TotalItems="QtdDespesas"
          CurrentPage="CurrentPage"
          OnPageChanged="MudarPagina"
          EnableIA="true"
          NomeEntidade="Despesa"
          EnableSearch="true"
          OnSearchChanged="AplicarPesquisa"
          ShowFilterButton="true"
          EnableColumnToggle="true">
    <EmptyTemplate>
        <p class="text-muted mb-0">Nenhuma despesa encontrada. Tente ajustar os filtros ou cadastre uma nova despesa.</p>
    </EmptyTemplate>
</DataGrid>

<!-- Totais -->
<div class="card-footer totals-footer d-flex flex-wrap gap-3 justify-content-between align-items-center">
    <div class="d-flex flex-wrap gap-3">
        <span><strong>Itens:</strong> @QtdDespesas</span>
        <span><strong>Total:</strong> @TotalDespesas.ToString("C")</span>
        <span class="text-success"><strong>Pagas:</strong> @TotalPagas.ToString("C")</span>
        <span class="text-danger"><strong>Pendentes:</strong> @TotalPendentes.ToString("C")</span>
    </div>
</div>
</div>

@code {
    private List<DataGridColumn<sDespesa>> gridColumns = new();

    protected override void OnInitialized()
    {
        gridColumns.Add(new DataGridColumn<sDespesa>(KeyDescricao, "Descrição") { CellTemplate = d => @<text>@d.Descricao</text> });
        gridColumns.Add(new DataGridColumn<sDespesa>(KeyValor, "Valor") { CellTemplate = d => @<text>@d.Valor.ToString("C")</text> });
        gridColumns.Add(new DataGridColumn<sDespesa>(KeyData, "Data") { CellTemplate = d => @<text>@d.DataDespesa.ToShortDateString()</text> });
        
        gridColumns.Add(new DataGridColumn<sDespesa>(KeyVencimento, "Data Vencimento") { 
            CellTemplate = d => (d.EhDespesaCartaoCredito && d.DespCartaoCredito.DataVencimento != default) 
                ? @<text>@d.DespCartaoCredito.DataVencimento.ToShortDateString()</text> 
                : @<span class="text-muted">—</span> 
        });
        
        gridColumns.Add(new DataGridColumn<sDespesa>(KeyCategoria, "Categoria") { CellTemplate = d => @<text>@d.CategoriaStruct.Nome</text> });
        gridColumns.Add(new DataGridColumn<sDespesa>(KeyTipo, "Tipo") { CellTemplate = d => @<text>@d.TipoStruct.Nome</text> });
        
        gridColumns.Add(new DataGridColumn<sDespesa>(KeyCartaoParcela, "Cartão / Parcela") { 
            CellTemplate = d => {
                if (d.EhDespesaCartaoCredito && d.DespCartaoCredito.DataVencimento != default)
                {
                    return @<text><span class="d-block">@d.Cartao.Nome</span><small class="text-muted">@d.DespCartaoCredito.NumeroParcela</small></text>;
                }
                else
                {
                    return @<span class="text-muted">—</span>;
                }
            }
        });
        
        gridColumns.Add(new DataGridColumn<sDespesa>(KeyPaga, "Paga") { 
            CellTemplate = d => d.DespesaPaga ? @<span class="badge bg-success">Sim</span> : @<div class="d-flex align-items-center gap-2"><span class="badge bg-danger">Não</span></div>
        });
        
        gridColumns.Add(new DataGridColumn<sDespesa>("Acoes", "Ações", sortable: false) { 
            CellTemplate = d => @<text>
                @if (!d.EhDespesaCartaoCredito)
                {
                    @if (!d.DespesaPaga)
                    {
                        <button class="btn btn-sm btn-success me-2" title="Marcar como paga" @onclick="() => PagarDespesaAsync(d)" @onclick:stopPropagation="true">
                            <i class="bi bi-check2-circle"></i>
                        </button>
                    }
                    <button class="btn btn-sm btn-outline-success me-2" title="Duplicar Despesa" @onclick="() => OnDuplicar.InvokeAsync(d)" @onclick:stopPropagation="true">
                        <i class="bi bi-copy"></i>
                    </button>
                }
                else
                {
                    <button class="btn btn-sm btn-outline-primary me-2" title="Ver fatura desta despesa" @onclick="() => AbrirFaturaDoCartao(d)" @onclick:stopPropagation="true">
                        <i class="bi bi-receipt"></i>
                    </button>
                }
                @if (!HideActions)
                {
                    <button class="btn btn-sm btn-outline-primary me-2" @onclick="() => OnEditar.InvokeAsync(d.Id)" @onclick:stopPropagation="true">
                        <i class="bi bi-pencil-fill"></i>
                    </button>
                    <button class="btn btn-sm btn-outline-danger" @onclick="() => OnRemover.InvokeAsync(d.Id)" @onclick:stopPropagation="true">
                        <i class="bi bi-trash-fill"></i>
                    </button>
                }
            </text> 
        });
        
        base.OnInitialized();
    }
}
