@using JT_Aplicacao
@using JT_Classes
@using JT_Classes.Financeiro
@using JT_Classes.structs
@using JT_Finance.Shared.Models
@using JT_Finance.Shared.Services.Interfaces
@using JT_UserInterface.Shared.Services.Interfaces
@inject IDespesaService DespesaService
@inject FiltroService FiltroService
@inject NavigationManager NavigationManager

<div class="card border-left-success shadow h-80 py-2">
<DataGrid TItem="sDespesa"
          Items="ItensBase"
          IsLoading="IsLoading"
          SortSelectors="SortSelectors"
          ViewportMaxHeight="calc(100vh - 17rem)">
    <SortableHeaderTemplate Context="ctx">
        <th role="button" @onclick="() => ctx.SortBy(KeyDescricao)">
            Descrição
            @if (ctx.IsSortedBy(KeyDescricao))
            {
                <span class="ms-1">@((ctx.Direction == DataGrid<sDespesa>.SortDirection.Asc) ? "▲" : "▼")</span>
            }
        </th>
        <th role="button" @onclick="() => ctx.SortBy(KeyValor)">
            Valor
            @if (ctx.IsSortedBy(KeyValor))
            {
                <span class="ms-1">@((ctx.Direction == DataGrid<sDespesa>.SortDirection.Asc) ? "▲" : "▼")</span>
            }
        </th>
        <th role="button" @onclick="() => ctx.SortBy(KeyData)">
            Data
            @if (ctx.IsSortedBy(KeyData))
            {
                <span class="ms-1">@((ctx.Direction == DataGrid<sDespesa>.SortDirection.Asc) ? "▲" : "▼")</span>
            }
        </th>
        <th role="button" @onclick="() => ctx.SortBy(KeyVencimento)">
            Data Vencimento
            @if (ctx.IsSortedBy(KeyVencimento))
            {
                <span class="ms-1">@((ctx.Direction == DataGrid<sDespesa>.SortDirection.Asc) ? "▲" : "▼")</span>
            }
        </th>
        <th role="button" @onclick="() => ctx.SortBy(KeyCategoria)">
            Categoria
            @if (ctx.IsSortedBy(KeyCategoria))
            {
                <span class="ms-1">@((ctx.Direction == DataGrid<sDespesa>.SortDirection.Asc) ? "▲" : "▼")</span>
            }
        </th>
        <th role="button" @onclick="() => ctx.SortBy(KeyTipo)">
            Tipo
            @if (ctx.IsSortedBy(KeyTipo))
            {
                <span class="ms-1">@((ctx.Direction == DataGrid<sDespesa>.SortDirection.Asc) ? "▲" : "▼")</span>
            }
        </th>
        <th role="button" @onclick="() => ctx.SortBy(KeyCartaoParcela)">
            Cartão / Parcela
            @if (ctx.IsSortedBy(KeyCartaoParcela))
            {
                <span class="ms-1">@((ctx.Direction == DataGrid<sDespesa>.SortDirection.Asc) ? "▲" : "▼")</span>
            }
        </th>
        <th role="button" @onclick="() => ctx.SortBy(KeyPaga)">
            Paga
            @if (ctx.IsSortedBy(KeyPaga))
            {
                <span class="ms-1">@((ctx.Direction == DataGrid<sDespesa>.SortDirection.Asc) ? "▲" : "▼")</span>
            }
        </th>
       @*  @if(!HideActions){ *@
            <th>Ações</th>
    </SortableHeaderTemplate>

    <RowTemplate Context="despesa">
        <td>@despesa.Descricao</td>
        <td>@despesa.Valor.ToString("C")</td>
        <td>@despesa.DataDespesa.ToShortDateString()</td>
        <td>
            @if (despesa.EhDespesaCartaoCredito && despesa.DespCartaoCredito.DataVencimento != default)
            {
                @despesa.DespCartaoCredito.DataVencimento.ToShortDateString()
            }
            else
            {
                <span class="text-muted">—</span>
            }
        </td>
        <td>@despesa.CategoriaStruct.Nome</td>
        <td>@despesa.TipoStruct.Nome</td>
        <td>
            @if (despesa.EhDespesaCartaoCredito && despesa.DespCartaoCredito.DataVencimento != default)
            {
                <span class="d-block">@despesa.Cartao.Nome</span>
                <small class="text-muted">@despesa.DespCartaoCredito.NumeroParcela</small>
            }
            else
            {
                <span class="text-muted">—</span>
            }
        </td>
        <td>
            @if (despesa.DespesaPaga)
            {
                <span class="badge bg-success">Sim</span>
            }
            else
            {
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-danger">Não</span>
                </div>
            }
        </td>
            <td>
                @if (!despesa.EhDespesaCartaoCredito)
                {
                    @if (!despesa.DespesaPaga)
                    {
                        <button class="btn btn-sm btn-success me-2" title="Marcar como paga" @onclick="() => PagarDespesaAsync(despesa)" @onclick:stopPropagation="true">
                            <i class="bi bi-check2-circle"></i>
                        </button>
                    }
                    <button class="btn btn-sm btn-outline-success me-2" title="Duplicar Despesa" @onclick="() => OnDuplicar.InvokeAsync(despesa)" @onclick:stopPropagation="true">
                        <i class="bi bi-copy"></i>
                    </button>
                }
                else
                {
                    <button class="btn btn-sm btn-outline-primary me-2" title="Ver fatura desta despesa" @onclick="() => AbrirFaturaDoCartao(despesa)" @onclick:stopPropagation="true">
                        <i class="bi bi-receipt"></i>
                    </button>
                }
        @if (!HideActions)
        {
                <button class="btn btn-sm btn-outline-primary me-2" @onclick="() => OnEditar.InvokeAsync(despesa.Id)" @onclick:stopPropagation="true">
                    <i class="bi bi-pencil-fill"></i>
                </button>
                <button class="btn btn-sm btn-outline-danger" @onclick="() => OnRemover.InvokeAsync(despesa.Id)" @onclick:stopPropagation="true">
                    <i class="bi bi-trash-fill"></i>
                </button>
        }
            </td>
    </RowTemplate>

    <EmptyTemplate>
        <p class="text-muted mb-0">Nenhuma despesa encontrada. Tente ajustar os filtros ou cadastre uma nova despesa.</p>
    </EmptyTemplate>
</DataGrid>

<!-- Totais -->
<div class="card-footer totals-footer d-flex flex-wrap gap-3 justify-content-between align-items-center">
    <div class="d-flex flex-wrap gap-3">
        <span><strong>Itens:</strong> @QtdDespesas</span>
        <span><strong>Total:</strong> @TotalDespesas.ToString("C")</span>
        <span class="text-success"><strong>Pagas:</strong> @TotalPagas.ToString("C")</span>
        <span class="text-danger"><strong>Pendentes:</strong> @TotalPendentes.ToString("C")</span>
    </div>
</div>
</div>
@code {
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public EventCallback<sDespesa> OnDuplicar { get; set; }
    [Parameter] public EventCallback<int> OnEditar { get; set; }
    [Parameter] public EventCallback<int> OnRemover { get; set; }
    [Parameter] public bool HideActions { get; set; } = false;
    [Parameter] public List<sDespesa>? Despesas { get; set; }

    private List<sDespesa> listaTodasDespesas = new();
    private List<Categoria> TiposDespesa = new();
    private List<Categoria> CategoriasDespesa = new();

    private const string KeyDescricao = nameof(sDespesa.Descricao);
    private const string KeyValor = nameof(sDespesa.Valor);
    private const string KeyData = nameof(sDespesa.DataDespesa);
    private const string KeyVencimento = "Vencimento";
    private const string KeyCategoria = "Categoria";
    private const string KeyTipo = "Tipo";
    private const string KeyCartaoParcela = "CartaoParcela";
    private const string KeyPaga = "Paga";

    private IEnumerable<sDespesa> ItensBase =>
        (Despesas ?? listaTodasDespesas) ?? Enumerable.Empty<sDespesa>();

    // Totais
    private int QtdDespesas => ItensBase.Count();
    private decimal TotalDespesas => ItensBase.Sum(d => d.Valor);
    private decimal TotalPagas => ItensBase.Where(d => d.DespesaPaga).Sum(d => d.Valor);
    private decimal TotalPendentes => TotalDespesas - TotalPagas;

    private static readonly IReadOnlyDictionary<string, Func<sDespesa, IComparable?>> SortSelectors
        = new Dictionary<string, Func<sDespesa, IComparable?>>
    {
        [KeyDescricao] = d => d.Descricao,
        [KeyValor] = d => d.Valor,
        [KeyData] = d => d.DataDespesa,
        [KeyCategoria] = d => d.CategoriaStruct.Nome,
        [KeyTipo] = d => d.TipoStruct.Nome,
        [KeyPaga] = d => d.DespesaPaga,
        [KeyVencimento] = d => (d.EhDespesaCartaoCredito && d.DespCartaoCredito.DataVencimento != default)
            ? d.DespCartaoCredito.DataVencimento
            : DateTime.MaxValue,
        [KeyCartaoParcela] = d => d.EhDespesaCartaoCredito && !string.IsNullOrEmpty(d.Cartao.Nome)
            ? $"{d.Cartao.Nome}|{d.DespCartaoCredito.NumeroParcela:000000}"
            : "~"
    };

    protected override async Task OnInitializedAsync()
    {
        DespesaService.OnDataChanged += AtualizarDadosDaPagina;
        await CarregarDependencias();
        ConfigurarFiltros();
    }

    private async void AtualizarDadosDaPagina()
    {
        await InvokeAsync(async () =>
        {
            await CarregarDependencias();
            StateHasChanged();
        });
    }

    private async Task CarregarDependencias()
    {
        IsLoading = true;
        await Task.WhenAll(
            CarregarDespesas(),
            CarregarOpcoes()
        );
        IsLoading = false;
    }

    private async Task CarregarDespesas(string whereClause = "")
    {
        if (whereClause != "")
            Despesas = await DespesaService.ObterDespesasAsync(whereClause);
        else
            listaTodasDespesas = await DespesaService.ObterTodasDespesasAsync();
    }

    private async Task CarregarOpcoes()
    {
        //     TiposDespesa = await CategoriaService.GetTipoCategoriasDespesa();
        //     CategoriasDespesa = await CategoriaService.GetCategoriasDespesa();

    }

    private void ConfigurarFiltros()
    {
        var filtros = Despesa.GetFiltros();
        FiltroService.RegistrarFiltros(filtros, AplicarFiltros, AplicarPesquisa);
    }

    private Task AplicarPesquisa(string searchTerm)
    {
        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            Despesas = new List<sDespesa>(listaTodasDespesas);
        }
        else
        {
            Despesas = listaTodasDespesas
               .Where(d => Filtro.LevenshteinDistance(d.Descricao.ToLower(), searchTerm.ToLower()) <= 2
                    || d.Descricao.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
               .ToList();
        }
        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task AplicarFiltros(List<Filtro> filtros)
    {
        Despesas = JT_Servicos.DespesaService.Filter(filtros);
        StateHasChanged();
    }

    // --- Ações adicionadas ---
    private async Task PagarDespesaAsync(sDespesa despesa)
    {
        var entidade = despesa.ToEntity();
        entidade.DespesaPaga = true;
        entidade.DataPagamento = DateTime.Today;
        entidade.EhDespesaCartaoCredito = false;

        await DespesaService.SalvarDespesaAsync(entidade);
    }

    private void AbrirFaturaDoCartao(sDespesa despesa)
    {
        if (despesa.EhDespesaCartaoCredito && despesa.DespCartaoCredito.IdCartao > 0)
        {
            var dv = despesa.DespCartaoCredito.DataVencimento;
            NavigationManager.NavigateTo($"/fatura/{despesa.DespCartaoCredito.IdCartao}/{dv.Year}-{dv.Month}");
        }
    }
}