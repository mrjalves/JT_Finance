@using JT_Classes.Financeiro
@using JT_Classes.structs
@using JT_Finance.Shared.Services.Interfaces
@inject ICartaoCreditoService CartaoService
@inject NavigationManager NavigationManager

<div class="card border-left-success shadow h-80 py-2">
    <DataGrid TItem="sCartao"
              Items="Cartoes"
              IsLoading="IsLoading"
              SortSelectors="SortSelectors"
              ViewportMaxHeight="calc(100vh - 17rem)">
        <SortableHeaderTemplate Context="ctx">
            <th role="button" @onclick="() => ctx.SortBy(KeyNome)">
                Nome
                @if (ctx.IsSortedBy(KeyNome))
                {
                    <span class="ms-1">@((ctx.Direction == DataGrid<sCartao>.SortDirection.Asc) ? "▲" : "▼")</span>
                }
            </th>
            <th role="button" @onclick="() => ctx.SortBy(KeyLimite)">
                Limite
                @if (ctx.IsSortedBy(KeyLimite))
                {
                    <span class="ms-1">@((ctx.Direction == DataGrid<sCartao>.SortDirection.Asc) ? "▲" : "▼")</span>
                }
            </th>
            <th role="button" @onclick="() => ctx.SortBy(KeyVencimento)">
                Vencimento
                @if (ctx.IsSortedBy(KeyVencimento))
                {
                    <span class="ms-1">@((ctx.Direction == DataGrid<sCartao>.SortDirection.Asc) ? "▲" : "▼")</span>
                }
            </th>
            <th role="button" @onclick="() => ctx.SortBy(KeyFechamento)">
                Fechamento
                @if (ctx.IsSortedBy(KeyFechamento))
                {
                    <span class="ms-1">@((ctx.Direction == DataGrid<sCartao>.SortDirection.Asc) ? "▲" : "▼")</span>
                }
            </th>
            <th role="button" @onclick="() => ctx.SortBy(KeyStatus)">
                Status
                @if (ctx.IsSortedBy(KeyStatus))
                {
                    <span class="ms-1">@((ctx.Direction == DataGrid<sCartao>.SortDirection.Asc) ? "▲" : "▼")</span>
                }
            </th>
            <th role="button" @onclick="() => ctx.SortBy(KeyFaturaMes)">
                Fatura (mês)
                @if (ctx.IsSortedBy(KeyFaturaMes))
                {
                    <span class="ms-1">@((ctx.Direction == DataGrid<sCartao>.SortDirection.Asc) ? "▲" : "▼")</span>
                }
            </th>
            <th>Totais</th>
            <th class="text-end">Ações</th>
        </SortableHeaderTemplate>

        <RowTemplate Context="cartao">
            <td @ondblclick="() => VerFatura(cartao.Id)" style="cursor: pointer;" title="Dê um duplo clique para ver as despesas">@cartao.Nome</td>
            <td @ondblclick="() => VerFatura(cartao.Id)" style="cursor: pointer;" title="Dê um duplo clique para ver as despesas">@cartao.Limite.ToString("C")</td>
            <td @ondblclick="() => VerFatura(cartao.Id)" style="cursor: pointer;" title="Dê um duplo clique para ver as despesas">Dia @cartao.DiaVencimento</td>
            <td @ondblclick="() => VerFatura(cartao.Id)" style="cursor: pointer;" title="Dê um duplo clique para ver as despesas">Dia @cartao.DiaFechamento</td>
            <td @ondblclick="() => VerFatura(cartao.Id)" style="cursor: pointer;" title="Dê um duplo clique para ver as despesas">
                @if (cartao.Ativo)
                {
                    <span class="badge bg-success">Ativo</span>
                }
                else
                {
                    <span class="badge bg-secondary">Inativo</span>
                }
            </td>
            <td>
                <div class="d-flex flex-column">
                    <span title="Valor da fatura do mês atual">@GetTotalFaturaMes(cartao.Id).ToString("C")</span>
                    <small class="text-muted">mês atual</small>
                </div>
            </td>
            <td>
                <div class="d-flex flex-column">
                    <span title="Total em aberto nas faturas">@GetTotalEmAberto(cartao.Id).ToString("C")</span>
                    <small class="text-muted">em aberto</small>
                </div>
            </td>
            <td class="text-end">
                <button class="btn btn-sm btn-outline-primary me-2"
                        title="Abrir faturas"
                        @onclick="() => VerFatura(cartao.Id)"
                        @onclick:stopPropagation="true">
                    <i class="bi bi-receipt me-1"></i>
                </button>

                <button class="btn btn-sm btn-outline-primary me-2"
                        title="Editar cartão"
                        @onclick="() => OnEditar.InvokeAsync(cartao.Id)"
                        @onclick:stopPropagation="true">
                    <i class="bi bi-pencil-fill me-1"></i>
                </button>
                <button class="btn btn-sm btn-outline-danger"
                        title="Remover cartão"
                        @onclick="() => OnRemover.InvokeAsync(cartao.Id)"
                        @onclick:stopPropagation="true">
                    <i class="bi bi-trash-fill me-1"></i>
                </button>
            </td>
        </RowTemplate>
        <EmptyTemplate>
            <p class="text-muted mb-0">Nenhum cartão cadastrado ainda. Clique em "Novo Cartão" para começar.</p>
        </EmptyTemplate>
    </DataGrid>

    <!-- Totais -->
    <div class="card-footer totals-footer d-flex flex-wrap gap-3 justify-content-between align-items-center">
        <div class="d-flex flex-wrap gap-3">
            <span><strong>Cartões:</strong> @QtdCartoes</span>
            <span><strong>Limite Total:</strong> @LimiteTotal.ToString("C")</span>
            <span class="text-success"><strong>Ativos:</strong> @QtdAtivos</span>
            <span class="text-secondary"><strong>Inativos:</strong> @QtdInativos</span>
        </div>
        <div class="d-flex flex-wrap gap-3">
            <span class="text-primary"><strong>Total Geral do Mês:</strong> @TotalGeralFaturaMes.ToString("C")</span>
            <span class="text-danger"><strong>Total Geral em Aberto:</strong> @TotalGeralEmAberto.ToString("C")</span>
        </div>
    </div>
</div>


